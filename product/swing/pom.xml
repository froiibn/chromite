<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.seizia.chromite</groupId>
        <artifactId>chromite</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../</relativePath>
    </parent>
    <groupId>com.seizia.chromite</groupId>
    <artifactId>com.seizia.chromite.swing.product</artifactId>
    <version>26.0.6-SNAPSHOT</version>
    <packaging>eclipse-repository</packaging>
    <name>Chromite Swing</name>

    <build>
        <plugins>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-p2-director-plugin</artifactId>
                <version>${tycho-version}</version>
                <configuration>
                    <products>
                        <product>
                            <id>com.seizia.chromite.swing.product</id>
                            <archiveFileName>chromite-swing-${unqualifiedVersion}</archiveFileName>
                            <rootFolders>
                                <!-- for MacOSX, make sure you use a folder ending with .app , see bug 463670 -->
                                <macosx>Chromite.app</macosx>
                                <win32>chromite-swing</win32>
                            </rootFolders>
                        </product>
                    </products>
                </configuration>
                <executions>
                    <execution>
                        <id>materialize-products</id>
                        <goals>
                            <goal>materialize-products</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>target-platform-configuration</artifactId>
                <version>${tycho-version}</version>
                <configuration>
                    <!-- Only the supported platforms (docs/chromite/runtime.md) -->
                    <environments>
                        <environment>
                            <os>win32</os>
                            <ws>win32</ws>
                            <arch>x86_64</arch>
                        </environment>
                        <environment>
                            <os>macosx</os>
                            <ws>cocoa</ws>
                            <arch>aarch64</arch>
                        </environment>
                    </environments>
                </configuration>
            </plugin>
            <!-- Disable P2 repository generation -->
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-p2-repository-plugin</artifactId>
                <version>${tycho-version}</version>
                <configuration>
                    <createArtifactRepository>false</createArtifactRepository>
                </configuration>
            </plugin>
            <!-- macOS Info.plist (docs/chromite/platform-startup.md "macOS Info.plist"): p2 (BrandingIron) names the app after the
                 launcher ("Chromite-swing" until the launcher was renamed Chromite, app change #65; the check below still refuses
                 the old name) and keeps the values of Eclipse's template. Runs after materialize-products (same phase,
                 declared later) and before signing; fails when a value is not as expected, so a template change is not missed. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>macos-info-plist</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <property name="plist" value="${project.build.directory}/products/com.seizia.chromite.swing.product/macosx/cocoa/aarch64/Chromite.app/Contents/Info.plist"/>
                                <!-- Menu bar, Dock, Finder and system dialogs show the product name -->
                                <replaceregexp file="${plist}" encoding="UTF-8" flags="s"
                                    match="(&lt;key&gt;CFBundleName&lt;/key&gt;\s*&lt;string&gt;)[^&lt;]*(&lt;/string&gt;)" replace="\1Chromite\2"/>
                                <replaceregexp file="${plist}" encoding="UTF-8" flags="s"
                                    match="(&lt;key&gt;CFBundleDisplayName&lt;/key&gt;\s*&lt;string&gt;)[^&lt;]*(&lt;/string&gt;)" replace="\1Chromite\2"/>
                                <!-- "Eclipse 4.x for Mac OS X, Copyright IBM Corp." (Get Info) -->
                                <replaceregexp file="${plist}" encoding="UTF-8" flags="s"
                                    match="\s*&lt;key&gt;CFBundleGetInfoString&lt;/key&gt;\s*&lt;string&gt;[^&lt;]*&lt;/string&gt;" replace=""/>
                                <!-- "-keyring ~/.eclipse_keyring": only the legacy Platform authorization store reads it; Chromite's secure
                                     storage takes -eclipse.keyring (docs/chromite/credential-storage.md) -->
                                <replaceregexp file="${plist}" encoding="UTF-8" flags="s"
                                    match="\s*&lt;key&gt;Eclipse&lt;/key&gt;\s*&lt;array&gt;.*?&lt;/array&gt;" replace=""/>
                                <!-- Let the system appearance (dark mode) reach the window frames instead of forcing the light one -->
                                <replaceregexp file="${plist}" encoding="UTF-8" flags="s"
                                    match="\s*&lt;key&gt;NSRequiresAquaSystemAppearance&lt;/key&gt;\s*&lt;true/&gt;" replace=""/>
                                <fail message="macOS Info.plist is not as expected after branding: ${plist}">
                                    <condition>
                                        <or>
                                            <not>
                                                <resourcecontains resource="${plist}" substring="&lt;string&gt;Chromite&lt;/string&gt;"/>
                                            </not>
                                            <resourcecontains resource="${plist}" substring="Chromite-swing"/>
                                            <resourcecontains resource="${plist}" substring="CFBundleGetInfoString"/>
                                            <resourcecontains resource="${plist}" substring="-keyring"/>
                                            <resourcecontains resource="${plist}" substring="NSRequiresAquaSystemAppearance"/>
                                        </or>
                                    </condition>
                                </fail>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
