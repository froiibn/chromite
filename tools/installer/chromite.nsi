;
; Windows installer (NSIS) of the Swing product: Chromite-<version>-x64-setup.exe.
; Build it with tools/installer/build-installer.ps1, never by hand: the script passes the defines below
; and generates the file list. Design and decisions: docs/chromite/distribution.md.
;
; Design:
;   * Per-user install (%LOCALAPPDATA%\Programs\Chromite, HKCU, no administrator rights) so that the
;     in-app updater can run "setup.exe /S" after Chromite exits without an elevation prompt.
;   * User data is not in the install folder: the workspace is %APPDATA%\ChromiteData
;     (RuntimeUtils.getWorkingDirectory, ChromiteSwingApplication.lockWorkspace). The install folder
;     holds program files and the OSGi cache (configuration\) only, so an upgrade replaces the whole
;     program and keeps the user's data.
;   * Upgrade in place (also a downgrade, for rollback): the installed uninstaller removes its own
;     program files first ("/UPGRADE": shortcuts and the Apps entry stay), then the new files are
;     copied. A file list that changed between versions therefore leaves nothing stale behind.
;     The OSGi cache under configuration\ goes too, so Equinox never starts with old bundle state.
;   * Only the top-level entries of the product folder (files.nsh, generated by the build script)
;     are removed, never "$INSTDIR" recursively: a folder chosen by mistake keeps foreign files.
;   * Signing: the uninstaller is built first (pass 1, /DINNER: an exe that only writes the
;     uninstaller), signed, and embedded as a plain file in pass 2, so that both setup.exe and
;     uninstall.exe carry our signature (release.yml).
;   * Silent mode (/S): no question at all. A running Chromite is waited for (60 s), then the setup
;     fails with exit code 2 and changes nothing. The setup never starts Chromite in silent mode;
;     the updater does that after the setup's exit code 0.
;
; Defines (all from build-installer.ps1):
;   VERSION        product version, major.minor.dev (docs/chromite/versioning.md)
;   SOURCE_DIR     the built product folder (chromite-swing\, with jre\)
;   FILES_NSH      generated list of the product folder's top-level entries
;   OUT_FILE       the exe to write
;   ICON           product/swing/icons/chromite.ico
;   INNER          pass 1: write the uninstaller to UNINSTALLER_OUT and quit
;   UNINSTALLER    pass 2: the (signed) uninstaller to embed
;
; Change history:
; - 2026-11-07 Created (Windows installer, silent upgrade for the in-app updater).

Unicode true
ManifestDPIAware true
RequestExecutionLevel user
SetCompressor /SOLID lzma
SetCompressorDictSize 64

!macro Require NAME
  !ifndef ${NAME}
    !error "${NAME} is not defined: build with tools/installer/build-installer.ps1"
  !endif
!macroend
!insertmacro Require VERSION
!insertmacro Require SOURCE_DIR
!insertmacro Require FILES_NSH
!insertmacro Require OUT_FILE
!insertmacro Require ICON
!ifdef INNER
  !insertmacro Require UNINSTALLER_OUT
!else
  !insertmacro Require UNINSTALLER
  ; the uninstaller is embedded as a file (signed after pass 1), not written by this pass
  !pragma warning disable 6020
!endif

!define PRODUCT "Chromite"
!define PUBLISHER "Seizia"
!define EXE "chromite-swing.exe"
; The JVM library is loaded by both launchers (chromite-swing.exe, chromite-swingc.exe): while either
; runs it cannot be opened for writing.
!define RUNNING_PROBE "jre\bin\server\jvm.dll"
!define UNINST_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\Chromite"
!define SITE "https://chromite.seizia.com"

Name "${PRODUCT}"
OutFile "${OUT_FILE}"
InstallDir "$LOCALAPPDATA\Programs\${PRODUCT}"
InstallDirRegKey HKCU "${UNINST_KEY}" "InstallLocation"
BrandingText "${PRODUCT} ${VERSION}"
ShowInstDetails nevershow
ShowUninstDetails nevershow

; The version resource: the updater compares ProductVersion with the version in releases.json.
VIProductVersion "${VERSION}.0"
VIFileVersion "${VERSION}.0"
VIAddVersionKey /LANG=0 "ProductName" "${PRODUCT}"
VIAddVersionKey /LANG=0 "ProductVersion" "${VERSION}"
VIAddVersionKey /LANG=0 "FileVersion" "${VERSION}"
VIAddVersionKey /LANG=0 "FileDescription" "${PRODUCT} Setup"
VIAddVersionKey /LANG=0 "CompanyName" "${PUBLISHER}"
VIAddVersionKey /LANG=0 "LegalCopyright" "Copyright (C) 2026 Chromite contributors"

!include "MUI2.nsh"
!include "FileFunc.nsh"
!include "LogicLib.nsh"
!include "Sections.nsh"

!define MUI_ICON "${ICON}"
!define MUI_UNICON "${ICON}"
!define MUI_ABORTWARNING
!define MUI_COMPONENTSPAGE_NODESC

!ifndef INNER
  !define MUI_PAGE_CUSTOMFUNCTION_LEAVE DirectoryLeave
  !insertmacro MUI_PAGE_DIRECTORY
  !insertmacro MUI_PAGE_COMPONENTS
  !insertmacro MUI_PAGE_INSTFILES
  !define MUI_FINISHPAGE_RUN "$INSTDIR\${EXE}"
  !define MUI_FINISHPAGE_RUN_TEXT "$(LangRun)"
  !insertmacro MUI_PAGE_FINISH
!endif

!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

; The first language is the fallback when Windows uses neither.
!insertmacro MUI_LANGUAGE "English"
!insertmacro MUI_LANGUAGE "Korean"

LangString LangProgram ${LANG_ENGLISH} "${PRODUCT} (required)"
LangString LangProgram ${LANG_KOREAN} "${PRODUCT} (필수)"
LangString LangDesktop ${LANG_ENGLISH} "Desktop shortcut"
LangString LangDesktop ${LANG_KOREAN} "바탕 화면 바로 가기"
LangString LangRun ${LANG_ENGLISH} "Start ${PRODUCT}"
LangString LangRun ${LANG_KOREAN} "${PRODUCT} 시작"
LangString LangRunning ${LANG_ENGLISH} "${PRODUCT} is running. Close it, then select Retry."
LangString LangRunning ${LANG_KOREAN} "${PRODUCT}이(가) 실행 중입니다. 종료한 뒤 [다시 시도]를 누르세요."
LangString LangNotEmpty ${LANG_ENGLISH} "The folder $INSTDIR is not empty and holds no ${PRODUCT} installation. Choose an empty folder."
LangString LangNotEmpty ${LANG_KOREAN} "$INSTDIR 폴더가 비어 있지 않고 ${PRODUCT} 설치 폴더도 아닙니다. 빈 폴더를 고르세요."

; ---- shared by the installer and the uninstaller (un. prefix)

; Removes the program files listed in files.nsh (top-level entries of the product folder).
!macro RemoveProgramFiles
  !include "${FILES_NSH}"
!macroend

; Waits until no Chromite of this folder runs. Interactive: Retry / Cancel. Silent: 60 tries, one
; second apart, then exit code 2 with nothing changed.
!macro WaitNotRunning UN
Function ${UN}WaitNotRunning
  ${IfNot} ${FileExists} "$INSTDIR\${RUNNING_PROBE}"
    Return
  ${EndIf}
  StrCpy $R1 0
  ${Do}
    ClearErrors
    FileOpen $R0 "$INSTDIR\${RUNNING_PROBE}" a
    ${IfNot} ${Errors}
      FileClose $R0
      Return
    ${EndIf}
    ${If} ${Silent}
      IntOp $R1 $R1 + 1
      ${If} $R1 > 60
        SetErrorLevel 2
        Quit
      ${EndIf}
      Sleep 1000
    ${Else}
      MessageBox MB_RETRYCANCEL|MB_ICONEXCLAMATION "$(LangRunning)" IDRETRY retry
      SetErrorLevel 1
      Quit
      retry:
    ${EndIf}
  ${Loop}
FunctionEnd
!macroend

; ---- installer

!ifdef INNER

; Pass 1: this exe only writes the uninstaller (to be signed) and quits.
Function .onInit
  WriteUninstaller "${UNINSTALLER_OUT}"
  SetErrorLevel 0
  Quit
FunctionEnd

Section "-unused"
SectionEnd

!else

!insertmacro WaitNotRunning ""

; An existing folder is accepted only when it is empty or a Chromite installation (its launcher or
; uninstaller is there): the upgrade removes entries by name and must not hit another program's files.
Function CheckInstDir
  ${If} ${FileExists} "$INSTDIR\${EXE}"
  ${OrIf} ${FileExists} "$INSTDIR\uninstall.exe"
    Return
  ${EndIf}
  ${DirState} "$INSTDIR" $R0
  ${If} $R0 == 1
    MessageBox MB_OK|MB_ICONSTOP "$(LangNotEmpty)" /SD IDOK
    ${If} ${Silent}
      SetErrorLevel 2
      Quit
    ${EndIf}
    Abort
  ${EndIf}
FunctionEnd

Function DirectoryLeave
  Call CheckInstDir
FunctionEnd

Section "$(LangProgram)" SecProgram
  SectionIn RO
  SetShellVarContext current
  Call CheckInstDir
  Call WaitNotRunning

  ; upgrade or rollback: the installed version removes its own files first
  ${If} ${FileExists} "$INSTDIR\uninstall.exe"
    ExecWait '"$INSTDIR\uninstall.exe" /S /UPGRADE _?=$INSTDIR' $R0
    DetailPrint "previous version removed (exit code $R0)"
  ${EndIf}
  ; and the entries this version knows (a missing or failed old uninstaller)
  !insertmacro RemoveProgramFiles

  SetOutPath "$INSTDIR"
  File /r "${SOURCE_DIR}\*.*"
  File "/oname=uninstall.exe" "${UNINSTALLER}"

  ; "Start in" of the shortcut is $OUTPATH; the workspace does not depend on it
  CreateShortCut "$SMPROGRAMS\${PRODUCT}.lnk" "$INSTDIR\${EXE}" "" "$INSTDIR\${EXE}" 0

  WriteRegStr HKCU "${UNINST_KEY}" "DisplayName" "${PRODUCT}"
  WriteRegStr HKCU "${UNINST_KEY}" "DisplayVersion" "${VERSION}"
  WriteRegStr HKCU "${UNINST_KEY}" "Publisher" "${PUBLISHER}"
  WriteRegStr HKCU "${UNINST_KEY}" "DisplayIcon" "$INSTDIR\${EXE},0"
  WriteRegStr HKCU "${UNINST_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegStr HKCU "${UNINST_KEY}" "UninstallString" '"$INSTDIR\uninstall.exe"'
  WriteRegStr HKCU "${UNINST_KEY}" "QuietUninstallString" '"$INSTDIR\uninstall.exe" /S'
  WriteRegStr HKCU "${UNINST_KEY}" "URLInfoAbout" "${SITE}"
  WriteRegDWORD HKCU "${UNINST_KEY}" "NoModify" 1
  WriteRegDWORD HKCU "${UNINST_KEY}" "NoRepair" 1
  ${GetSize} "$INSTDIR" "/S=0K" $R0 $R1 $R2
  IntFmt $R0 "0x%08X" $R0
  WriteRegDWORD HKCU "${UNINST_KEY}" "EstimatedSize" "$R0"
SectionEnd

Section /o "$(LangDesktop)" SecDesktop
  SetShellVarContext current
  SetOutPath "$INSTDIR"
  CreateShortCut "$DESKTOP\${PRODUCT}.lnk" "$INSTDIR\${EXE}" "" "$INSTDIR\${EXE}" 0
SectionEnd

Function .onInit
  ; keep the user's earlier choice of a desktop shortcut (also in a silent update)
  SetShellVarContext current
  ${If} ${FileExists} "$DESKTOP\${PRODUCT}.lnk"
    !insertmacro SelectSection ${SecDesktop}
  ${EndIf}
FunctionEnd

!endif

; ---- uninstaller (compiled in both passes; pass 1 writes it)

!insertmacro WaitNotRunning "un."

Var Upgrade

Function un.onInit
  StrCpy $Upgrade 0
  ${GetParameters} $R0
  ClearErrors
  ${GetOptions} $R0 "/UPGRADE" $R1
  ${IfNot} ${Errors}
    StrCpy $Upgrade 1
  ${EndIf}
FunctionEnd

Section "Uninstall"
  SetShellVarContext current
  Call un.WaitNotRunning
  !insertmacro RemoveProgramFiles
  ; an upgrade keeps the shortcuts, the Apps entry and uninstall.exe (the new setup replaces it)
  ${If} $Upgrade == 1
    Return
  ${EndIf}
  Delete "$SMPROGRAMS\${PRODUCT}.lnk"
  Delete "$DESKTOP\${PRODUCT}.lnk"
  DeleteRegKey HKCU "${UNINST_KEY}"
  Delete "$INSTDIR\uninstall.exe"
  ; only when empty: the user's data is in %APPDATA%\ChromiteData and stays
  RMDir "$INSTDIR"
SectionEnd
