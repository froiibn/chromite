<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>

<plugin>

    <extension point="org.eclipse.ui.commands">
        <category id="com.seizia.chromite.git.commands.category" name="Git Category"/>
        <command categoryId="com.seizia.chromite.git.commands.category" id="com.seizia.chromite.git.commands.share" name="%command.com.seizia.chromite.git.commands.share.name"/>
        <command categoryId="com.seizia.chromite.git.commands.category" id="com.seizia.chromite.git.commands.projectFromGit" name="%command.com.seizia.chromite.git.commands.projectFromGit.name"/>
        <command categoryId="com.seizia.chromite.git.commands.category" id="com.seizia.chromite.git.commands.commit" name="%command.com.seizia.chromite.git.commands.commit.name"/>
        <command categoryId="com.seizia.chromite.git.commands.category" id="com.seizia.chromite.git.commands.update" name="%command.com.seizia.chromite.git.commands.update.name"/>
        <command categoryId="com.seizia.chromite.git.commands.category" id="com.seizia.chromite.git.commands.showHistory" name="%command.com.seizia.chromite.git.commands.showHistory.name"/>
    </extension>
    <extension point="org.eclipse.ui.commandImages">
        <image commandId="com.seizia.chromite.git.commands.share" icon="icons/share.png"/>
        <image commandId="com.seizia.chromite.git.commands.projectFromGit" icon="icons/clone.svg"/>

        <image commandId="com.seizia.chromite.git.commands.update" icon="icons/pull.svg"/>
        <image commandId="com.seizia.chromite.git.commands.commit" icon="icons/push.svg"/>
    </extension>

    <extension point="org.eclipse.core.expressions.propertyTesters">
        <propertyTester
                class="com.seizia.chromite.team.git.ui.handlers.GitPropertyTester"
                id="com.seizia.chromite.team.git.ui.handlers.GitPropertyTester"
                namespace="com.seizia.chromite.team.git"
                properties="canShare,canCommit,canUpdate"
                type="org.eclipse.core.resources.IResource">
        </propertyTester>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <handler commandId="com.seizia.chromite.git.commands.share" class="com.seizia.chromite.team.git.ui.handlers.ProjectShareHandler">
            <activeWhen>
                <not>
                    <test property="GitSelection.projectsSingleRepository" />
                </not>
            </activeWhen>
        </handler>
        <handler commandId="com.seizia.chromite.git.commands.projectFromGit" class="com.seizia.chromite.team.git.ui.handlers.ProjectCloneHandler">
            <enabledWhen>
                <test property="com.seizia.chromite.core.global.ui.canCreateProject"/>
            </enabledWhen>
        </handler>
        <handler commandId="com.seizia.chromite.git.commands.update" class="com.seizia.chromite.team.git.ui.handlers.GITUpdateHandler">
            <activeWhen>
                <test property="GitSelection.resourcesSingleRepository"/>
            </activeWhen>
        </handler>
        <handler commandId="com.seizia.chromite.git.commands.commit" class="com.seizia.chromite.team.git.ui.handlers.GITCommitHandler">
            <activeWhen>
                <test property="GitSelection.resourcesSingleRepository"/>
            </activeWhen>
        </handler>
        <handler commandId="com.seizia.chromite.git.commands.showHistory" class="com.seizia.chromite.team.git.ui.handlers.GITHistoryHandler">
        </handler>
    </extension>

    <extension point="org.eclipse.ui.bindings">
        <key commandId="com.seizia.chromite.git.commands.update" schemeId="com.seizia.chromite.defaultKeyScheme" sequence="CTRL+SHIFT+U"/>
        <key commandId="com.seizia.chromite.git.commands.commit" schemeId="com.seizia.chromite.defaultKeyScheme" sequence="CTRL+SHIFT+K"/>
    </extension>

    <extension point="org.eclipse.ui.menus">
        <menuContribution locationURI="menu:file?before=properties">
            <separator name="git" visible="true"/>
            <menu id="com.seizia.chromite.team.git.menu" label="Git" mnemonic="M">
                <visibleWhen><reference definitionId="ChromitePerspectiveActive"/></visibleWhen>
                <command commandId="com.seizia.chromite.git.commands.update" mnemonic="L"/>
                <command commandId="com.seizia.chromite.git.commands.commit" mnemonic="C"/>
                <separator name="projects" visible="true"/>
                <command commandId="com.seizia.chromite.git.commands.share" mnemonic="G"/>
                <command commandId="com.seizia.chromite.git.commands.projectFromGit" mnemonic="G"/>
                <separator name="view" visible="true"/>
                <command commandId="com.seizia.chromite.core.view.toggle" style="toggle"><parameter name="viewId" value="org.eclipse.egit.ui.RepositoriesView"/></command>
            </menu>
        </menuContribution>

        <menuContribution locationURI="menu:com.seizia.chromite.menu.git">
            <command commandId="com.seizia.chromite.git.commands.update" mnemonic="L">
                <visibleWhen><reference definitionId="ChromitePerspectiveActive"/></visibleWhen>
            </command>
            <command commandId="com.seizia.chromite.git.commands.commit" mnemonic="C">
                <visibleWhen><reference definitionId="ChromitePerspectiveActive"/></visibleWhen>
            </command>
            <separator name="share" visible="true"/>
            <command commandId="com.seizia.chromite.git.commands.share" mnemonic="G">
                <visibleWhen><reference definitionId="ChromitePerspectiveActive"/></visibleWhen>
            </command>
            <separator name="view" visible="true"/>
            <command commandId="com.seizia.chromite.core.view.toggle" style="toggle"><parameter name="viewId" value="org.eclipse.egit.ui.RepositoriesView"/></command>
        </menuContribution>

        <menuContribution allPopups="false" locationURI="toolbar:chromite-tools?after=additions">
            <separator name="git" visible="false"/>
            <command commandId="com.seizia.chromite.git.commands.showHistory" icon="icons/clone.svg" label="Git" style="pulldown" id="com.seizia.chromite.menu.git">
                <visibleWhen><reference definitionId="ChromitePerspectiveActive"/></visibleWhen>
            </command>
        </menuContribution>

        <menuContribution allPopups="false" locationURI="toolbar:com.seizia.chromite.core.projectNavigator?before=additions">
            <command commandId="com.seizia.chromite.git.commands.projectFromGit">
                <visibleWhen checkEnabled="true"/>
            </command>
        </menuContribution>
        <menuContribution allPopups="false" locationURI="menu:com.seizia.chromite.core.projectNavigator?before=additions">
            <command commandId="com.seizia.chromite.git.commands.projectFromGit">
                <visibleWhen checkEnabled="true"/>
            </command>
        </menuContribution>

    </extension>

    <extension point="com.seizia.chromite.notifications">
        <notification id="git.project.added" name="Project was added to Git"/>
    </extension>

    <extension point="com.seizia.chromite.app.config">
        <feature
            id="git"
            label="Git version control"
            description="Provides Git version control integration for projects."
            enabledByDefault="false"
            enablementTester="com.seizia.chromite.team.git.ui.app.config.GitProductConfigFeatureTester"/>
    </extension>

    <extension point="org.eclipse.ui.activities">
        <activity id="chromite.activity.git" name="Git Activity">
            <enabledWhen>
                <test property="com.seizia.chromite.app.config.isFeatureEnabled" value="git"/>
            </enabledWhen>
        </activity>

        <activityPatternBinding activityId="chromite.activity.git" pattern="com\.seizia\.chromite\.team\.git\.ui.*"/>
        <activityPatternBinding activityId="chromite.activity.git" pattern="com\.seizia\.chromite\.git.*"/>
        <activityPatternBinding activityId="chromite.activity.git" pattern="org\.eclipse\.egit.*"/>
    </extension>

</plugin>
