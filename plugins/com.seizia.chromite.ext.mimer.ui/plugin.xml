<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>
    <extension point="com.seizia.chromite.dataSourceConfigurator">
        <configurator dataSource="mimer" class="com.seizia.chromite.ext.mimer.ui.views.MimerConnectionPage"/>
    </extension>

    <extension point="com.seizia.chromite.databaseEditor">
        <editor id="source.declaration"
                class="com.seizia.chromite.ui.editors.sql.SQLSourceViewer"
                label="%editor.source_declaration.name"
                description="%editor.source_declaration.description"
                icon="#sql_text"
                position="additions_middle"
                contributor="com.seizia.chromite.ui.editors.sql.SQLEditorContributorNested"
                type="folder"
                embeddable="false">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerDomain"/>
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerSynonym"/>
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerCollation"/>
        </editor>
        <!-- MimerModule needs the editable variant, not the plain always-read-only
             SQLSourceViewer above - see MimerModuleSourceViewEditor's own Javadoc on why this
             is a small local class instead of referencing ext.generic.ui's GenericSourceViewEditor
             directly (that cross-plugin reference used to silently fail to resolve at all). -->
        <editor id="module.source.declaration"
                class="com.seizia.chromite.ext.mimer.ui.editors.MimerModuleSourceViewEditor"
                label="%editor.module_source_declaration.name"
                description="%editor.module_source_declaration.description"
                icon="#sql_text"
                position="additions_middle"
                contributor="com.seizia.chromite.ui.editors.sql.SQLEditorContributorNested"
                type="folder"
                embeddable="false">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerModule"/>
            <!-- MimerStatement/MimerUdtMethodSpec also implement DBSObjectWithScript and need an
                 editable Source tab - SQLSourceViewer<T> is purely generic (erasure-based, no
                 MimerModule-specific cast), so this same registered editor class works for them
                 too. -->
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerStatement"/>
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerUdtMethodSpec"/>
        </editor>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerSchemaConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerSchema"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerSequenceConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerSequence"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerIndexConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerTableIndex"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerDomainConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerDomain"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerCollationConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerCollation"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerLibraryConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerLibrary"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerSynonymConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerSynonym"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerProcedureConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerProcedure"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerModuleConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerModule"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerTableTriggerConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerTableTrigger"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerDatabankConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerDatabank"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerDatabankFileConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerDatabankFile"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerDatabankShadowConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerDatabankShadow"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerUserConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerUser"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerUserAuthorizationConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerUserAuthorization"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerGroupConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerGroup"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerProgramConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerProgram"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerProgramPrivilegeConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerProgramPrivilege"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerStatementConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerStatement"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerStatementPrivilegeConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerStatementPrivilege"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerGroupMemberConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerGroupMember"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerSystemPrivilegeConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerSystemPrivilege"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerSequencePrivilegeConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerSequencePrivilege"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerDatabankPrivilegeConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerDatabankPrivilege"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerDomainPrivilegeConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerDomainPrivilege"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerColumnPrivilegeConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerColumnPrivilege"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerGroupMembershipConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerIdentGroupMembership"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerObjectPrivilegeConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerObjectPrivilege"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerRoutinePrivilegeConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerRoutinePrivilege"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerUserDefinedTypeConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerUserDefinedType"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerUserDefinedTypePrivilegeConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerUserDefinedTypePrivilege"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.mimer.ui.config.MimerUdtMethodSpecConfigurator">
            <objectType name="com.seizia.chromite.ext.mimer.model.MimerUdtMethodSpec"/>
        </configurator>
    </extension>

    <extension point="com.seizia.chromite.sql.plan.view">
        <view id="mimerXML"
              priority="101"
              label="%view.mimerXML.name"
              icon="platform:/plugin/com.seizia.chromite.ui/icons/sql/page_explain_plan.svg"
              description="%view.mimerXML.description"
              class="com.seizia.chromite.ext.mimer.ui.plan.MimerSQLPlanXMLViewProvider">
            <datasource id="mimer"/>
        </view>
    </extension>

    <!-- Navigator actions for databank/shadow online state (SET DATABANK/SHADOW ... is its own
         statement family, not ALTER - see MimerUtils.buildSetOnlineDDL). -->
    <extension point="org.eclipse.ui.commands">
        <command id="com.seizia.chromite.ext.mimer.setOnlineState"
                 name="%command.setOnlineState.name"
                 description="%command.setOnlineState.description"
                 categoryId="com.seizia.chromite.core.navigator"/>
        <command id="com.seizia.chromite.ext.mimer.shadowRestoreFromLog"
                 name="%command.shadowRestoreFromLog.name"
                 description="%command.shadowRestoreFromLog.description"
                 categoryId="com.seizia.chromite.core.navigator"/>
        <command id="com.seizia.chromite.ext.mimer.shadowToMaster"
                 name="%command.shadowToMaster.name"
                 description="%command.shadowToMaster.description"
                 categoryId="com.seizia.chromite.core.navigator"/>
        <command id="com.seizia.chromite.ext.mimer.shadowAddPages"
                 name="%command.shadowAddPages.name"
                 description="%command.shadowAddPages.description"
                 categoryId="com.seizia.chromite.core.navigator"/>
        <command id="com.seizia.chromite.ext.mimer.addPrivileges"
                 name="%command.addPrivileges.name"
                 description="%command.addPrivileges.description"
                 categoryId="com.seizia.chromite.core.navigator"/>
        <command id="com.seizia.chromite.ext.mimer.openDependencyTarget"
                 name="%command.openDependencyTarget.name"
                 description="%command.openDependencyTarget.description"
                 categoryId="com.seizia.chromite.core.navigator"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <handler commandId="com.seizia.chromite.ext.mimer.setOnlineState"
                 class="com.seizia.chromite.ext.mimer.ui.actions.MimerSetOnlineStateHandler">
            <enabledWhen>
                <with variable="selection">
                    <count value="+"/>
                    <iterate operator="and">
                        <adapt type="com.seizia.chromite.model.struct.DBSObject">
                            <or>
                                <instanceof value="com.seizia.chromite.ext.mimer.model.MimerDatabank"/>
                                <instanceof value="com.seizia.chromite.ext.mimer.model.MimerDatabankShadow"/>
                            </or>
                        </adapt>
                    </iterate>
                </with>
            </enabledWhen>
        </handler>
        <handler commandId="com.seizia.chromite.ext.mimer.shadowRestoreFromLog"
                 class="com.seizia.chromite.ext.mimer.ui.actions.MimerShadowRestoreFromLogHandler">
            <enabledWhen>
                <with variable="selection">
                    <count value="+"/>
                    <iterate operator="and">
                        <adapt type="com.seizia.chromite.model.struct.DBSObject">
                            <instanceof value="com.seizia.chromite.ext.mimer.model.MimerDatabankShadow"/>
                        </adapt>
                    </iterate>
                </with>
            </enabledWhen>
        </handler>
        <handler commandId="com.seizia.chromite.ext.mimer.shadowToMaster"
                 class="com.seizia.chromite.ext.mimer.ui.actions.MimerShadowToMasterHandler">
            <enabledWhen>
                <with variable="selection">
                    <count value="1"/>
                    <iterate operator="and">
                        <adapt type="com.seizia.chromite.model.struct.DBSObject">
                            <instanceof value="com.seizia.chromite.ext.mimer.model.MimerDatabankShadow"/>
                        </adapt>
                    </iterate>
                </with>
            </enabledWhen>
        </handler>
        <handler commandId="com.seizia.chromite.ext.mimer.shadowAddPages"
                 class="com.seizia.chromite.ext.mimer.ui.actions.MimerShadowAddPagesHandler">
            <enabledWhen>
                <with variable="selection">
                    <count value="+"/>
                    <iterate operator="and">
                        <adapt type="com.seizia.chromite.model.struct.DBSObject">
                            <instanceof value="com.seizia.chromite.ext.mimer.model.MimerDatabankShadow"/>
                        </adapt>
                    </iterate>
                </with>
            </enabledWhen>
        </handler>
        <handler commandId="com.seizia.chromite.ext.mimer.addPrivileges"
                 class="com.seizia.chromite.ext.mimer.ui.actions.MimerAddPrivilegesHandler">
            <enabledWhen>
                <with variable="selection">
                    <count value="+"/>
                    <iterate operator="and">
                        <adapt type="com.seizia.chromite.model.struct.DBSObject">
                            <or>
                                <instanceof value="com.seizia.chromite.ext.mimer.model.MimerTable"/>
                                <instanceof value="com.seizia.chromite.ext.mimer.model.MimerView"/>
                            </or>
                        </adapt>
                    </iterate>
                </with>
            </enabledWhen>
        </handler>
        <handler commandId="com.seizia.chromite.ext.mimer.openDependencyTarget"
                 class="com.seizia.chromite.ext.mimer.ui.actions.MimerOpenDependencyTargetHandler">
            <enabledWhen>
                <with variable="selection">
                    <count value="1"/>
                    <iterate operator="and">
                        <adapt type="com.seizia.chromite.model.struct.DBSObject">
                            <or>
                                <instanceof value="com.seizia.chromite.ext.mimer.model.MimerObjectUsedBy"/>
                                <instanceof value="com.seizia.chromite.ext.mimer.model.MimerObjectUses"/>
                            </or>
                        </adapt>
                    </iterate>
                </with>
            </enabledWhen>
        </handler>
    </extension>

    <extension point="org.eclipse.ui.menus">
        <menuContribution allPopups="false" locationURI="popup:org.eclipse.ui.popup.any?after=object">
            <command commandId="com.seizia.chromite.ext.mimer.setOnlineState">
                <visibleWhen checkEnabled="true"/>
            </command>
            <command commandId="com.seizia.chromite.ext.mimer.shadowRestoreFromLog">
                <visibleWhen checkEnabled="true"/>
            </command>
            <command commandId="com.seizia.chromite.ext.mimer.shadowToMaster">
                <visibleWhen checkEnabled="true"/>
            </command>
            <command commandId="com.seizia.chromite.ext.mimer.shadowAddPages">
                <visibleWhen checkEnabled="true"/>
            </command>
            <command commandId="com.seizia.chromite.ext.mimer.addPrivileges">
                <visibleWhen checkEnabled="true"/>
            </command>
            <command commandId="com.seizia.chromite.ext.mimer.openDependencyTarget">
                <visibleWhen checkEnabled="true"/>
            </command>
        </menuContribution>
    </extension>

    <extension point="org.eclipse.ui.preferencePages">
        <page
                category="com.seizia.chromite.preferences.drivers"
                id="com.seizia.chromite.preferences.mimer.general"
                class="com.seizia.chromite.ext.mimer.ui.views.PrefPageMimer"
                name="%preferences.mimer.name">
            <keywordReference id="com.seizia.chromite.core.keyword.chromite"/>
        </page>
    </extension>
</plugin>
