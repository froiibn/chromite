<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

    <extension-point id="com.seizia.chromite.dataTransferConfigurator" name="Data Transfer UI Configurators" schema="schema/com.seizia.chromite.dataTransferConfigurator.exsd"/>

    <extension point="org.eclipse.ui.commands">
        <command id="com.seizia.chromite.core.export.data" name="%command.com.seizia.chromite.core.export.data.name" description="%command.com.seizia.chromite.core.export.data.description" categoryId="com.seizia.chromite.core.util"/>
        <command id="com.seizia.chromite.core.import.data" name="%command.com.seizia.chromite.core.import.data.name" description="%command.com.seizia.chromite.core.import.data.description" categoryId="com.seizia.chromite.core.util"/>
    </extension>

    <extension point="org.eclipse.ui.commandImages">
        <image commandId="com.seizia.chromite.core.export.data" icon="platform:/plugin/com.seizia.chromite.ui/icons/sql/table_export.svg"/>
        <image commandId="com.seizia.chromite.core.import.data" icon="platform:/plugin/com.seizia.chromite.ui/icons/sql/table_import.svg"/>
    </extension>

    <extension point="org.eclipse.core.expressions.propertyTesters">
        <propertyTester
                class="com.seizia.chromite.tools.transfer.ui.handlers.DataImportPropertyTester"
                id="com.seizia.chromite.tools.transfer.ui.handlers.DataImportPropertyTester"
                namespace="com.seizia.chromite.dataTransfer"
                properties="supportsImport"
                type="com.seizia.chromite.model.struct.DBSObject"/>
    </extension>

    <extension point="org.eclipse.ui.menus">

        <menuContribution allPopups="false" locationURI="popup:org.eclipse.ui.popup.any?after=export_import">
            <command
                    commandId="com.seizia.chromite.core.export.data"
                    label="%command.com.seizia.chromite.core.export.data.name">
                <visibleWhen checkEnabled="true"/>
            </command>
            <command
                    commandId="com.seizia.chromite.core.import.data"
                    label="%command.com.seizia.chromite.core.import.data.name">
                <visibleWhen checkEnabled="true"/>
            </command>
        </menuContribution>

    </extension>

    <extension point="org.eclipse.ui.handlers">
        <handler commandId="com.seizia.chromite.core.export.data" class="com.seizia.chromite.tools.transfer.ui.handlers.DataExportHandler">
            <enabledWhen>
                <with variable="selection">
                    <count value="+"/>
                    <iterate operator="and">
                        <adapt type="com.seizia.chromite.model.struct.DBSDataContainer"/>
                    </iterate>
                </with>
            </enabledWhen>
        </handler>
        <handler commandId="com.seizia.chromite.core.import.data" class="com.seizia.chromite.tools.transfer.ui.handlers.DataImportHandler">
            <enabledWhen>
                <with variable="selection">
                    <count value="+"/>
                    <iterate operator="and">
                        <and>
                            <or>
                                <adapt type="com.seizia.chromite.model.struct.DBSDataManipulator"/>
                                <adapt type="com.seizia.chromite.model.struct.DBSObject">
                                    <test property="com.seizia.chromite.model.isTableContainer"/>
                                </adapt>
                            </or>
                            <adapt type="com.seizia.chromite.model.struct.DBSObject">
                                <test property="com.seizia.chromite.dataTransfer.supportsImport" forcePluginActivation="true"/>
                            </adapt>
                        </and>
                    </iterate>
                </with>
            </enabledWhen>
        </handler>
    </extension>

    <extension point="com.seizia.chromite.dataTransferConfigurator">

        <configPages node="database_producer">
            <page id="database_producer_input_objects" class="com.seizia.chromite.tools.transfer.ui.pages.database.DatabaseProducerPageInputObjects" producerSelector="true"/>
            <page id="database_producer_extract_settings" class="com.seizia.chromite.tools.transfer.ui.pages.database.DatabaseProducerPageExtractSettings" type="settings"/>
        </configPages>

        <configPages node="database_consumer">
            <page id="database_consumer_mappings" class="com.seizia.chromite.tools.transfer.ui.pages.database.DatabaseConsumerPageMapping"/>
            <page id="database_consumer_settings" class="com.seizia.chromite.tools.transfer.ui.pages.database.DatabaseConsumerPageLoadSettings" type="settings"/>
        </configPages>

        <configPages node="stream_producer">
            <page id="stream_producer_settings" class="com.seizia.chromite.tools.transfer.ui.pages.stream.StreamProducerPageSettings"/>
        </configPages>

        <configPages node="stream_consumer">
            <page id="stream_consumer_settings" class="com.seizia.chromite.tools.transfer.ui.pages.stream.StreamConsumerPageSettings" type="settings"/>
            <page id="stream_consumer_output" class="com.seizia.chromite.tools.transfer.ui.pages.stream.StreamConsumerPageOutput" type="preview"/>
        </configPages>

    </extension>

    <extension point="com.seizia.chromite.task.ui">
        <configurator type="dataExport" class="com.seizia.chromite.tools.transfer.ui.wizard.DataTransferTaskConfigurator"/>
        <configurator type="dataImport" class="com.seizia.chromite.tools.transfer.ui.wizard.DataTransferTaskConfigurator"/>
        <configurator type="scriptExecute" class="com.seizia.chromite.tasks.ui.sql.script.SQLScriptTaskConfigurator" supportsPanel="false"/>
    </extension>

    <extension point="com.seizia.chromite.ui.propertyConfigurator">
        <propertyConfigurator
                class="com.seizia.chromite.tools.transfer.processor.ShowInExplorerEventProcessor"
                uiClass="com.seizia.chromite.tools.transfer.ui.processor.config.ShowInExplorerEventProcessorConfigurator"/>
        <propertyConfigurator
                class="com.seizia.chromite.tools.transfer.processor.ExecuteCommandEventProcessor"
                uiClass="com.seizia.chromite.tools.transfer.ui.processor.config.ExecuteCommandEventProcessorConfigurator"/>
        <propertyConfigurator
                class="com.seizia.chromite.tools.transfer.processor.FailedExportFileCleanerProcessor"
                uiClass="com.seizia.chromite.tools.transfer.ui.processor.config.FailedExportFileCleanerProcessorConfigurator"/>
    </extension>

    <extension point="com.seizia.chromite.sqlCommand">
        <pragma id="export" class="com.seizia.chromite.tools.transfer.ui.SQLPragmaExport"/>
    </extension>

    <extension point="org.eclipse.ui.preferencePages">
        <page category="com.seizia.chromite.preferences.main.connections" class="com.seizia.chromite.tools.transfer.ui.prefs.PrefPageDataTransfer" id="com.seizia.chromite.preferences.datatransfer" name="%pref.page.name.datatransfer">
            <keywordReference id="com.seizia.chromite.core.keyword.chromite"/>
            <keywordReference id="com.seizia.chromite.core.keyword.datatransfer"/>
        </page>
    </extension>

    <extension point="org.eclipse.ui.propertyPages">
        <page category="com.seizia.chromite.preferences.main.connections" class="com.seizia.chromite.tools.transfer.ui.prefs.PrefPageDataTransfer"
              id="com.seizia.chromite.preferences.datatransfer" name="%pref.page.name.datatransfer">
            <enabledWhen>
                <reference definitionId="com.seizia.chromite.core.preferences.datasource"/>
            </enabledWhen>
        </page>
    </extension>

    <extension point="com.seizia.chromite.connectionPageConfigurator">
            <page
                    id="com.seizia.chromite.preferences.datatransfer"
                    after="com.seizia.chromite.preferences.main.meta"
                    class="com.seizia.chromite.tools.transfer.ui.prefs.PrefPageDataTransfer"
                    title="%pref.page.name.datatransfer"
                    description="%pref.page.name.datatransfer"/>
    </extension>

    <extension point="org.eclipse.ui.keywords">
        <keyword id="com.seizia.chromite.core.keyword.datatransfer" label="%keyword.com.seizia.chromite.preferences.datatransfer"/>
    </extension>

</plugin>
