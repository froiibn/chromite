<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>

<plugin>
    <extension point="com.seizia.chromite.postgresql.serverType">
        <serverType id="greenplum"
                    name="Greenplum"
                    class="com.seizia.chromite.ext.greenplum.model.PostgreServerGreenplum"
                    logo="icons/greenplum_logo.png"
                    customURL="true" turnOffPreparedStatements="true"/>
    </extension>

    <extension point="com.seizia.chromite.postgresql.serverType">
        <serverType id="cloudberry"
                    name="Cloudberry"
                    class="com.seizia.chromite.ext.greenplum.model.PostgreServerCloudberry"
                    logo="icons/cloudberry_logo.png"
                    customURL="true" turnOffPreparedStatements="true"/>
    </extension>

    <extension point="com.seizia.chromite.postgresql.serverType">
        <serverType id="greengage"
                    name="Greengage"
                    class="com.seizia.chromite.ext.greenplum.model.PostgreServerGreengage"
                    logo="icons/greengage_logo.svg"
                    customURL="true"
                    turnOffPreparedStatements="true"/>
    </extension>

    <extension point="com.seizia.chromite.dataSourceProvider">
        <dataSourceType
            id="greengage"
            label="Greengage"
            description="Greengage database"
            dataSourceInformation="High-performance analytical database platform"
            icon="icons/greengage_icon.svg"
            iconBig="icons/greengage_icon_big.svg"
            logoImage="icons/greengage_logo.svg"/>
        <dataSourceType
            id="cloudberry"
            label="Cloudberry"
            description="Cloudberry database"
            dataSourceInformation="High-performance analytical database platform"
            icon="icons/cloudberry_icon.png"
            iconBig="icons/cloudberry_icon_big.png"
            logoImage="icons/cloudberry_logo.png"/>
        <dataSourceType
            id="greenplum"
            label="Greenplum"
            description="Greenplum database"
            dataSourceInformation="High-performance analytical database platform"
            icon="icons/greenplum_icon.png"
            iconBig="icons/greenplum_icon_big.png"
            logoImage="icons/greenplum_logo.png"/>
        <datasource
                class="com.seizia.chromite.ext.greenplum.GreenplumDataSourceProvider"
                description="%datasource.greenplum.description"
                id="greenplum"
                dataSourceType="greenplum"
                parent="postgresql"
                label="Greenplum"
                icon="icons/greenplum_icon.png"
                dialect="greenplum"
                inheritClients="true"
                inheritProviderProperties="true">

            <treeInjection path="postgresql/database/schema/table"
                           changeFolderType="com.seizia.chromite.ext.greenplum.model.GreenplumTable"/>
            <treeInjection path="postgresql/database/schema" after="table">
                <folder type="com.seizia.chromite.ext.greenplum.model.GreenplumExternalTable"
                        label="%tree.externaltables.node.name"
                        icon="#folder_table" visibleIf="object.dataSource.supportsExternalTables()">
                    <items label="%tree.externaltable.node.name" path="externalTable" property="externalTables"
                           icon="#table_external">
                        <folder type="com.seizia.chromite.ext.postgresql.model.PostgreTableColumn"
                                label="%tree.columns.node.name" icon="#columns" description="Table columns">
                            <items label="%tree.column.node.name" path="attribute" property="attributes" icon="#column">
                            </items>
                        </folder>
                    </items>
                </folder>
            </treeInjection>

            <drivers managable="true">
                <driver
                        id="greenplum-jdbc"
                        label="Greenplum"
                        class="org.postgresql.Driver"
                        sampleURL="jdbc:postgresql://{host}[:{port}]/[{database}]"
                        defaultPort="5432"
                        webURL="https://greenplum.org/"
                        propertiesURL="https://jdbc.postgresql.org/documentation/head/connect.html#connection-parameters"
                        databaseDocumentationSuffixURL="Database-driver-Greenplum"
                        description="%driver.greenplum.description"
                        categories="sql,analytic">
                    <replace provider="postgresql" driver="postgres-greenplum-jdbc"/>

                    <file type="jar" path="maven:/org.postgresql:postgresql:RELEASE[42.7.14]"
                          bundle="!drivers.postgresql"/>
                    <file type="jar" path="maven:/net.postgis:postgis-jdbc:RELEASE[2.5.0]" ignore-dependencies="true"
                          optional="true" bundle="!drivers.postgresql"/>
                    <file type="jar" path="maven:/net.postgis:postgis-jdbc-jtsparser:RELEASE[2.5.0]"
                          ignore-dependencies="true" optional="true" bundle="!drivers.postgresql"/>
                    <file type="jar" path="maven:/net.postgis:postgis-geometry:RELEASE[2.5.0]"
                          ignore-dependencies="true" optional="true" bundle="!drivers.postgresql"/>
                    <file type="license" path="licenses/external/pg.txt"/>
                    <file type="jar" path="drivers/postgresql" bundle="drivers.postgresql"/>
                    <file type="jar" path="drivers/postgis" bundle="drivers.postgresql"/>
<!--                    <file type="jar" path="drivers/waffle" bundle="drivers.postgresql"/>-->
                    <parameter name="serverType" value="greenplum"/>
                    <property name="loginTimeout" value="20"/>
                    <property name="connectTimeout" value="20"/>
                    <property name="prepareThreshold" value="0"/>
                </driver>
            </drivers>
        </datasource>
        <datasource
                class="com.seizia.chromite.ext.greenplum.CloudberryDataSourceProvider"
                description="%datasource.cloudberry.description"
                id="cloudberry"
                dataSourceType="cloudberry"
                parent="greenplum"
                label="Cloudberry"
                icon="icons/cloudberry_icon.png"
                dialect="greenplum"
                inheritClients="true"
                inheritProviderProperties="true">

            <drivers managable="true">
                <driver
                        id="cloudberry-jdbc"
                        label="Cloudberry"
                        class="org.postgresql.Driver"
                        sampleURL="jdbc:postgresql://{host}[:{port}]/[{database}]"
                        defaultPort="5432"
                        webURL="https://cloudberry.apache.org/"
                        propertiesURL="https://jdbc.postgresql.org/documentation/head/connect.html#connection-parameters"
                        databaseDocumentationSuffixURL=""
                        description="%driver.cloudberry.description"
                        categories="sql,analytic">
                    <replace provider="postgresql" driver="postgres-cloudberry-jdbc"/>

                    <file type="jar" path="maven:/org.postgresql:postgresql:RELEASE[42.7.14]"
                          bundle="!drivers.postgresql"/>
                    <file type="jar" path="maven:/net.postgis:postgis-jdbc:RELEASE[2.5.0]" ignore-dependencies="true"
                          optional="true" bundle="!drivers.postgresql"/>
                    <file type="jar" path="maven:/net.postgis:postgis-jdbc-jtsparser:RELEASE[2.5.0]"
                          ignore-dependencies="true" optional="true" bundle="!drivers.postgresql"/>
                    <file type="jar" path="maven:/net.postgis:postgis-geometry:RELEASE[2.5.0]"
                          ignore-dependencies="true" optional="true" bundle="!drivers.postgresql"/>
                    <file type="license" path="licenses/external/pg.txt"/>
                    <file type="jar" path="drivers/postgresql" bundle="drivers.postgresql"/>
                    <file type="jar" path="drivers/postgis" bundle="drivers.postgresql"/>
                    <parameter name="serverType" value="cloudberry"/>
                    <property name="loginTimeout" value="20"/>
                    <property name="connectTimeout" value="20"/>
                    <property name="prepareThreshold" value="0"/>
                </driver>
            </drivers>
        </datasource>
        <datasource
                class="com.seizia.chromite.ext.greenplum.GreengageDataSourceProvider"
                description="%datasource.greengage.description"
                id="greengage"
                dataSourceType="greengage"
                parent="greenplum"
                label="Greengage"
                icon="icons/greengage_icon.svg"
                dialect="greenplum"
                inheritClients="true"
                inheritProviderProperties="true">

            <drivers managable="true">
                <driver
                        id="greengage-jdbc"
                        label="Greengage"
                        class="org.postgresql.Driver"
                        sampleURL="jdbc:postgresql://{host}[:{port}]/[{database}]"
                        defaultPort="5432"
                        webURL="https://greengagedb.org/"
                        propertiesURL="https://jdbc.postgresql.org/documentation/head/connect.html#connection-parameters"
                        databaseDocumentationSuffixURL="Database-driver-Greengage"
                        description="%driver.greengage.description"
                        categories="sql,analytic">
                    <replace provider="postgresql" driver="postgres-greengage-jdbc"/>

                    <file type="jar" path="maven:/org.postgresql:postgresql:RELEASE[42.7.14]"
                          bundle="!drivers.postgresql"/>
                    <file type="jar" path="maven:/net.postgis:postgis-jdbc:RELEASE[2.5.0]" ignore-dependencies="true"
                          optional="true" bundle="!drivers.postgresql"/>
                    <file type="jar" path="maven:/net.postgis:postgis-jdbc-jtsparser:RELEASE[2.5.0]"
                          ignore-dependencies="true" optional="true" bundle="!drivers.postgresql"/>
                    <file type="jar" path="maven:/net.postgis:postgis-geometry:RELEASE[2.5.0]"
                          ignore-dependencies="true" optional="true" bundle="!drivers.postgresql"/>
                    <file type="license" path="licenses/external/pg.txt"/>
                    <file type="jar" path="drivers/postgresql" bundle="drivers.postgresql"/>
                    <file type="jar" path="drivers/postgis" bundle="drivers.postgresql"/>
                    <parameter name="serverType" value="greengage"/>
                    <property name="loginTimeout" value="20"/>
                    <property name="connectTimeout" value="20"/>
                    <property name="prepareThreshold" value="0"/>
                </driver>
            </drivers>
        </datasource>
    </extension>

    <!-- Chromite: over half of each of these marks is under 1.5:1 contrast on the dark theme's backgrounds, so the Swing UI draws them,
         unchanged, on a light plate in dark themes (docs/chromite/design-spec.md "벤더 아이콘의 밝은 판"). XML only: no dependency
         on the Swing bundle. -->
    <extension point="com.seizia.chromite.ui.swing.iconPlate">
        <lightPlate icon="icons/greengage_icon.svg"/>
        <lightPlate icon="icons/greengage_icon_big.svg"/>
    </extension>

    <extension point="com.seizia.chromite.objectManager">
        <manager class="com.seizia.chromite.ext.greenplum.edit.GreenplumSchemaManager"
                 objectType="com.seizia.chromite.ext.greenplum.model.GreenplumSchema"/>
        <manager class="com.seizia.chromite.ext.greenplum.edit.GreenplumTableManager"
                 objectType="com.seizia.chromite.ext.greenplum.model.GreenplumTable"/>
        <manager class="com.seizia.chromite.ext.greenplum.edit.GreenplumExternalTableManager"
                 containerType="com.seizia.chromite.ext.greenplum.model.GreenplumSchema"
                 objectType="com.seizia.chromite.ext.greenplum.model.GreenplumExternalTable"/>
        <manager class="com.seizia.chromite.ext.greenplum.edit.GreenplumFunctionManager"
                 objectType="com.seizia.chromite.ext.greenplum.model.GreenplumFunction"/>
    </extension>

    <extension point="com.seizia.chromite.sqlDialect">
        <dialect id="greenplum" parent="postgresql" class="com.seizia.chromite.ext.postgresql.model.PostgreDialect" label="Greenplum" description="Greenplum dialect." icon="icons/greenplum_icon.png">
            <keywords value=""/>
            <execKeywords value=""/>
            <ddlKeywords value=""/>
            <dmlKeywords value=""/>
            <functions value=""/>
            <types value=""/>

            <property name="" value=""/>
        </dialect>
    </extension>

</plugin>
