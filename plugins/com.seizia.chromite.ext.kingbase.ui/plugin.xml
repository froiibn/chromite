<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>

<plugin>
    <extension point="com.seizia.chromite.dataSourceConfigurator">
    <configurator dataSource="kingbase" class="com.seizia.chromite.ext.kingbase.ui.views.KingbaseConnectionPage"/>
  </extension>
  <extension point="com.seizia.chromite.databaseEditor">
    
    <configurator class="com.seizia.chromite.ext.kingbase.ui.config.KingbaseDatabaseConfigurator">
      <objectType name="com.seizia.chromite.ext.kingbase.model.KingbaseDatabase"/>
    </configurator>
   
    <configurator class="com.seizia.chromite.ext.kingbase.ui.config.KingbaseProcedureConfigurator">
      <objectType name="com.seizia.chromite.ext.kingbase.model.KingbaseProcedure"/>
    </configurator>
    <configurator class="com.seizia.chromite.ext.kingbase.ui.config.KingbaseFunctionConfigurator">
      <objectType name="com.seizia.chromite.ext.kingbase.model.KingbaseFunction"/>
    </configurator>
  </extension>
</plugin>
