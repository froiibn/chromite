    <extension point="org.eclipse.ui.bindings">
        <key commandId="com.seizia.chromite.erd.focus.diagram" contextId="org.eclipse.ui.contexts.window" schemeId="com.seizia.chromite.keyboardOnlyKeyScheme" sequence="ALT+1"/>
        <key commandId="com.seizia.chromite.erd.focus.palette" contextId="org.eclipse.ui.contexts.window" schemeId="com.seizia.chromite.keyboardOnlyKeyScheme" sequence="ALT+2"/>
        <key commandId="com.seizia.chromite.erd.focus.outline" contextId="org.eclipse.ui.contexts.window" schemeId="com.seizia.chromite.keyboardOnlyKeyScheme" sequence="ALT+3"/>
        <key commandId="com.seizia.chromite.erd.focus.parameter" contextId="org.eclipse.ui.contexts.window" schemeId="com.seizia.chromite.keyboardOnlyKeyScheme" sequence="ALT+4"/>
        <key commandId="com.seizia.chromite.erd.toggleHand" contextId="org.eclipse.ui.contexts.window" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration" sequence="TAB"/>
        <key commandId="com.seizia.chromite.erd.diagram.view" contextId="org.eclipse.ui.contexts.window" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration" sequence="CTRL+SHIFT+ENTER"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <handler commandId="com.seizia.chromite.erd.diagram.view" class="com.seizia.chromite.ui.editors.erd.navigator.ViewDiagramHandler">
            <enabledWhen>
                <with variable="selection">
                    <count value="1"/>
                    <iterate operator="and">
                        <adapt type="com.seizia.chromite.model.struct.DBSObject">
                            <or>
                                <instanceof value="com.seizia.chromite.model.struct.rdb.DBSTable"/>
                                <test property="com.seizia.chromite.model.isTableContainer"/>
                            </or>
                        </adapt>
                    </iterate>
                </with>
            </enabledWhen>
        </handler>
        <handler commandId="com.seizia.chromite.erd.diagram.create" class="com.seizia.chromite.ui.editors.erd.navigator.CreateDiagramHandler">
            <enabledWhen>
                <with variable="activePart">
                    <and>
                        <test property="com.seizia.chromite.core.global.ui.currentProjectResourceEditable"/>
                    </and>
                </with>
            </enabledWhen>
        </handler>
        <handler commandId="com.seizia.chromite.erd.focus.diagram" class="com.seizia.chromite.ui.editors.erd.action.ERDHandlerFocus">
            <activeWhen>
                <with variable="activeEditor">
                    <adapt type="com.seizia.chromite.ui.editors.erd.editor.ERDEditorPart"/>
                </with>
            </activeWhen>
        </handler>
        <handler commandId="com.seizia.chromite.erd.focus.palette" class="com.seizia.chromite.ui.editors.erd.action.ERDHandlerFocus">
            <activeWhen>
                <with variable="activeEditor">
                    <adapt type="com.seizia.chromite.ui.editors.erd.editor.ERDEditorPart"/>
                </with>
            </activeWhen>
        </handler>
        <handler commandId="com.seizia.chromite.erd.focus.outline" class="com.seizia.chromite.ui.editors.erd.action.ERDHandlerFocus">
            <activeWhen>
                <with variable="activeEditor">
                    <adapt type="com.seizia.chromite.ui.editors.erd.editor.ERDEditorPart"/>
                </with>
            </activeWhen>
        </handler>
        <handler commandId="com.seizia.chromite.erd.focus.parameter" class="com.seizia.chromite.ui.editors.erd.action.ERDHandlerFocus">
            <activeWhen>
                <with variable="activeEditor">
                    <adapt type="com.seizia.chromite.ui.editors.erd.editor.ERDEditorPart"/>
                </with>
            </activeWhen>
        </handler>
    </extension>

    <extension point="org.eclipse.ui.menus">
        <!-- All Context menus -->
        <menuContribution allPopups="false" locationURI="popup:org.eclipse.ui.popup.any?after=object">
            <command commandId="com.seizia.chromite.erd.diagram.view" label="%command.com.seizia.chromite.erd.diagram.view.name">
                <visibleWhen checkEnabled="true"/>
            </command>
        </menuContribution>

        <menuContribution allPopups="false" locationURI="popup:org.eclipse.ui.popup.any?after=create">
            <command commandId="com.seizia.chromite.erd.diagram.create" label="%menu.create.new.diagram">
                <visibleWhen checkEnabled="true">
                    <with variable="selection">
                        <count value="1"/>
                        <iterate operator="and">
                            <adapt type="org.eclipse.core.resources.IFolder">
                                <and>
                                    <test property="com.seizia.chromite.core.resource.type" value="erd_folder"/>
                                    <test property="com.seizia.chromite.core.global.ui.currentProjectResourceEditable"/>
                                </and>
                            </adapt>
                        </iterate>
                    </with>
                </visibleWhen>
            </command>
        </menuContribution>

        <menuContribution allPopups="false" locationURI="popup:org.eclipse.ui.popup.any?before=generate">
            <command commandId="com.seizia.chromite.erd.diagram.create" label="%menu.create.new.diagram">
                <visibleWhen checkEnabled="true">
                    <with variable="selection">
                        <count value="(1-"/>
                        <iterate operator="and">
                            <adapt type="com.seizia.chromite.model.struct.DBSEntity"/>
                        </iterate>
                    </with>
                </visibleWhen>
            </command>
        </menuContribution>

        <menuContribution allPopups="false" locationURI="menu:dataSourceMenu?after=tools">
            <command commandId="com.seizia.chromite.erd.diagram.create" label="%menu.create.new.diagram">
                <visibleWhen checkEnabled="true">
                    <with variable="selection">
                        <count value="+"/>
                        <iterate operator="and">
                            <and>
                                <adapt type="com.seizia.chromite.model.struct.DBSEntity"/>
                                <test property="com.seizia.chromite.core.global.ui.currentProjectResourceEditable"/>
                            </and>
                        </iterate>
                    </with>
                </visibleWhen>
            </command>
        </menuContribution>

        <menuContribution allPopups="false" locationURI="popup:com.seizia.chromite.ui.editors.erd.editor.ERDEditorPart.EditorContext?after=additions">
            <command commandId="org.eclipse.ui.edit.undo"/>
            <command commandId="org.eclipse.ui.edit.redo"/>
            <separator name="selection" visible="true"/>
            <command commandId="org.eclipse.ui.edit.selectAll"/>
        </menuContribution>

    </extension>

    <extension point="org.eclipse.ui.newWizards">
        <wizard
             category="com.seizia.chromite.core.new.general"
             class="com.seizia.chromite.ui.editors.erd.navigator.DiagramCreateWizard"
             icon="platform:/plugin/com.seizia.chromite.model.erd/icons/erd.svg"
             id="com.seizia.chromite.ui.editors.erd.navigator.DiagramCreateWizard"
             name="%wizard.erd.name">
           <description>
               %wizard.erd.description
           </description>
        </wizard>
    </extension>

    <extension point="org.eclipse.ui.perspectiveExtensions">
        <perspectiveExtension targetID="com.seizia.chromite.core.perspective">
            <newWizardShortcut id="com.seizia.chromite.ui.editors.erd.navigator.DiagramCreateWizard"/>
        </perspectiveExtension>
    </extension>

    <extension point="com.seizia.chromite.ui.editors.erd.export.format">
        <exportFormat ext="png" label="PNG format" class="com.seizia.chromite.ui.editors.erd.export.ERDExportRasterImage"/>
        <exportFormat ext="gif" label="GIF format" class="com.seizia.chromite.ui.editors.erd.export.ERDExportRasterImage"/>
        <exportFormat ext="bmp" label="BMP format" class="com.seizia.chromite.ui.editors.erd.export.ERDExportRasterImage"/>
        <exportFormat ext="erd" label="ERD format" class="com.seizia.chromite.ui.editors.erd.export.ERDExportERD"/>
        <exportFormat ext="graphml" label="GraphML format" class="com.seizia.chromite.ui.editors.erd.export.ERDExportGraphML"/>
    </extension>

    <extension point="com.seizia.chromite.confirmations">
        <confirmation
            id="erd_open_exported_file"
            title="%confirm.erd_open_exported_file.title"
            message="%confirm.erd_open_exported_file.message"
            toggleMessage="%confirm.erd_open_exported_file.toggleMessage"
            group="%editor.erd.name"/>
    </extension>
    <extension
          point="com.seizia.chromite.ui.editors.erd.notation.style">
       <erdNotation
             description="Integration DEFinition for information modeling (IDEF1X) notation"
             id="com.seizia.chromite.erd.notaion.idef1x"
             name="IDEF1X"
             notation="com.seizia.chromite.ui.editors.erd.notation.idef1x.IDEF1XDiagramNotation">
       </erdNotation>
       <erdNotation
             description="Crow's Foot diagram notation"
             id="com.seizia.chromite.erd.notaion.crowsfoot"
             name="Crow's Foot"
             notation="com.seizia.chromite.ui.editors.erd.notation.crowsfoot.CrowsFootDiagramNotation">
       </erdNotation>
    </extension>
    <extension
          point="com.seizia.chromite.ui.editors.erd.routing">
       <erdConnectionRouter
             id="com.seizia.chromite.erd.router.shortest.path"
             name="Shortest paths"
             description="Router based on shortest pathes"
             router="com.seizia.chromite.ui.editors.erd.router.shortpath.ShortPathRouting">
       </erdConnectionRouter>
    </extension>

</plugin>
