<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>

    <extension-point id="com.seizia.chromite.ui.editors.erd.export.format" name="ERD Export Formats" schema="schema/com.seizia.chromite.ext.erd.export.format.exsd"/>
    <extension-point id="com.seizia.chromite.ui.editors.erd.notation.style" name="ER Diagram Notation Style Specification" schema="schema/com.seizia.chromite.ui.editors.erd.notation.style.exsd"/>
    <extension-point id="com.seizia.chromite.ui.editors.erd.routing" name="ER Diagram Connection Routing Specification" schema="schema/com.seizia.chromite.ui.editors.erd.routing.exsd"/>

    <extension point="com.seizia.chromite.databaseEditor">
        <editor
            id="com.seizia.chromite.ui.editors.erd.editor.ERDEditorEmbedded"
            class="com.seizia.chromite.ui.editors.erd.editor.ERDEditorEmbedded"
            lazy="true"
            main="false"
            label="%editor.erd.name"
            description="%editor.erd.description"
            position="additions_end"
            icon="platform:/plugin/com.seizia.chromite.model.erd/icons/erd.svg">
            <objectType name="com.seizia.chromite.model.struct.DBSObjectContainer" forceCheck="true" if="context.isEntityContainer(object)"/>
            <objectType name="com.seizia.chromite.model.struct.rdb.DBSTable" forceCheck="true" if="context.supportsEntityDiagram(object)"/>
        </editor>
    </extension>

    <extension point="com.seizia.chromite.resourceHandler">
        <handler type="er-diagram" class="com.seizia.chromite.ui.editors.erd.navigator.ERDResourceHandler"
                 lazyFolder="true" folderTypeName="erd_folder"/>
    </extension>

    <extension point="org.eclipse.core.runtime.adapters">
        <factory adaptableType="org.eclipse.gef.EditPart" class="com.seizia.chromite.ui.editors.erd.model.ERDObjectAdapter">
            <adapter type="com.seizia.chromite.model.DBPNamedObject"/>
            <adapter type="com.seizia.chromite.model.DBPQualifiedObject"/>
            <adapter type="com.seizia.chromite.model.struct.DBSObject"/>
            <adapter type="com.seizia.chromite.model.struct.DBSEntity"/>
            <adapter type="com.seizia.chromite.model.preferences.DBPPropertySource"/>
            <adapter type="com.seizia.chromite.model.navigator.DBNNode"/>
        </factory>
        <factory adaptableType="org.eclipse.swt.widgets.Control" class="com.seizia.chromite.ui.editors.erd.editor.ERDEditorAdapter">
           <adapter type="com.seizia.chromite.ui.editors.erd.editor.ERDEditorPart"/>
        </factory>
        <factory adaptableType="org.eclipse.ui.IEditorPart" class="com.seizia.chromite.ui.editors.erd.editor.ERDEditorAdapter">
            <adapter type="com.seizia.chromite.ui.editors.erd.editor.ERDEditorPart"/>
        </factory>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <handler commandId="org.eclipse.ui.edit.copy" class="com.seizia.chromite.ui.editors.erd.action.ERDHandlerCopy">
            <activeWhen>
                <with variable="activeFocusControlId">
                    <equals value="com.seizia.chromite.erd.ERDEditor"/>
                </with>
            </activeWhen>
            <enabledWhen>
                <with variable="selection">
                    <count value="+"/>
                </with>
            </enabledWhen>
        </handler>

        <handler commandId="org.eclipse.ui.edit.paste" class="com.seizia.chromite.ui.editors.erd.action.ERDHandlerPaste">
            <activeWhen>
                <with variable="activeFocusControlId">
                    <equals value="com.seizia.chromite.erd.ERDEditor"/>
                </with>
            </activeWhen>
            <enabledWhen>
                <and>
                    <with variable="activeFocusControlId"><equals value="com.seizia.chromite.erd.ERDEditor"/></with>
                    <with variable="activeFocusControl">
                        <adapt type="com.seizia.chromite.ui.editors.erd.editor.ERDEditorPart">
                            <test property="com.seizia.chromite.ui.editors.erd.editor.editable"/>
                        </adapt>
                    </with>
                </and>
            </enabledWhen>
        </handler>

        <handler commandId="org.eclipse.ui.edit.delete" class="com.seizia.chromite.ui.editors.erd.action.ERDHandlerDelete">
            <activeWhen>
                <with variable="activeFocusControlId">
                    <equals value="com.seizia.chromite.erd.ERDEditor"/>
                </with>
            </activeWhen>
            <enabledWhen>
                <and>
                    <with variable="activeFocusControlId"><equals value="com.seizia.chromite.erd.ERDEditor"/></with>
                    <with variable="activeFocusControl">
                        <adapt type="com.seizia.chromite.ui.editors.erd.editor.ERDEditorPart">
                            <test property="com.seizia.chromite.ui.editors.erd.editor.canDelete"/>
                        </adapt>
                    </with>
                    <with variable="selection">
                        <count value="+"/>
                    </with>
                </and>
            </enabledWhen>
        </handler>
        <handler commandId="org.eclipse.ui.edit.selectAll" class="com.seizia.chromite.ui.editors.erd.action.ERDHandlerSelectAll">
            <activeWhen>
                <with variable="activeFocusControlId">
                    <equals value="com.seizia.chromite.erd.ERDEditor"/>
                </with>
            </activeWhen>
        </handler>
        <handler commandId="org.eclipse.ui.edit.undo" class="com.seizia.chromite.ui.editors.erd.action.ERDHandlerUndo">
            <activeWhen>
                <with variable="activeFocusControlId">
                    <equals value="com.seizia.chromite.erd.ERDEditor"/>
                </with>
            </activeWhen>
            <enabledWhen>
                <and>
                    <with variable="activeFocusControlId"><equals value="com.seizia.chromite.erd.ERDEditor"/></with>
                    <with variable="activeFocusControl">
                        <adapt type="com.seizia.chromite.ui.editors.erd.editor.ERDEditorPart">
                            <test property="com.seizia.chromite.ui.editors.erd.editor.canUndo"/>
                        </adapt>
                    </with>
                </and>
            </enabledWhen>
        </handler>
        <handler commandId="org.eclipse.ui.edit.redo" class="com.seizia.chromite.ui.editors.erd.action.ERDHandlerRedo">
            <activeWhen>
                <with variable="activeFocusControlId">
                    <equals value="com.seizia.chromite.erd.ERDEditor"/>
                </with>
            </activeWhen>
            <enabledWhen>
                <and>
                    <with variable="activeFocusControlId"><equals value="com.seizia.chromite.erd.ERDEditor"/></with>
                    <with variable="activeFocusControl">
                        <adapt type="com.seizia.chromite.ui.editors.erd.editor.ERDEditorPart">
                            <test property="com.seizia.chromite.ui.editors.erd.editor.canRedo"/>
                        </adapt>
                    </with>
                </and>
            </enabledWhen>
        </handler>
        <handler commandId="org.eclipse.ui.file.print" class="com.seizia.chromite.ui.editors.erd.action.ERDHandlerPrint">
            <activeWhen>
                <with variable="activeEditor">
                    <adapt type="com.seizia.chromite.ui.editors.erd.editor.ERDEditorPart"/>
                </with>
            </activeWhen>
        </handler>
        <handler commandId="org.eclipse.ui.file.refresh" class="com.seizia.chromite.ui.editors.erd.action.ERDHandlerRefresh">
            <activeWhen>
                <with variable="activeFocusControlId">
                    <equals value="com.seizia.chromite.erd.ERDEditor"/>
                </with>
            </activeWhen>
        </handler>
        <handler commandId="com.seizia.chromite.erd.diagram.saveAs" class="com.seizia.chromite.ui.editors.erd.action.ERDHandlerSaveImage">
            <activeWhen>
                <with variable="activeEditor">
                    <adapt type="com.seizia.chromite.ui.editors.erd.editor.ERDEditorPart"/>
                </with>
            </activeWhen>
        </handler>

    </extension>

    <extension point="org.eclipse.core.expressions.propertyTesters">
       <propertyTester
             class="com.seizia.chromite.ui.editors.erd.action.ERDEditorPropertyTester"
             id="com.seizia.chromite.ui.editors.erd.action.ERDEditorPropertyTester"
