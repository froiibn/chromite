<?xml version='1.0' encoding='UTF-8'?>
<!-- Schema file written by PDE -->
<schema targetNamespace="com.seizia.chromite.model.ai" xmlns="http://www.w3.org/2001/XMLSchema">
   <annotation>
      <appInfo>
         <meta.schema plugin="com.seizia.chromite.model.ai" id="com.seizia.chromite.ai.function" name="AI functions"/>
      </appInfo>
      <documentation>AI functions for assistant functionality</documentation>
   </annotation>

   <element name="extension">
      <annotation><appInfo><meta.element/></appInfo></annotation>
      <complexType>
         <sequence>
            <element ref="category" minOccurs="0" maxOccurs="unbounded"/>
            <element ref="function" minOccurs="0" maxOccurs="unbounded"/>
         </sequence>
      </complexType>
   </element>

   <element name="category">
      <complexType>
         <attribute name="id" type="string" use="required">
            <annotation>
               <documentation>Unique category identifier</documentation>
            </annotation>
         </attribute>
         <attribute name="name" type="string" use="required">
            <annotation>
               <documentation>Human-readable category name</documentation>
            </annotation>
         </attribute>
         <attribute name="description" type="string">
            <annotation>
               <documentation>Optional category description</documentation>
            </annotation>
         </attribute>
      </complexType>
   </element>

   <element name="function">
      <complexType>
         <sequence>
            <element ref="alias" minOccurs="0" maxOccurs="unbounded"/>
            <element ref="parameter" minOccurs="0" maxOccurs="unbounded"/>
         </sequence>
         <attribute name="id" type="string" use="required">
            <annotation>
               <documentation>Unique function identifier</documentation>
            </annotation>
         </attribute>
         <attribute name="legacyId" type="string">
             <annotation>
                <documentation>
                   Legacy identifier accepted when reading persisted settings and function calls
                </documentation>
             </annotation>
         </attribute>
         <attribute name="name" type="string" use="required">
            <annotation>
               <documentation>Function name used by AI assistant</documentation>
            </annotation>
         </attribute>
         <attribute name="class" type="string">
            <annotation>
               <documentation>Class implementing the AIFunction interface</documentation>
               <appInfo>
                  <meta.attribute kind="java" basedOn=":com.seizia.chromite.model.ai.AIFunction"/>
               </appInfo>
            </annotation>
         </attribute>
         <attribute name="description" type="string">
            <annotation>
               <documentation>Detailed AI-facing function description used by the assistant to understand the function behavior and when to call it</documentation>
            </annotation>
         </attribute>
         <attribute name="userDescription" type="string">
            <annotation>
               <documentation>Optional shorter user-facing description shown in UI. If omitted, description is used</documentation>
            </annotation>
         </attribute>
         <attribute name="defaultAllowMode">
            <annotation>
               <documentation>Default confirmation mode for this function. If omitted, internal functions are always allowed and external functions ask for confirmation.</documentation>
            </annotation>
            <simpleType>
               <restriction base="string">
                  <enumeration value="ALWAYS_ALLOW"/>
                  <enumeration value="ASK"/>
               </restriction>
            </simpleType>
         </attribute>
         <attribute name="categoryId" type="string">
            <annotation>
               <documentation>Reference to a category id declared in the same or another extension</documentation>
            </annotation>
         </attribute>
         <attribute name="type">
            <annotation>
               <documentation>Function type: INFORMATION (read-only, returns data) or ACTION (performs an action). Defaults to INFORMATION</documentation>
            </annotation>
            <simpleType>
               <restriction base="string">
                  <enumeration value="INFORMATION"/>
                  <enumeration value="ACTION"/>
               </restriction>
            </simpleType>
         </attribute>
         <attribute name="purpose">
            <annotation>
               <documentation>Function purpose: TOOL (AI assistant tool), MCP (MCP protocol only), ALL (both). Defaults to TOOL</documentation>
            </annotation>
            <simpleType>
               <restriction base="string">
                  <enumeration value="TOOL"/>
                  <enumeration value="MCP"/>
                  <enumeration value="ALL"/>
               </restriction>
            </simpleType>
         </attribute>
         <attribute name="access">
            <annotation>
               <documentation>Permission class of the tool (docs/chromite/ai-agent.md): READ (reads only), WRITE (changes data, schema, files or server state), DANGEROUS (destructive or disruptive). Defaults to READ for INFORMATION and WRITE for ACTION functions</documentation>
            </annotation>
            <simpleType>
               <restriction base="string">
                  <enumeration value="READ"/>
                  <enumeration value="WRITE"/>
                  <enumeration value="DANGEROUS"/>
               </restriction>
            </simpleType>
         </attribute>
         <attribute name="writes">
            <annotation>
               <documentation>What a WRITE or DANGEROUS tool changes: database (default; refused on read-only connections), file (local file system only), none (application state only)</documentation>
            </annotation>
            <simpleType>
               <restriction base="string">
                  <enumeration value="database"/>
                  <enumeration value="file"/>
                  <enumeration value="none"/>
               </restriction>
            </simpleType>
         </attribute>
         <attribute name="toolSet">
            <annotation>
               <documentation>Smallest tool set of the Chromite Agent chat that contains the tool (docs/chromite/ai-agent.md): minimal (sent to small models; also in core), core (sent by default to hosted models), or none for the full set only</documentation>
            </annotation>
            <simpleType>
               <restriction base="string">
                  <enumeration value="minimal"/>
                  <enumeration value="core"/>
               </restriction>
            </simpleType>
         </attribute>
         <attribute name="shortDescription" type="string">
            <annotation>
               <documentation>One or two sentences sent instead of the description in the minimal tool set</documentation>
            </annotation>
         </attribute>
         <attribute name="system" type="boolean">
            <annotation>
               <documentation>If true, this is a system function</documentation>
            </annotation>
         </attribute>
         <attribute name="addedIn" type="string">
            <annotation>
               <documentation>Edition that added the tool (for example 26.1.0 for a tool that merged or renamed former tools): the tool policy migration knows it had no rules of its own before</documentation>
            </annotation>
         </attribute>
         <attribute name="operationParameter" type="string">
            <annotation>
               <documentation>Name of the parameter whose value is the operation of a call of a tool that merges several former tools (for example changeSchema: operation). The audit log records it next to the tool id</documentation>
            </annotation>
         </attribute>
         <attribute name="alwaysConfirmed" type="boolean">
            <annotation>
               <documentation>If true, the user confirms every call that has something to do, whatever the tool policy allows (the transaction guard asks Commit / Roll back / Cancel): commitTransaction, rollbackTransaction. The Tool Policy table shows it instead of an automatic run</documentation>
            </annotation>
         </attribute>
         <attribute name="omitConfirmation" type="boolean">
            <annotation>
               <documentation>If true, this function does not require confirmation</documentation>
            </annotation>
         </attribute>
         <attribute name="ui" type="boolean">
            <annotation>
               <documentation>If true, this function requires UI interaction</documentation>
            </annotation>
         </attribute>
         <attribute name="enabledByDefault" type="boolean">
            <annotation>
               <documentation>If true, this function is enabled by default</documentation>
            </annotation>
         </attribute>
         <attribute name="dependsOn" type="string">
            <annotation>
               <documentation>Comma-separated list of function IDs that must be enabled for this function to work</documentation>
            </annotation>
         </attribute>
         <attribute name="icon" type="string">
            <annotation>
               <documentation>Optional icon path for this function</documentation>
               <appInfo>
                  <meta.attribute kind="resource"/>
               </appInfo>
            </annotation>
         </attribute>
      </complexType>
   </element>

   <element name="alias">
      <annotation>
         <documentation>A former id of the tool (renamed, or merged into it), accepted for one edition: calls with it (MCP, saved conversations, found tools, playbooks) run this tool, and the tool policy moves its rules here once (docs/chromite/ai-agent.md "별칭"). tools/list does not show it</documentation>
      </annotation>
      <complexType>
         <attribute name="id" type="string" use="required">
            <annotation>
               <documentation>The former tool id</documentation>
            </annotation>
         </attribute>
         <attribute name="access">
            <annotation>
               <documentation>Permission class the former tool had (the policy migration computes the rules it resolved to). Defaults to the class of this tool</documentation>
            </annotation>
            <simpleType>
               <restriction base="string">
                  <enumeration value="READ"/>
                  <enumeration value="WRITE"/>
                  <enumeration value="DANGEROUS"/>
               </restriction>
            </simpleType>
         </attribute>
         <attribute name="arguments" type="string">
            <annotation>
               <documentation>Comma-separated name=value pairs set on every call through this alias, replacing what the caller passed (for example operation=dropTable)</documentation>
            </annotation>
         </attribute>
         <attribute name="defaults" type="string">
            <annotation>
               <documentation>Comma-separated name=value pairs set on a call through this alias when the caller did not pass them (for example offset=0)</documentation>
            </annotation>
         </attribute>
         <attribute name="removeIn" type="string">
            <annotation>
               <documentation>Edition in which the alias is removed</documentation>
            </annotation>
         </attribute>
      </complexType>
   </element>

   <element name="parameter">
      <complexType>
         <attribute name="name" type="string" use="required">
            <annotation>
               <documentation>Parameter name</documentation>
            </annotation>
         </attribute>
         <attribute name="aliases" type="string">
            <annotation>
               <documentation>Comma-separated former names of the parameter, accepted for one edition (docs/chromite/ai-agent.md "별칭")</documentation>
            </annotation>
         </attribute>
         <attribute name="type" type="string" use="required">
            <annotation>
               <documentation>Parameter type (e.g. string, integer, boolean)</documentation>
            </annotation>
         </attribute>
         <attribute name="description" type="string">
            <annotation>
               <documentation>Parameter description passed to the AI to explain its purpose</documentation>
            </annotation>
         </attribute>
         <attribute name="shortDescription" type="string">
            <annotation>
               <documentation>Shorter description sent in the minimal tool set of the Chromite Agent chat</documentation>
            </annotation>
         </attribute>
         <attribute name="required" type="boolean">
            <annotation>
               <documentation>Whether this parameter is required. Defaults to false</documentation>
            </annotation>
         </attribute>
         <attribute name="defaultValue" type="string">
            <annotation>
               <documentation>Default value used when the parameter is not supplied</documentation>
            </annotation>
         </attribute>
         <attribute name="validValues" type="string">
            <annotation>
               <documentation>Comma-separated list of valid values for this parameter</documentation>
            </annotation>
         </attribute>
         <attribute name="validValuesProvider" type="string">
            <annotation>
               <documentation>Optional class implementing AIFunctionParameterValueProvider used to provide valid values dynamically</documentation>
               <appInfo>
                  <meta.attribute kind="java" basedOn=":com.seizia.chromite.model.ai.AIFunctionParameterValueProvider"/>
               </appInfo>
            </annotation>
         </attribute>
         <attribute name="transformer" type="string">
            <annotation>
               <documentation>Optional class implementing AIFunctionParameterTransformer used to transform the raw parameter value before passing it to the function</documentation>
               <appInfo>
                  <meta.attribute kind="java" basedOn=":com.seizia.chromite.model.ai.AIFunctionParameterTransformer"/>
               </appInfo>
            </annotation>
         </attribute>
         <attribute name="targetSuffix" type="string">
            <annotation>
               <documentation>Suffix appended to the parameter name when storing the transformed value. Used together with transformer</documentation>
            </annotation>
         </attribute>
      </complexType>
   </element>

</schema>
