<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>

    <extension point="com.seizia.chromite.dataSourceProvider">
        <editorContribution
                editorId="com.seizia.chromite.ext.mysql.ui.editors.MySQLSessionEditor"
                category="connectionEditor" label="%editor.session_manager.name"
                icon="platform:/plugin/com.seizia.chromite.model/icons/tree/sessions.svg">
            <supports dataSource="oceanbase"/>
        </editorContribution>
    </extension>

    <extension point="com.seizia.chromite.dataSourceConfigurator">
        <configurator dataSource="oceanbase" class="com.seizia.chromite.ext.oceanbase.ui.views.OceanbaseConnectionPage"/>
    </extension>

    <extension point="com.seizia.chromite.ui.propertyConfigurator">
        <propertyConfigurator
            class="com.seizia.chromite.ext.oceanbase.model.auth.OceanbaseAuthModelDatabaseNative"
            uiClass="com.seizia.chromite.ui.dialogs.connection.DatabaseNativeAuthModelConfigurator"/>
    </extension>

</plugin>

