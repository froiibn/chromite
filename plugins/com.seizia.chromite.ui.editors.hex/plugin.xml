<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>

<plugin>
    <extension point="com.seizia.chromite.dataManager">
        <streamManager class="com.seizia.chromite.ui.data.BinaryStreamValueManager" id="binary" label="Binary" primaryMime="octet/binary" supportedMime="text,binary,app,application"
                       description="Hex editor" icon="platform:/plugin/com.seizia.chromite.model/icons/types/binary.svg"/>
    </extension>

    <extension point="com.seizia.chromite.service">
        <service name="com.seizia.chromite.ui.data.IHexEditorService" class="com.seizia.chromite.ui.editors.binary.HexEditorService"/>
    </extension>

    <extension point="org.eclipse.ui.themes">

        <!-- Colors for Hex editor -->
        <themeElementCategory label="%themeElementCategory.com.seizia.chromite.ui.presentation.hex.label" id="com.seizia.chromite.ui.presentation.hex">
            <description>%themeElementCategory.com.seizia.chromite.ui.presentation.hex.description</description>
        </themeElementCategory>

        <colorDefinition
            label="%colorDefinition.com.seizia.chromite.hex.editor.color.caret.label"
            categoryId="com.seizia.chromite.ui.presentation.hex"
            id="com.seizia.chromite.hex.editor.color.caret"
            value="232,242,254">
            <description>%colorDefinition.com.seizia.chromite.hex.editor.color.caret.description</description>
        </colorDefinition>
        <colorDefinition
            label="%colorDefinition.com.seizia.chromite.hex.editor.color.text.label"
            categoryId="com.seizia.chromite.ui.presentation.hex"
            id="com.seizia.chromite.hex.editor.color.text"
            value="COLOR_BLACK">
            <description>%colorDefinition.com.seizia.chromite.hex.editor.color.text.description</description>
        </colorDefinition>

    </extension>

    <extension point="org.eclipse.ui.handlers">
        <handler commandId="org.eclipse.ui.edit.copy" class="com.seizia.chromite.ui.editors.binary.HexCommandHandler">
            <activeWhen><with variable="activeFocusControlId"><equals value="com.seizia.chromite.ui.hexEditor"/></with></activeWhen>
        </handler>
        <handler commandId="org.eclipse.ui.edit.paste" class="com.seizia.chromite.ui.editors.binary.HexCommandHandler">
            <activeWhen><with variable="activeFocusControlId"><equals value="com.seizia.chromite.ui.hexEditor"/></with></activeWhen>
        </handler>
    </extension>

    <extension point="org.eclipse.ui.preferencePages">
        <page category="com.seizia.chromite.preferences.main.resultset.editors" id="com.seizia.chromite.ui.editors.binary.pref.HexPreferencesPage" class="com.seizia.chromite.ui.editors.binary.pref.HexPreferencesPage" name="%pref.page.name.binary.editor">
            <keywordReference id="com.seizia.chromite.core.keyword.pref.editor.binary"/>
            <keywordReference id="com.seizia.chromite.core.keyword.chromite"/>
        </page>
    </extension>

</plugin>
