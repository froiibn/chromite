<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>

<plugin>

    <extension point="com.seizia.chromite.generic.meta">
        <meta id="firebird" class="com.seizia.chromite.ext.firebird.model.FireBirdMetaModel" driverClass="org.firebirdsql.jdbc.FBDriver"/>
    </extension>

    <extension point="com.seizia.chromite.dataSourceProvider">

        <dataSourceType
            id="firebird"
            label="Firebird"
            description="Firebird database"
            dataSourceInformation="Relational database management system"
            icon="icons/firebird_icon.png"
            iconBig="icons/firebird_icon_big.png"/>

        <!-- SQL Server -->

        <datasource
                class="com.seizia.chromite.ext.firebird.FireBirdDataSourceProvider"
                description="Firebird Jaybird driver"
                id="jaybird"
                dataSourceType="firebird"
                parent="generic"
                label="Firebird"
                icon="icons/firebird_icon.png"
                dialect="firebird">
            <drivers managable="true">

                <driver
                        id="jaybird"
                        label="Firebird"
                        class="org.firebirdsql.jdbc.FBDriver"
                        sampleURL="jdbc:firebirdsql://{host}:{port}/{file}"
                        defaultPort="3050"
                        defaultUser="SYSDBA"
                        webURL="https://firebirdsql.org/en/jdbc-driver/"
                        propertiesURL="https://github.com/FirebirdSQL/jaybird/wiki/Connection-properties"
                        description="Firebird Jaybird driver"
                        supportedConfigurationTypes="MANUAL,URL"
                        categories="sql">
                    <replace provider="generic" driver="firebird_jaybird"/>
                    <replace provider="generic" driver="firebird_jaybird3"/>

                    <file type="jar" path="maven:/org.firebirdsql.jdbc:jaybird:RELEASE[5.0.4.java11]" bundle="!drivers.firebird"/>
                    <file type="license" path="licenses/external/lgpl-3.0.txt"/>

                    <file type="license" path="drivers/jaybird/LICENSE.txt" bundle="drivers.firebird"/>
                    <file type="jar" path="drivers/jaybird" bundle="drivers.firebird"/>

                    <property name="encoding" value="UTF8"/>

                    <parameter name="supports-embedded-database-creation" value="false"/>
                    <parameter name="supports-scroll" value="true"/>
                    <parameter name="ddl-drop-column-short" value="true"/>
                    <parameter name="script-delimiter-redefiner" value="SET TERM"/>
                    <parameter name="supports-truncate" value="false"/>
                </driver>

                <driver
                        id="jaybird_embedded"
                        label="Firebird Embedded"
                        class="org.firebirdsql.jdbc.FBDriver"
                        sampleURL="jdbc:firebirdsql:embedded:{file}"
                        defaultUser="SYSDBA"
                        webURL="https://firebirdsql.org/en/jdbc-driver/"
                        propertiesURL="https://github.com/FirebirdSQL/jaybird/wiki/Connection-properties"
                        description="Firebird embedded driver (local file, no server needed)"
                        supportedConfigurationTypes="MANUAL,URL"
                        embedded="true"
                        categories="sql,embedded">

                    <file type="jar" path="maven:/org.firebirdsql.jdbc:jaybird:RELEASE[5.0.4.java11]" bundle="!drivers.firebird"/>
                    <file type="jar" path="maven:/net.java.dev.jna:jna:RELEASE[5.14.0]" bundle="!drivers.firebird"/>
                    <file type="license" path="licenses/external/lgpl-3.0.txt"/>

                    <file type="license" path="drivers/jaybird/LICENSE.txt" bundle="drivers.firebird"/>
                    <file type="jar" path="drivers/jaybird" bundle="drivers.firebird"/>

                    <property name="encoding" value="UTF8"/>

                    <parameter name="supports-embedded-database-creation" value="true"/>
                    <parameter name="supports-scroll" value="true"/>
                    <parameter name="ddl-drop-column-short" value="true"/>
                    <parameter name="script-delimiter-redefiner" value="SET TERM"/>
                    <parameter name="supports-truncate" value="false"/>
                </driver>
            </drivers>

        </datasource>
    </extension>

    <extension point="com.seizia.chromite.objectManager">
        <manager class="com.seizia.chromite.ext.firebird.edit.FireBirdTableManager" objectType="com.seizia.chromite.ext.firebird.model.FireBirdTable"/>
        <manager class="com.seizia.chromite.ext.firebird.edit.FireBirdTableColumnManager" objectType="com.seizia.chromite.ext.firebird.model.FireBirdTableColumn"/>
        <manager class="com.seizia.chromite.ext.firebird.edit.FireBirdProcedureManager" objectType="com.seizia.chromite.ext.firebird.model.FireBirdProcedure"/>
    </extension>

    <extension point="com.seizia.chromite.sqlInsertMethod">
        <method id="firebirdReplaceIgnore" class="com.seizia.chromite.ext.firebird.model.FireBirdInsertReplaceMethod" label="UPDATE OR INSERT INTO" description="Insert replace duplicate key value"/>
    </extension>

    <extension point="com.seizia.chromite.sqlDialect">
        <dialect id="firebird" parent="generic" class="com.seizia.chromite.ext.firebird.model.FireBirdSQLDialect" label="Firebird" description="Firebird SQL dialect." icon="icons/firebird_icon.png">
            <property name="insertMethods" value="firebirdReplaceIgnore"/>
        </dialect>
    </extension>

    <extension point="com.seizia.chromite.sqlGenerator">
        <generator id="firebirdUpdateOrInsert"
            class="com.seizia.chromite.ext.firebird.model.sql.generator.SQLGeneratorUpdateOrInsert"
            label="UPDATE OR INSERT"
            description="UPDATE OR INSERT INTO with MATCHING clause"
            order="7">
            <objectType name="com.seizia.chromite.ext.firebird.model.FireBirdTable"/>
        </generator>
        <generator id="firebirdExecuteBlock"
            class="com.seizia.chromite.ext.firebird.model.sql.generator.SQLGeneratorExecuteBlock"
            label="EXECUTE BLOCK"
            description="EXECUTE BLOCK with variable declarations"
            order="8">
            <objectType name="com.seizia.chromite.ext.firebird.model.FireBirdTable"/>
        </generator>
    </extension>

</plugin>
