<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>

<plugin>

    <extension point="com.seizia.chromite.sqlDialect">
        <dialect id="ocient" parent="generic" class="com.seizia.chromite.ext.ocient.model.OcientSQLDialect" label="Ocient" description="Ocient dialect." icon="platform:/plugin/com.seizia.chromite.ext.generic/icons/ocient_icon.png">
        </dialect>
    </extension>

    <extension point="com.seizia.chromite.dataSourceProvider">
        <dataSourceType
            id="ocient"
            label="Ocient"
            description="Ocient database"
            dataSourceInformation="High-performance analytical database platform"
            icon="icons/ocient_icon.png"
            iconBig="icons/ocient_icon_big.png"/>
        <datasource
                class="com.seizia.chromite.ext.ocient.OcientDataSourceProvider"
                description="%datasource.bq.description"
                id="ocient"
                dataSourceType="ocient"
                parent="generic"
                label="Ocient DB"
                icon="icons/ocient_icon.png"
                dialect="ocient">
            <drivers managable="true">
                <driver
                        id="ocient_jdbc"
                        label="Ocient"
                        class="com.ocient.jdbc.JDBCDriver"
                        sampleURL="jdbc:ocient://{host}:{port}/{database}"
                        defaultPort="4050"
                        description="Ocient JDBC driver"
                        webURL=""
                        categories="sql,analytic">
                    <file type="jar" path="maven:/com.ocient:ocient-jdbc4:RELEASE"/>
                    <file type="license" path="licenses/external/asl-2.0.txt"/>
                </driver>
             </drivers>
        </datasource>
    </extension>
    
    <extension point="com.seizia.chromite.generic.meta">
        <meta id="ocient" class="com.seizia.chromite.ext.ocient.model.OcientMetaModel" driverClass="com.ocient.jdbc.Driver"/>
    </extension>

</plugin>
