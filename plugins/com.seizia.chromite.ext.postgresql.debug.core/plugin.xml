         <adapter type="com.seizia.chromite.debug.DBGControllerFactory"/>
         <adapter type="com.seizia.chromite.debug.DBGResolver"/>
      </factory>
      <factory adaptableType="com.seizia.chromite.ext.postgresql.model.PostgreProcedure" class="com.seizia.chromite.ext.postgresql.debug.internal.PostgreBreakpointAdapterFactory">
         <adapter type="com.seizia.chromite.debug.DBGBreakpointDescriptor"/>
      </factory>
   </extension>

</plugin>
