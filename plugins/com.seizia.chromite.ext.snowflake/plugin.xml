<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>

<plugin>

    <extension point="com.seizia.chromite.generic.meta">
        <meta id="snowflake" class="com.seizia.chromite.ext.snowflake.model.SnowflakeMetaModel" driverClass="net.snowflake.client.jdbc.SnowflakeDriver"/>
    </extension>

    <extension point="com.seizia.chromite.dataSourceProvider">

        <dataSourceType
            id="snowflake"
            label="Snowflake"
            description="Snowflake database"
            dataSourceInformation="High-performance analytical database platform"
            icon="icons/snowflake_icon.png"
            iconBig="icons/snowflake_icon_big.png"
            logoImage="icons/snowflake_logo.png"/>

        <!-- Snowflake -->

        <datasource
                class="com.seizia.chromite.ext.snowflake.SnowflakeDataSourceProvider"
                description="%datasource.snowflake.description"
                id="snowflake"
                dataSourceType="snowflake"
                parent="generic"
                label="Snowflake"
                icon="icons/snowflake_icon.png"
                dialect="snowflake">
            <drivers managable="true">

                <driver
                        id="snowflake_jdbc"
                        label="Snowflake"
                        class="net.snowflake.client.jdbc.SnowflakeDriver"
                        sampleURL="jdbc:snowflake://{host}[:{port}]/?[db={database}]"
                        defaultPort="443"
                        description="Snowflake JDBC driver"
                        webURL="https://docs.snowflake.net/manuals/user-guide/jdbc-configure.html"
                        databaseDocumentationSuffixURL="Snowflake"
                        categories="sql,analytic"
                        singleConnection="true">
                    <replace provider="generic" driver="snowflake_generic"/>
                    <file type="jar" path="maven:/net.snowflake:snowflake-jdbc:RELEASE[4.3.4]" bundle="!drivers.snowflake"/>
                    <file type="license" path="licenses/external/asl-2.0.txt"/>
                    <file type="jar" path="drivers/snowflake" bundle="drivers.snowflake"/>

                    <parameter name="supports-indexes" value="false"/>
                    <parameter name="query-get-active-db" value="SELECT CURRENT_DATABASE()"/>
                    <parameter name="query-set-active-db" value="USE DATABASE &quot;?&quot;"/>
                    <parameter name="active-entity-type" value="catalog"/>

                    <property name="@chromite-default-resultset.maxrows.sql" value="true"/>
                </driver>

                <provider-properties drivers="*">
                    <propertyGroup label="Settings">
                        <property id="warehouse" label="Warehouse" type="string" description="Snowflake warehouse name"/>
                        <property id="schema" label="Schema" type="string" description="Default schema name"/>
                    </propertyGroup>
                    <propertyGroup label="SQL">
                        <property id="ddString" label="Show $$ quotes as String" type="boolean" supportedConfigurationTypes="MANUAL,URL"/>
                    </propertyGroup>
                </provider-properties>

            </drivers>

        </datasource>
    </extension>

    <extension point="com.seizia.chromite.sqlDialect">
        <dialect id="snowflake" parent="generic" class="com.seizia.chromite.ext.snowflake.model.SnowflakeSQLDialect" label="Snowflake" description="Snowflake SQL dialect." icon="icons/snowflake_icon.png">
        </dialect>
    </extension>

    <extension point="org.eclipse.core.runtime.preferences">
        <initializer class="com.seizia.chromite.ext.snowflake.internal.SnowflakePreferencesInitializer"/>
    </extension>

    <extension point="com.seizia.chromite.dataSourceAuth">
        <authModel
            id="snowflake_snowflake"
            label="Snowflake username/password"
            description="Snowflake internal authentication (name/password)"
            class="com.seizia.chromite.ext.snowflake.model.auth.SnowflakeAuthModelSnowflake"
            default="true">
            <replace model="native"/>
            <datasource id="snowflake"/>
            <datasource id="snowflake_ee"/>
        </authModel>
    </extension>

</plugin>
