<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>

<plugin>

    <extension point="com.seizia.chromite.ui.propertyConfigurator">
        <propertyConfigurator class="com.seizia.chromite.model.net.ssh.SSHTunnelImpl" uiClass="com.seizia.chromite.ui.net.ssh.SSHTunnelConfiguratorUI"/>
    </extension>

    <extension point="org.eclipse.core.runtime.adapters">
        <factory adaptableType="com.seizia.chromite.model.net.ssh.JSCHSessionController" class="com.seizia.chromite.ui.net.ssh.jsch.JSCHUIPromptProviderAdapterFactory">
            <adapter type="com.seizia.chromite.model.net.ssh.JSCHUserInfoPromptProvider"/>
        </factory>
    </extension>

    <extension point="org.eclipse.ui.views">
        <view
            id="com.seizia.chromite.ssh.tunnels"
            category="com.seizia.chromite.core.category"
            class="com.seizia.chromite.ui.net.ssh.SSHTunnelView"
            icon="platform:/plugin/com.seizia.chromite.ui/icons/sql/connect.svg"
            name="SSH tunnel explorer">
            <description>SSH tunnel explorer. Allows to view and manage SSH tunnels.</description>
        </view>
    </extension>

</plugin>
