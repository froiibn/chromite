<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
    <extension point="com.seizia.chromite.sql.editorAddIns">
        <addIn id="com.seizia.chromite.ui.editors.sql.terminal.editorAddIn" class="com.seizia.chromite.ui.editors.sql.terminal.SQLTerminalEditorAddIn"/>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command id="com.seizia.chromite.ui.editors.sql.show.terminalView" name="%command.com.seizia.chromite.ui.editors.sql.show.terminalView.name" description="%command.com.seizia.chromite.ui.editors.sql.show.terminalView.description" categoryId="com.seizia.chromite.core.sql">
            <state class="org.eclipse.jface.commands.ToggleState" id="org.eclipse.ui.commands.toggleState" />
        </command>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <handler commandId="com.seizia.chromite.ui.editors.sql.show.terminalView" class="com.seizia.chromite.ui.editors.sql.terminal.SQLTerminalViewSwitchHandler">
            <enabledWhen><reference definitionId="com.seizia.chromite.core.ui.sql.editor"/></enabledWhen>
        </handler>
    </extension>
    
    <extension point="org.eclipse.ui.menus">
        <menuContribution allPopups="false" locationURI="toolbar:com.seizia.chromite.ui.editors.sql.toolbar.side.top?after=tools" >
            <command commandId="com.seizia.chromite.ui.editors.sql.show.terminalView">
                <visibleWhen checkEnabled="false">
                    <test property="com.seizia.chromite.ui.toolbar.configuration.visible" args="sqlEditor.side.top,com.seizia.chromite.ui.editors.sql.show.terminalView"/>
                </visibleWhen>
            </command>
        </menuContribution>
        <menuContribution allPopups="false" locationURI="popup:com.seizia.chromite.ui.editors.sql.SQLEditor.execute?after=plan">
            <command commandId="com.seizia.chromite.ui.editors.sql.show.terminalView"/>
        </menuContribution >
    </extension>
    
    <extension point="com.seizia.chromite.toolBarConfiguration">
        <toolBar key="sqlEditor.side.top">
            <item commandId="com.seizia.chromite.ui.editors.sql.show.terminalView" defaultVisibility="true"/>
        </toolBar>
    </extension>
    
    <extension point="org.eclipse.ui.commandImages">
    	<image commandId="com.seizia.chromite.ui.editors.sql.show.terminalView" icon="platform:/plugin/com.seizia.chromite.ui/icons/sql/sql_console.svg" />
    </extension>

    <extension point="org.eclipse.core.runtime.preferences">
        <initializer class="com.seizia.chromite.ui.editors.sql.terminal.internal.SQLTerminalPreferencesInitializer"/>
    </extension>

    <extension point="org.eclipse.ui.propertyPages">
        <page category="com.seizia.chromite.preferences.main.sqleditor" class="com.seizia.chromite.ui.editors.sql.terminal.SQLTerminalPreferencesPage" id="com.seizia.chromite.preferences.main.sqleditor.terminalview" name="%terminal_view_item_text">
            <enabledWhen><reference definitionId="com.seizia.chromite.core.preferences.datasource" /></enabledWhen>
        </page>
    </extension>

    <extension point="org.eclipse.ui.preferencePages">
        <page category="com.seizia.chromite.preferences.main.sqleditor" class="com.seizia.chromite.ui.editors.sql.terminal.SQLTerminalPreferencesPage" id="com.seizia.chromite.preferences.main.sql.terminalview" name="%terminal_view_item_text">
            <keywordReference id="com.seizia.chromite.ui.editors.sql.terminal.keyword.pref.terminal"/>
        </page>
    </extension>

    <extension point="org.eclipse.ui.keywords">
        <keyword id="com.seizia.chromite.ui.editors.sql.terminal.keyword.pref.terminal" label="%keyword.com.seizia.chromite.ui.editors.sql.terminal.keyword.pref.terminal.label"/>
    </extension>

</plugin>
