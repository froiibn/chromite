<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

    <extension point="org.eclipse.debug.core.sourceLocators">
        <sourceLocator id="com.seizia.chromite.debug.sourceLocator" class="com.seizia.chromite.debug.sourcelookup.DBGSourceLookupDirector" name="%procedureSourceLocator.name"/>
    </extension>

    <extension point="org.eclipse.debug.core.sourcePathComputers">
        <sourcePathComputer class="com.seizia.chromite.debug.sourcelookup.DBGSourcePathComputer" id="com.seizia.chromite.debug.sourcePathComputer">
        </sourcePathComputer>
    </extension>

    <extension point="org.eclipse.debug.core.sourceContainerTypes">
        <sourceContainerType id="com.seizia.chromite.debug.core.datasourceSourceContainerType" class="com.seizia.chromite.debug.sourcelookup.DatabaseSourceContainerTypeDelegate" name="Databases" description="A collection of databases"/>
    </extension>

    <extension point="org.eclipse.debug.core.launchConfigurationTypes">
        <!-- Setting category="com.seizia.chromite.debug" will show this configuration only in this category and not in general configurations dialog -->
        <launchConfigurationType
                id="com.seizia.chromite.debug.launchConfiguration"
                delegate="com.seizia.chromite.debug.core.DatabaseLaunchDelegate"
                delegateDescription="%launchConfigurationType.chromite.delegateDescription"
                delegateName="%launchConfigurationType.chromite.delegateName"
                modes="run,debug"
                name="%launchConfigurationType.chromite.name"
                sourceLocatorId="com.seizia.chromite.debug.sourceLocator"
                sourcePathComputerId="com.seizia.chromite.debug.sourcePathComputer">
        </launchConfigurationType>
    </extension>

    <!-- Breakpoints -->

    <extension id="databaseBreakpointMarker" name="%databaseBreakpoint.name" point="org.eclipse.core.resources.markers">
        <super type="com.seizia.chromite.runtime.marker.datasourceId"/>
        <super type="org.eclipse.debug.core.breakpointMarker"/>
        <persistent value="true"/>
        <attribute name="com.seizia.chromite.debug.core.procedureOid"/>
    </extension>

    <extension
            id="databaseLineBreakpointMarker"
            name="%databaseLineBreakpoint.name"
            point="org.eclipse.core.resources.markers">
        <super type="org.eclipse.debug.core.lineBreakpointMarker"/>
        <super type="com.seizia.chromite.debug.core.databaseBreakpointMarker"/>
        <persistent
                value="true">
        </persistent>
    </extension>
    <extension point="org.eclipse.debug.core.breakpoints">
        <breakpoint
                class="com.seizia.chromite.debug.core.breakpoints.DatabaseLineBreakpoint"
                id="com.seizia.chromite.debug.core.databaseLineBreakpoint"
                markerType="com.seizia.chromite.debug.core.databaseLineBreakpointMarker"
                name="%databaseLineBreakpoint.name">
        </breakpoint>
    </extension>

</plugin>
