 org.jkiss.dbeaver.ext.mssql,
 org.jkiss.dbeaver.ext.mysql,
 org.jkiss.dbeaver.ext.oracle
Export-Package: com.seizia.chromite.model.admin,
 com.seizia.chromite.model.admin.mssql,
 com.seizia.chromite.model.admin.mysql,
 com.seizia.chromite.model.admin.security
Automatic-Module-Name: com.seizia.chromite.model.admin
