<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>

    <extension-point id="com.seizia.chromite.service" name="Service" schema="schema/com.seizia.chromite.service.exsd"/>
    <extension-point id="com.seizia.chromite.application" name="DBeaver applications" schema="schema/com.seizia.chromite.application.exsd"/>
    <extension-point id="com.seizia.chromite.app.config" name="Application configuration" schema="schema/com.seizia.chromite.app.config.exsd"/>
    <extension-point id="com.seizia.chromite.expressions" name="Expression functions and namespaces" schema="schema/com.seizia.chromite.expressions.exsd"/>
    <extension-point id="com.seizia.chromite.dataHintProvider" name="Data editor hint provider" schema="schema/com.seizia.chromite.dataHintProvider.exsd"/>
    <extension-point id="com.seizia.chromite.dataFormatter" name="Data value formatters" schema="schema/com.seizia.chromite.dataFormatter.exsd"/>
    <extension-point id="com.seizia.chromite.dataTypeProvider" name="DataType provider" schema="schema/com.seizia.chromite.dataTypeProvider.exsd"/>
    <extension-point id="com.seizia.chromite.serialize" name="Object serializers" schema="schema/com.seizia.chromite.serialize.exsd"/>
    <extension-point id="com.seizia.chromite.navigator" name="Object navigator extensions" schema="schema/com.seizia.chromite.navigator.exsd"/>
    <extension-point id="com.seizia.chromite.settings" name="DBeaver Settings" schema="schema/com.seizia.chromite.settings.exsd"/>
    <extension-point id="com.seizia.chromite.syncUnit" name="Synchronization unit" schema="schema/com.seizia.chromite.syncUnit.exsd"/>
    <extension-point id="com.seizia.chromite.fileSystem" name="Virtual file systems" schema="schema/com.seizia.chromite.fileSystem.exsd"/>
    <extension-point id="com.seizia.chromite.fileTypeHandler" name="File type handlers" schema="schema/com.seizia.chromite.fileTypeHandlers.exsd"/>


    <extension point="com.seizia.chromite.expressions">
        <namespace id="math" class="java.lang.Math" description="Math functions"/>
        <namespace id="content" class="com.seizia.chromite.registry.expressions.ContentExpressionFunctions" description="Content handling functions"/>
    </extension>

    <extension point="com.seizia.chromite.dataFormatter">
        <formatter id="number" label="%DateFormatter.number.label" class="com.seizia.chromite.model.impl.data.formatters.NumberDataFormatter" sampleClass="com.seizia.chromite.model.impl.data.formatters.NumberFormatSample">
            <propertyGroup label="%DateFormatter.number.general.label">
                <property id="useGrouping" label="%DateFormatter.number.general.grouping.label" type="boolean" description="%DateFormatter.number.general.grouping.description"/>
                <property id="groupingSize" label="%DateFormatter.number.general.groupingSize.label" type="integer" description="%DateFormatter.number.general.groupingSize.description"/>
                <property id="maxIntegerDigits" label="%DateFormatter.number.general.maxIntDigits.label" type="integer" description="%DateFormatter.number.general.maxIntDigits.description"/>
                <property id="minIntegerDigits" label="%DateFormatter.number.general.minIntDigits.label" type="integer" description="%DateFormatter.number.general.minIntDigits.description"/>
                <property id="maxFractionDigits" label="%DateFormatter.number.general.maxFractDigits.label" type="integer" description="%DateFormatter.number.general.maxFractDigits.description"/>
                <property id="minFractionDigits" label="%DateFormatter.number.general.minFractDigits.label" type="integer" description="%DateFormatter.number.general.minFractDigits.description"/>
                <property id="useTypeScale" label="%DateFormatter.number.general.useTypeScale.label" type="boolean" description="%DateFormatter.number.general.useTypeScale.description"/>
                <property id="roundingMode" label="%DateFormatter.number.general.roundingMode.label" type="string" description="%DateFormatter.number.general.roundingMode.description" validValues="UP,DOWN,CEILING,FLOOR,HALF_UP,HALF_DOWN,HALF_EVEN,UNNECESSARY"/>
                <property id="nativeSpecialValues" label="%DateFormatter.number.general.nativeSpecialValues.label" type="boolean" description="%DateFormatter.number.general.nativeSpecialValues.description"/>
                <property id="scientificSmallValues" label="%DateFormatter.number.general.scientificSmallValues.label" type="boolean" description="%DateFormatter.number.general.scientificSmallValues.description"/>
                <property id="scientificExponentSeparator" label="%DateFormatter.number.general.scientificExponentSeparator.label" type="string" description="%DateFormatter.number.general.scientificExponentSeparator.description" required="true"/>
                <property id="scientificPattern" label="%DateFormatter.number.general.scientificPattern.label" type="string" description="%DateFormatter.number.general.scientificPattern.description" required="true"/>
                <property id="excludeIdColumns" label="%DateFormatter.number.general.excludeIdColumns.label" type="boolean" description="%DateFormatter.number.general.excludeIdColumns.description"/>
            </propertyGroup>
        </formatter>
        <formatter id="timestamp" label="%DateFormatter.timestamp.label" class="com.seizia.chromite.model.impl.data.formatters.DateTimeDataFormatter" sampleClass="com.seizia.chromite.model.impl.data.formatters.TimestampFormatSample">
            <propertyGroup label="%DateFormatter.timestamp.general.label">
                <property id="pattern" label="%DateFormatter.timestamp.general.pattern.label" type="string" description="%DateFormatter.timestamp.general.pattern.description" required="true"/>
                <property id="timezone" label="%DateFormatter.timestamp.general.timezone.label" type="string" description="%DateFormatter.timestamp.general.timezone.description" required="false"/>
            </propertyGroup>
        </formatter>
        <formatter id="timestamptz" label="%DateFormatter.timestamptz.label" class="com.seizia.chromite.model.impl.data.formatters.DateTimeDataFormatter" sampleClass="com.seizia.chromite.model.impl.data.formatters.TimestampTzFormatSample">
            <propertyGroup label="%DateFormatter.timestamp.general.label">
                <property id="pattern" label="%DateFormatter.timestamp.general.pattern.label" type="string" description="%DateFormatter.timestamp.general.pattern.description" required="true"/>
            </propertyGroup>
        </formatter>
        <formatter id="date" label="%DateFormatter.date.label" class="com.seizia.chromite.model.impl.data.formatters.DateTimeDataFormatter" sampleClass="com.seizia.chromite.model.impl.data.formatters.DateFormatSample">
            <propertyGroup label="%DateFormatter.date.general.label">
                <property id="pattern" label="%DateFormatter.date.general.pattern.label" type="string" description="%DateFormatter.date.general.pattern.description" required="true"/>
            </propertyGroup>
        </formatter>
        <formatter id="time" label="%DateFormatter.time.label" class="com.seizia.chromite.model.impl.data.formatters.DateTimeDataFormatter" sampleClass="com.seizia.chromite.model.impl.data.formatters.TimeFormatSample">
            <propertyGroup label="%DateFormatter.time.general.label">
                <property id="pattern" label="%DateFormatter.time.general.pattern.label" type="string" description="%DateFormatter.time.general.pattern.description" required="true"/>
                <property id="timezone" label="%DateFormatter.time.general.timezone.label" type="string" description="%DateFormatter.time.general.timezone.description" required="false"/>
            </propertyGroup>
        </formatter>
        <formatter id="timetz" label="%DateFormatter.timetz.label" class="com.seizia.chromite.model.impl.data.formatters.DateTimeDataFormatter" sampleClass="com.seizia.chromite.model.impl.data.formatters.TimeTzFormatSample">
            <propertyGroup label="%DateFormatter.time.general.label">
                <property id="pattern" label="%DateFormatter.time.general.pattern.label" type="string" description="%DateFormatter.time.general.pattern.description" required="true"/>
            </propertyGroup>
        </formatter>
    </extension>

    <extension point="com.seizia.chromite.dataTypeProvider">
        <!-- Standard transformers (enabled by default) -->
        <transformer
                class="com.seizia.chromite.model.impl.data.transformers.ComplexTypeAttributeTransformer"
                id="com.seizia.chromite.core.ComplexTypeAttributeTransformer"
                name="Complex type"
                description="%ComplexTypeTransformer.general.description"
                applyByDefault="true">
            <type kind="STRUCT"/>
            <type kind="DOCUMENT"/>
            <!--<type kind="OBJECT"/>-->
        </transformer>
        <transformer
                class="com.seizia.chromite.model.impl.data.transformers.MapAttributeTransformer"
                id="com.seizia.chromite.core.MapAttributeTransformer"
                name="Map"
                description="%MapTransformer.general.description"
                applyByDefault="true">
            <type kind="STRUCT"/>
            <type kind="DOCUMENT"/>
            <!--<type kind="OBJECT"/>-->
            <type kind="ANY"/>
        </transformer>
        <transformer
                class="com.seizia.chromite.model.impl.data.transformers.ArrayAttributeTransformer"
                id="com.seizia.chromite.core.ArrayAttributeTransformer"
                name="Array"
                description="%ArrayTransformer.general.description"
                applyByDefault="true">
            <type kind="ARRAY"/>
        </transformer>

        <!-- Extra transformers -->
        <transformer
                class="com.seizia.chromite.model.impl.data.transformers.EpochTimeAttributeTransformer"
                id="com.seizia.chromite.core.EpochTimeAttributeTransformer"
                name="Epoch Time"
                description="%EpochTimeTransformer.general.description"
                applyByDefault="false"
                custom="true">
            <type kind="NUMERIC"/>
            <propertyGroup label="Properties">
                <property id="unit" label="Unit" type="string" description="%EpochTimeTransformer.property.unit.description" defaultValue="milliseconds" required="true" validValues="seconds,milliseconds,microseconds,nanoseconds,dotnet,w32filetime,oadate,sqliteJulian"/>
                <property id="zoneId" label="Timezone ID" type="string" description="%EpochTimeTransformer.property.timezoneID.description"/>
            </propertyGroup>
        </transformer>
        <transformer
                class="com.seizia.chromite.model.impl.data.transformers.RadixAttributeTransformer"
                id="com.seizia.chromite.core.RadixAttributeTransformer"
                name="Number Radix"
                description="%RadixTransformer.general.description"
                applyByDefault="false"
                custom="true">
            <type kind="NUMERIC"/>
            <propertyGroup label="Properties">
                <property id="radix" label="Radix" type="string" description="Number radix" defaultValue="16" required="true" validValues="2,8,10,16,32"/>
                <property id="bits" label="Bits" type="integer" description="Visible least significant bits number (when radix is 2)" defaultValue="32" required="true"/>
                <property id="prefix" label="Show prefix" type="boolean" description="Shows radix prefix (0x for hex)" defaultValue="false" required="true"/>
                <property id="unsigned" label="Unsigned" type="boolean" description="Shows value without sign" defaultValue="false" required="true"/>
            </propertyGroup>
        </transformer>
        <transformer
                class="com.seizia.chromite.model.impl.data.transformers.URLAttributeTransformer"
                id="com.seizia.chromite.core.URLAttributeTransformer"
                name="URL"
                description="%URLTransformer.general.description"
                applyByDefault="false"
                custom="true">
            <type kind="NUMERIC"/>
            <type kind="STRING"/>
            <propertyGroup label="Properties">
                <property id="pattern" label="%URLTransformer.property.pattern.label" type="string" description="%URLTransformer.property.pattern.description" defaultValue="http://${value}" required="false"/>
            </propertyGroup>
        </transformer>
        <transformer
                class="com.seizia.chromite.model.impl.data.transformers.BooleanAttributeTransformer"
                id="boolean"
                name="Boolean"
                description="%BooleanTransformer.general.description"
                applyByDefault="false"
                custom="true">
            <type kind="NUMERIC"/>
        </transformer>
        <transformer
                class="com.seizia.chromite.model.impl.data.transformers.UUIDAttributeTransformer"
                id="com.seizia.chromite.core.UUIDAttributeTransformer"
                name="UUID"
                description="%UUIDTransformer.general.description"
                applyByDefault="false"
                custom="true">
            <type kind="BINARY"/>
            <type kind="CONTENT"/>
            <propertyGroup label="Properties">
                <property id="type" label="%UUIDTransformer.property.type.label" type="string" description="%UUIDTransformer.property.type.description" defaultValue="Version1" required="true" validValues="Version1,Version2,Ordered" allowCustomValues="false"/>
                <property id="case" label="%UUIDTransformer.property.case.label" type="string" description="%UUIDTransformer.property.case.description" defaultValue="Lower case" required="true" validValues="Lower case,Upper case" allowCustomValues="false"/>
            </propertyGroup>
        </transformer>
        <transformer
                class="com.seizia.chromite.model.impl.data.transformers.BinaryAttributeTransformer"
                id="com.seizia.chromite.core.BinaryAttributeTransformer"
                name="Binary"
                description="%BinaryTransformer.general.description"
                applyByDefault="false"
                custom="true">
            <type kind="STRING"/>
            <propertyGroup label="Properties">
                <property id="format" label="%BinaryTransformer.property.format.label" type="string" description="%BinaryTransformer.property.format.description" defaultValue="hex" required="false" validValues="hex,native,base64,string" allowCustomValues="false"/>
                <property id="encoding" label="%BinaryTransformer.property.encoding.label" type="string" description="%BinaryTransformer.property.encoding.description" defaultValue="utf-8" required="false"/>
            </propertyGroup>
        </transformer>
        <transformer
                class="com.seizia.chromite.model.impl.data.transformers.NumericAttributeTransformer"
                id="com.seizia.chromite.core.NumericAttributeTransformer"
                name="Numeric"
                description="Represents string value as number"
                applyByDefault="false"
                custom="true">
            <type kind="STRING"/>
            <propertyGroup label="Properties">
                <property id="type" type="string" label="%NumericTransformer.property.type.label" description="%NumericTransformer.property.type.description" defaultValue="double" required="true" validValues="byte,short,int,long,float,double" allowCustomValues="false"/>
                <property id="lenient" type="boolean" label="%NumericTransformer.property.lenient.label" description="%NumericTransformer.property.lenient.description" defaultValue="false" required="true"/>
            </propertyGroup>
        </transformer>

    </extension>

    <extension point="com.seizia.chromite.dataHintProvider">
        <hintProvider id="attr-keys" for="column" class="com.seizia.chromite.model.data.hints.standard.AttributeKeysHintProvider" label="%hints.attr-keys.label" description="%hints.attr-keys.description"/>
        <hintProvider id="attr-status" for="column" class="com.seizia.chromite.model.data.hints.standard.AttributeStatusHintProvider" label="%hints.attr-status.label" description="%hints.attr-status.description"/>
        <hintProvider id="array-size" for="cell" class="com.seizia.chromite.model.data.hints.standard.ArrayCellHintProvider" label="%hints.array-size.label" description="%hints.array-size.description">
            <supports kind="ARRAY"/>
        </hintProvider>
        <hintProvider id="binary-size" for="cell" class="com.seizia.chromite.model.data.hints.standard.BinaryCellHintProvider" label="Binary data" description="Shows size of binary value">
            <supports kind="BINARY"/>
        </hintProvider>
        <hintProvider id="date-timezone" for="cell" class="com.seizia.chromite.model.data.hints.standard.TimeZoneCellHintProvider" label="%hints.date-timezone.label" description="%hints.date-timezone.description">
            <supports kind="DATETIME"/>
        </hintProvider>
    </extension>

    <extension point="com.seizia.chromite.settings">
        <propertyGroup id="editors" label="Editors">
            <propertyGroup id="dataEditor" label="Data Editor">
                <property id="resultset.maxrows" label="Default fetch size" description="Default number of rows to fetch" type="integer"
                          defaultValue="200"
                          scopes="global,user"/>
            </propertyGroup>
        </propertyGroup>
    </extension>

    <extension point="org.eclipse.core.expressions.propertyTesters">
        <propertyTester
            class="com.seizia.chromite.model.impl.GlobalPropertyTester"
            id="com.seizia.chromite.model.impl.GlobalPropertyTester"
            namespace="com.seizia.chromite.core.global"
            properties="standalone,distributed,bundleInstalled,hasPreference,hasEnvVariable"
            type="java.lang.Object"/>
        <propertyTester
            class="com.seizia.chromite.model.impl.config.ProductConfigPropertyTester"
            id="com.seizia.chromite.app.config"
            namespace="com.seizia.chromite.app.config"
            properties="isFeatureEnabled,isAvailable"
            type="java.lang.Object"/>
    </extension>


</plugin>
