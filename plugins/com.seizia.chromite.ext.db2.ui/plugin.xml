<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>

    <extension point="com.seizia.chromite.dataSourceConfigurator">
        <configurator dataSource="db2" class="com.seizia.chromite.ext.db2.ui.views.DB2ConnectionPage"/>
    </extension>

        <extension point="com.seizia.chromite.databaseEditor">
    
        <editor id="source.declaration" 
                class="com.seizia.chromite.ui.editors.sql.SQLSourceViewer"
                label="%editor.source.declaration.name"
                description="%editor.source.declaration.description"
                icon="#sql_text" 
                position="additions_middle"
                contributor="com.seizia.chromite.ui.editors.sql.SQLEditorContributorNested" 
                type="folder"
                embeddable="false">
            <objectType name="com.seizia.chromite.ext.db2.model.DB2MaterializedQueryTable"/>
            <objectType name="com.seizia.chromite.ext.db2.model.DB2TableCheckConstraint"/>
            <objectType name="com.seizia.chromite.ext.db2.model.DB2Trigger"/>
            <objectType name="com.seizia.chromite.ext.db2.model.DB2View"/>
        </editor>

        <editor id="source.ddl"
                class="com.seizia.chromite.ext.db2.ui.editors.DB2TableDDLEditor"
                label="%editor.source.ddl.name"
                description="%editor.source.ddl.description"
                icon="#sql_text"
                position="additions_middle"
                contributor="com.seizia.chromite.ui.editors.sql.SQLEditorContributorNested"
                type="folder">
            <objectType name="com.seizia.chromite.ext.db2.model.DB2Table"/>
        </editor>
        <editor id="source.routine.ddl" 
                class="com.seizia.chromite.ext.db2.ui.editors.DB2RoutineDDLEditor"
                label="%editor.source.ddl.name" 
                description="%editor.source.ddl.description" 
                icon="#sql_text" 
                position="additions_middle"
                contributor="com.seizia.chromite.ui.editors.sql.SQLEditorContributorNested" 
                type="folder">
           <objectType name="com.seizia.chromite.ext.db2.model.DB2Routine"/>
        </editor>
        
        <configurator class="com.seizia.chromite.ext.db2.ui.config.DB2ForeignKeyConfigurator">
            <objectType name="com.seizia.chromite.ext.db2.model.DB2TableForeignKey"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.db2.ui.config.DB2IndexConfigurator">
            <objectType name="com.seizia.chromite.ext.db2.model.DB2Index"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.db2.ui.config.DB2SchemaConfigurator">
            <objectType name="com.seizia.chromite.ext.db2.model.DB2Schema"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.db2.ui.config.DB2SequenceConfigurator">
            <objectType name="com.seizia.chromite.ext.db2.model.DB2Sequence"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.db2.ui.config.DB2UniqueKeyConfigurator">
            <objectType name="com.seizia.chromite.ext.db2.model.DB2TableUniqueKey"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.db2.ui.config.DB2PlanSchemaConfigurator">
            <objectType name="com.seizia.chromite.ext.db2.model.DB2PlanConfig"/>
        </configurator>

    </extension>

    <extension point="com.seizia.chromite.tools">
        <tools>
            <toolGroup id="com.seizia.chromite.ext.db2.ui.tools.maintenance" label="Statistics"/>
            <tool
                    description="Display SQL Error Message"
                    id="com.seizia.chromite.ext.db2.ui.tools.DB2ToolShowError"
                    label="%tool.com.seizia.chromite.ext.db2.showerror.name"
                    singleton="true">
                <command id="com.seizia.chromite.ext.db2.ui.showError">
                    <objectType name="com.seizia.chromite.ext.db2.model.DB2DataSource"/>
                </command>
            </tool>
            <tool
                    description="Runstats"
                    id="com.seizia.chromite.ext.db2.ui.tools.maintenance.DB2RunstatsTool"
                    group="com.seizia.chromite.ext.db2.ui.tools.maintenance"
                    label="%tool.com.seizia.chromite.ext.db2.table.runstats.name"
                    singleton="false">
                <task id="db2ToolTableRunstats"/>
            </tool>
            <tool
                    description="Reorg table"
                    id="com.seizia.chromite.ext.db2.ui.tools.maintenance.DB2ReorgTableTool"
                    group="com.seizia.chromite.ext.db2.ui.tools.maintenance"
                    label="%tool.com.seizia.chromite.ext.db2.table.reorg.name"
                    singleton="true">
                <command id="com.seizia.chromite.ext.db2.ui.reorgTable">
                    <objectType name="com.seizia.chromite.ext.db2.model.DB2Table"/>
                </command>
            </tool>
            <tool
                    description="Reorg index"
                    id="com.seizia.chromite.ext.db2.ui.tools.maintenance.DB2ReorgIndexTool"
                    group="com.seizia.chromite.ext.db2.ui.tools.maintenance"
                    label="%tool.com.seizia.chromite.ext.db2.table.reorgix.name"
                    singleton="false">
                <task id="db2ToolTableReorgIndex"/>
            </tool>
            <tool
                    description="Reorg check table"
                    id="com.seizia.chromite.ext.db2.ui.tools.maintenance.DB2ReorgCheckTableTool"
                    group="com.seizia.chromite.ext.db2.ui.tools.maintenance"
                    label="%tool.com.seizia.chromite.ext.db2.table.reorgcheck.name"
                    singleton="false">
                <task id="db2ToolTableReorgCheck"/>
            </tool>
            <tool
                    description="Truncate table"
                    id="com.seizia.chromite.ext.db2.ui.tools.maintenance.DB2Truncate"
                    group="com.seizia.chromite.ext.db2.ui.tools.maintenance"
                    label="%tool.com.seizia.chromite.ext.db2.table.truncate.name"
                    singleton="false">
                <task id="db2ToolTableTruncate"/>
            </tool>
        </tools>
    </extension>

    <extension point="org.eclipse.ui.commands">
    	<command id="com.seizia.chromite.ext.db2.ui.reorgTable" name="%tool.com.seizia.chromite.ext.db2.table.reorg.name"/>
        <command id="com.seizia.chromite.ext.db2.ui.showError" name="%tool.com.seizia.chromite.ext.db2.showerror.name"/>
    </extension>
    
    <extension point="org.eclipse.ui.handlers">
        <handler commandId="com.seizia.chromite.ext.db2.ui.reorgTable" class="com.seizia.chromite.ext.db2.ui.tools.maintenance.DB2ReorgTableToolCommandHandler"/>
        <handler commandId="com.seizia.chromite.ext.db2.ui.showError" class="com.seizia.chromite.ext.db2.ui.tools.DB2ShowErrorToolCommandHandler"/>
    </extension>
    
    <extension point="com.seizia.chromite.dataSourceProvider">
        <editorContribution editorId="com.seizia.chromite.ext.db2.ui.editors.DB2ServerApplicationEditor" category="connectionEditor" label="%editor.session_manager.name" icon="platform:/plugin/com.seizia.chromite.model/icons/tree/sessions.svg">
            <supports dataSource="db2"/>
        </editorContribution>
    </extension>
      
    <extension point="org.eclipse.ui.editors">
        <editor
            name="%editor.com.seizia.chromite.ext.db2.ui.editors.DB2ServerApplicationEditor.name"
            icon="platform:/plugin/com.seizia.chromite.ext.db2/icons/compile.png"
            class="com.seizia.chromite.ext.db2.ui.editors.DB2ServerApplicationEditor"
            id="com.seizia.chromite.ext.db2.ui.editors.DB2ServerApplicationEditor"
            contributorClass="com.seizia.chromite.ui.editors.EditorSearchActionsContributor">
        </editor>
    </extension>
                    
</plugin>
