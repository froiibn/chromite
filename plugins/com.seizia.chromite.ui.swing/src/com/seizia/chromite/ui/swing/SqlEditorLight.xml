<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE RSyntaxTheme SYSTEM "theme.dtd">

<!--
	Chromite light SQL editor colors: DataGrip New UI Light (IntelliJ expUI_lightScheme DEFAULT_* attributes),
	values from docs/chromite/design-spec.md "SQL 구문 색". RSyntaxTextArea draws an underline in the token's
	own color, so syntax errors are underlined in the text color (New UI: a red wave).
	Loaded by SqlEditorPanel; see org.fife.ui.rsyntaxtextarea.Theme and theme.dtd for the format.
-->
<RSyntaxTheme version="1.0">

	<!-- No baseFont: SqlEditorPanel sets the look and feel's JetBrains Mono composite font (font.code). -->
	<background color="ffffff"/>
	<caret color="000000"/>
	<selection useFG="false" bg="a6d2ff" roundedEdges="false"/>
	<currentLineHighlight color="f5f8fe" fade="false"/>
	<marginLine fg="ebecf0"/>
	<markAllHighlight color="edebfc"/>
	<markOccurrencesHighlight color="edebfc" border="false"/>
	<matchedBracket fg="080808" bg="93d9d9" highlightBoth="false" animate="false"/>
	<hyperlinks fg="315fbd"/>
	<secondaryLanguages>
		<language index="1" bg="f5f8fe"/>
		<language index="2" bg="f5f8fe"/>
		<language index="3" bg="f5f8fe"/>
	</secondaryLanguages>

	<gutterBackground color="ffffff"/>
	<gutterBorder color="ffffff"/>
	<lineNumbers fg="aeb3c2" currentFG="767a8a"/>
	<foldIndicator fg="aeb3c2" iconBg="ffffff"/>
	<iconRowHeader activeLineRange="aeb3c2"/>

	<tokenStyles>
		<style token="IDENTIFIER" fg="080808"/>
		<style token="RESERVED_WORD" fg="0033b3"/>
		<style token="RESERVED_WORD_2" fg="0033b3"/>
		<style token="ANNOTATION" fg="080808"/>
		<style token="COMMENT_DOCUMENTATION" fg="8c8c8c" italic="true"/>
		<style token="COMMENT_EOL" fg="8c8c8c" italic="true"/>
		<style token="COMMENT_MULTILINE" fg="8c8c8c" italic="true"/>
		<style token="COMMENT_KEYWORD" fg="8c8c8c" italic="true"/>
		<style token="COMMENT_MARKUP" fg="8c8c8c" italic="true"/>
		<style token="DATA_TYPE" fg="0033b3"/>
		<style token="FUNCTION" fg="00627a"/>
		<style token="LITERAL_BOOLEAN" fg="0033b3"/>
		<style token="LITERAL_NUMBER_DECIMAL_INT" fg="1750eb"/>
		<style token="LITERAL_NUMBER_FLOAT" fg="1750eb"/>
		<style token="LITERAL_NUMBER_HEXADECIMAL" fg="1750eb"/>
		<style token="LITERAL_STRING_DOUBLE_QUOTE" fg="067d17"/>
		<style token="LITERAL_CHAR" fg="067d17"/>
		<style token="LITERAL_BACKQUOTE" fg="080808"/>
		<style token="MARKUP_TAG_DELIMITER" fg="080808"/>
		<style token="MARKUP_TAG_NAME" fg="080808"/>
		<style token="MARKUP_TAG_ATTRIBUTE" fg="080808"/>
		<style token="MARKUP_TAG_ATTRIBUTE_VALUE" fg="080808"/>
		<style token="MARKUP_COMMENT" fg="8c8c8c" italic="true"/>
		<style token="MARKUP_DTD" fg="080808"/>
		<style token="MARKUP_PROCESSING_INSTRUCTION" fg="080808"/>
		<style token="MARKUP_CDATA" fg="080808"/>
		<style token="MARKUP_CDATA_DELIMITER" fg="080808"/>
		<style token="OPERATOR" fg="080808"/>
		<style token="PREPROCESSOR" fg="080808"/>
		<style token="REGEX" fg="080808"/>
		<style token="SEPARATOR" fg="080808"/>
		<style token="VARIABLE" fg="871094"/>
		<style token="WHITESPACE" fg="080808"/>
		<style token="ERROR_IDENTIFIER" fg="080808" underline="true"/>
		<style token="ERROR_NUMBER_FORMAT" fg="080808" underline="true"/>
		<style token="ERROR_STRING_DOUBLE" fg="080808" underline="true"/>
		<style token="ERROR_CHAR" fg="080808" underline="true"/>
	</tokenStyles>

</RSyntaxTheme>
