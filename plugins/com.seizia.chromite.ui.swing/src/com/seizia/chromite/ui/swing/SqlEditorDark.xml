<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE RSyntaxTheme SYSTEM "theme.dtd">

<!--
	Chromite dark SQL editor colors. Tokens: the SSMS dark theme matched to a photo of the user's SSMS (no published
	values) with the same categories as the light theme, numbers lime (user decision); values from
	docs/chromite/design-spec.md "SQL 구문 색". Background, gutter and current line are the Islands Dark editor
	island (editor-bg #191A1C, layer-0-bg-inline #212326, design-spec "Islands 적용"). These are the defaults of
	Tools > Options > Editor Colors (EditorColors overrides them with the user's colors). RSyntaxTextArea draws an
	underline in the token's own color, so syntax errors are underlined in the text color.
	Loaded by EditorColors; see org.fife.ui.rsyntaxtextarea.Theme and theme.dtd for the format.
-->
<RSyntaxTheme version="1.0">

	<!-- No baseFont: EditorColors loads the theme with the editor font (EditorFont, a composite font). -->
	<background color="191a1c"/>
	<caret color="ced0d6"/>
	<selection useFG="false" bg="214283" roundedEdges="false"/>
	<currentLineHighlight color="212326" fade="false"/>
	<marginLine fg="393b40"/>
	<markAllHighlight color="373b39"/>
	<markOccurrencesHighlight color="373b39" border="false"/>
	<matchedBracket fg="bcbec4" bg="43454a" highlightBoth="false" animate="false"/>
	<hyperlinks fg="56a8f5"/>
	<secondaryLanguages>
		<language index="1" bg="212326"/>
		<language index="2" bg="212326"/>
		<language index="3" bg="212326"/>
	</secondaryLanguages>

	<gutterBackground color="191a1c"/>
	<gutterBorder color="191a1c"/>
	<!-- Line numbers 4.5:1 or more on the editor background, the current one brighter (app change #55, design-spec "Applied - text contrast") -->
	<lineNumbers fg="808389" currentFG="d1d3d9"/>
	<foldIndicator fg="4b5059" iconBg="191a1c"/>
	<iconRowHeader activeLineRange="4b5059"/>

	<tokenStyles>
		<style token="IDENTIFIER" fg="dcdcdc"/>
		<style token="RESERVED_WORD" fg="569cd6"/>
		<style token="RESERVED_WORD_2" fg="569cd6"/>
		<style token="ANNOTATION" fg="dcdcdc"/>
		<style token="COMMENT_DOCUMENTATION" fg="57a64a" italic="true"/>
		<style token="COMMENT_EOL" fg="57a64a" italic="true"/>
		<style token="COMMENT_MULTILINE" fg="57a64a" italic="true"/>
		<style token="COMMENT_KEYWORD" fg="57a64a" italic="true"/>
		<style token="COMMENT_MARKUP" fg="57a64a" italic="true"/>
		<style token="DATA_TYPE" fg="569cd6"/>
		<style token="FUNCTION" fg="d48cf5"/>
		<style token="LITERAL_BOOLEAN" fg="569cd6"/>
		<style token="LITERAL_NUMBER_DECIMAL_INT" fg="b5e853"/>
		<style token="LITERAL_NUMBER_FLOAT" fg="b5e853"/>
		<style token="LITERAL_NUMBER_HEXADECIMAL" fg="b5e853"/>
		<style token="LITERAL_STRING_DOUBLE_QUOTE" fg="f07068"/>
		<style token="LITERAL_CHAR" fg="f07068"/>
		<style token="LITERAL_BACKQUOTE" fg="dcdcdc"/>
		<style token="MARKUP_TAG_DELIMITER" fg="dcdcdc"/>
		<style token="MARKUP_TAG_NAME" fg="dcdcdc"/>
		<style token="MARKUP_TAG_ATTRIBUTE" fg="dcdcdc"/>
		<style token="MARKUP_TAG_ATTRIBUTE_VALUE" fg="dcdcdc"/>
		<style token="MARKUP_COMMENT" fg="57a64a" italic="true"/>
		<style token="MARKUP_DTD" fg="dcdcdc"/>
		<style token="MARKUP_PROCESSING_INSTRUCTION" fg="dcdcdc"/>
		<style token="MARKUP_CDATA" fg="dcdcdc"/>
		<style token="MARKUP_CDATA_DELIMITER" fg="dcdcdc"/>
		<style token="OPERATOR" fg="b4b4b4"/>
		<style token="PREPROCESSOR" fg="dcdcdc"/>
		<style token="REGEX" fg="dcdcdc"/>
		<style token="SEPARATOR" fg="b4b4b4"/>
		<style token="VARIABLE" fg="dcdcdc"/>
		<style token="WHITESPACE" fg="dcdcdc"/>
		<style token="ERROR_IDENTIFIER" fg="dcdcdc" underline="true"/>
		<style token="ERROR_NUMBER_FORMAT" fg="dcdcdc" underline="true"/>
		<style token="ERROR_STRING_DOUBLE" fg="dcdcdc" underline="true"/>
		<style token="ERROR_CHAR" fg="dcdcdc" underline="true"/>
	</tokenStyles>

</RSyntaxTheme>
