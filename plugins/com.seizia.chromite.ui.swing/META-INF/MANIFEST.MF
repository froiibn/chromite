Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Vendor: Chromite contributors
Bundle-Name: Chromite Swing UI
Bundle-SymbolicName: com.seizia.chromite.ui.swing;singleton:=true
Bundle-Version: 26.2.5.qualifier
Bundle-ActivationPolicy: lazy
Bundle-RequiredExecutionEnvironment: JavaSE-25
Bundle-Activator: com.seizia.chromite.ui.swing.ChromiteSwingActivator
Bundle-ClassPath: .,
 lib/flatlaf.jar,
 lib/flatlaf-fonts-inter.jar,
 lib/flatlaf-fonts-jetbrains-mono.jar,
 lib/rsyntaxtextarea.jar
Require-Bundle: org.eclipse.equinox.app,
 org.eclipse.core.resources,
 org.jkiss.dbeaver.model,
 org.jkiss.dbeaver.model.rcp,
 org.jkiss.dbeaver.model.sql,
 org.jkiss.dbeaver.registry,
 org.jkiss.dbeaver.data.transfer,
 org.jkiss.dbeaver.data.office,
 com.seizia.chromite.model.admin,
 com.github.weisj.jsvg
Require-Capability: osgi.extender;filter:="(osgi.extender=osgi.serviceloader.registrar)"
Provide-Capability: osgi.serviceloader;osgi.serviceloader="com.github.weisj.jsvg.logging.LogManager";register:="com.seizia.chromite.ui.swing.JsvgLogManager"
Automatic-Module-Name: com.seizia.chromite.ui.swing
