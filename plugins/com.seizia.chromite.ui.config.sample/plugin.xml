<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>

    <extension point="com.seizia.chromite.workbenchHandler">
        <workbenchWindowInitializer class="com.seizia.chromite.ui.config.sample.WorkbenchInitializerCreateSampleDatabase" order="3"/>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command id="com.seizia.chromite.ext.sample.database.commands.create" name="%commands.create.name" description="%commands.create.description"/>
    </extension>

    <extension point="org.eclipse.ui.commandImages">
        <image commandId="com.seizia.chromite.ext.sample.database.commands.create" icon="platform:/plugin/com.seizia.chromite.ext.sqlite/icons/sqlite_icon.png"/>
    </extension>

    <extension point="org.eclipse.ui.menus">
        <menuContribution allPopups="false" locationURI="menu:help?after=installation_help">
            <command commandId="com.seizia.chromite.ext.sample.database.commands.create"/>
        </menuContribution>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <handler class="com.seizia.chromite.ui.config.sample.SampleDatabaseHandler" commandId="com.seizia.chromite.ext.sample.database.commands.create"/>
    </extension>

    <extension point="com.seizia.chromite.ui.app.config">
        <action
            label="Create sample database"
            description="Chromite comes with a handy sample database powered by SQLite that you can use to explore the features and capabilities of the application."
            class="com.seizia.chromite.ui.app.config.ProductConfigCreateSampleDatabaseAction"/>
    </extension>

</plugin>
