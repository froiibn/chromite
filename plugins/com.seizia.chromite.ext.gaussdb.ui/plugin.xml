<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>
  <extension point="com.seizia.chromite.dataSourceConfigurator">
    <configurator dataSource="gaussdb" class="com.seizia.chromite.ext.gaussdb.ui.views.GaussDBConnectionPage"/>
  </extension>
  <extension point="com.seizia.chromite.databaseEditor">
    <editor id="postgresql.source.view" class="com.seizia.chromite.ext.gaussdb.ui.editors.GaussDBPackageDeclareViewEditor" label="%db.editor.declare.name" description="%db.editor.source.description" icon="#sql_text" position="additions_middle" contributor="com.seizia.chromite.ui.editors.sql.SQLEditorContributorNested" type="folder" embeddable="false">
      <objectType name="com.seizia.chromite.ext.gaussdb.model.GaussDBPackage"/>
    </editor>
    <editor id="postgresql.source.view" class="com.seizia.chromite.ext.gaussdb.ui.editors.GaussDBPackageBodyViewEditor" label="%db.editor.body.name" description="%db.editor.source.description" icon="#sql_text" position="additions_middle" contributor="com.seizia.chromite.ui.editors.sql.SQLEditorContributorNested" type="folder" embeddable="false">
      <objectType name="com.seizia.chromite.ext.gaussdb.model.GaussDBPackage"/>
    </editor>
    <configurator class="com.seizia.chromite.ext.gaussdb.ui.config.GaussDBDatabaseConfigurator">
      <objectType name="com.seizia.chromite.ext.gaussdb.model.GaussDBDatabase"/>
    </configurator>
    <configurator class="com.seizia.chromite.ext.gaussdb.ui.config.GaussDBPackageConfigurator">
      <objectType name="com.seizia.chromite.ext.gaussdb.model.GaussDBPackage"/>
    </configurator>
    <configurator class="com.seizia.chromite.ext.gaussdb.ui.config.GaussDBProcedureConfigurator">
      <objectType name="com.seizia.chromite.ext.gaussdb.model.GaussDBProcedure"/>
    </configurator>
    <configurator class="com.seizia.chromite.ext.gaussdb.ui.config.GaussDBFunctionConfigurator">
      <objectType name="com.seizia.chromite.ext.gaussdb.model.GaussDBFunction"/>
    </configurator>
  </extension>
</plugin>
