<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>

<plugin>

    <extension point="com.seizia.chromite.dataManager">
        <streamManager class="com.seizia.chromite.ui.data.managers.stream.XMLStreamValueManager" id="xml" label="XML" primaryMime="text/xml"
                       description="XML" icon="platform:/plugin/com.seizia.chromite.model/icons/types/xml.svg"/>
    </extension>

    <extension point="org.eclipse.ui.editors">
        <editor
              class="com.seizia.chromite.ui.editors.xml.XMLEditor"
              default="true"
              extensions="xml"
              icon="platform:/plugin/com.seizia.chromite.model/icons/types/xml.svg"
              id="com.seizia.chromite.ui.editors.xml.XMLEditor"
              name="XML">
            <contentTypeBinding contentTypeId="org.eclipse.core.runtime.xml"/>
        </editor>
    </extension>

    <extension point="org.eclipse.ui.themes">

        <!-- Colors for the XML editor -->
        <themeElementCategory label="%themeElementCategory.com.seizia.chromite.ui.presentation.xml.label" id="com.seizia.chromite.ui.presentation.xml">
            <description>%themeElementCategory.com.seizia.chromite.ui.presentation.xml.description</description>
        </themeElementCategory>

        <colorDefinition
                label="%colorDefinition.com.seizia.chromite.xml.editor.color.tag.label"
                categoryId="com.seizia.chromite.ui.presentation.xml"
                id="com.seizia.chromite.xml.editor.color.tag"
                value="COLOR_BLUE">
            <description>%colorDefinition.com.seizia.chromite.xml.editor.color.tag.description</description>
        </colorDefinition>
        <colorDefinition
                label="%colorDefinition.com.seizia.chromite.xml.editor.color.text.label"
                categoryId="com.seizia.chromite.ui.presentation.xml"
                id="com.seizia.chromite.xml.editor.color.text"
                value="COLOR_BLACK">
            <description>%colorDefinition.com.seizia.chromite.xml.editor.color.text.description</description>
        </colorDefinition>
        <colorDefinition
                label="%colorDefinition.com.seizia.chromite.xml.editor.color.comment.label"
                categoryId="com.seizia.chromite.ui.presentation.xml"
                id="com.seizia.chromite.xml.editor.color.comment"
                value="COLOR_RED">
            <description>%colorDefinition.com.seizia.chromite.xml.editor.color.comment.description</description>
        </colorDefinition>

    </extension>

</plugin>
