<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>

<plugin>
    <extension-point id="desktopRpcService" name="Desktop DataDam RPC service"/>
    <extension-point id="desktopMcpFunction" name="Desktop DataDam MCP function"/>

    <extension point="com.seizia.chromite.model.datadam.desktopMcpFunction">
        <function
            id="listDatasources"
            name="List datasources"
            description="Lists database connections allowed for DataDam MCP calls. requires_manual_connection is an advisory hint that authentication may be needed if a database call fails; calls can still be attempted."
            class="com.seizia.chromite.model.datadam.mcp.function.DDMcpListDatasourcesFunction"/>
    </extension>

    <extension point="com.seizia.chromite.model.datadam.desktopRpcService">
        <service class="com.seizia.chromite.model.datadam.mcp.DDMcpDesktopRpcRegistration"/>
    </extension>

    <extension point="com.seizia.chromite.pluginService">
        <service class="com.seizia.chromite.model.datadam.rpc.DDRemoteDamDesktopSessionPluginService"/>
    </extension>

    <extension point="com.seizia.chromite.ai.engine">
        <completionEngine
            id="datadam" label="DataDam AI"
            class="com.seizia.chromite.model.datadam.ai.DDAIEngine"
            supportsFunctions="true"
            properties="com.seizia.chromite.model.datadam.ai.DDAIEngineProperties"/>
    </extension>
</plugin>
