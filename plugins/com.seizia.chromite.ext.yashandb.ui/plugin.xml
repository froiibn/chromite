<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>

    <extension point="com.seizia.chromite.dataSourceConfigurator">
        <configurator dataSource="yashandb" class="com.seizia.chromite.ext.yashandb.ui.views.YashanDBConnectionPage"/>
    </extension>

    <extension point="org.eclipse.ui.editors">
        <editor
            name="%editor.session_manager.name"
            icon="platform:/plugin/com.seizia.chromite.model/icons/tree/sessions.svg"
            class="com.seizia.chromite.ext.yashandb.ui.editors.YashanDBSessionEditor"
            id="com.seizia.chromite.ext.yashandb.ui.editors.YashanDBSessionEditor"
            contributorClass="com.seizia.chromite.ui.editors.EditorSearchActionsContributor">
        </editor>
    </extension>

    <extension point="com.seizia.chromite.dataSourceProvider">
        <editorContribution editorId="com.seizia.chromite.ext.yashandb.ui.editors.YashanDBSessionEditor" category="connectionEditor" label="%editor.session_manager.name" icon="platform:/plugin/com.seizia.chromite.model/icons/tree/sessions.svg">
            <supports dataSource="yashandb"/>
        </editorContribution>
    </extension>

    <extension point="com.seizia.chromite.databaseEditor">
        <configurator class="com.seizia.chromite.ext.yashandb.ui.config.YashanDBSchemaConfigurator">
            <objectType name="com.seizia.chromite.ext.yashandb.model.YashanDBSchema"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.yashandb.ui.config.YashanDBDataTypeConfigurator">
            <objectType name="com.seizia.chromite.ext.yashandb.model.YashanDBDataType"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.yashandb.ui.config.YashanDBPackageConfigurator">
            <objectType name="com.seizia.chromite.ext.yashandb.model.YashanDBPackage"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.yashandb.ui.config.YashanDBProcedureConfigurator">
            <objectType name="com.seizia.chromite.ext.yashandb.model.YashanDBProcedureStandalone"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.yashandb.ui.config.YashanDBTableTriggerConfigurator">
            <objectType name="com.seizia.chromite.ext.yashandb.model.YashanDBTableTrigger"/>
        </configurator>
    </extension>
</plugin>