<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

    <extension-point id="com.seizia.chromite.debug.ui.configurationPanels" name="DBeaver debug configuration panels" schema="schema/com.seizia.chromite.debug.configurationPanels.exsd"/>

    <extension point="org.eclipse.debug.ui.launchConfigurationTypeImages">
        <launchConfigurationTypeImage
                id="com.seizia.chromite.debug.launchConfigurationTypeImage"
                configTypeID="com.seizia.chromite.debug.launchConfiguration"
                icon="icons/database_debug.png">
        </launchConfigurationTypeImage>
    </extension>

    <extension point="org.eclipse.debug.ui.launchConfigurationTabGroups">
        <launchConfigurationTabGroup
                id="com.seizia.chromite.debug.launchConfigurationTabGroup"
                class="com.seizia.chromite.debug.ui.DatabaseDebugConfigurationTabGroup"
                description="%launchConfigurationTabGroup.description"
                type="com.seizia.chromite.debug.launchConfiguration">
            <launchMode mode="debug" description="%launchConfigurationTabGroup.launchMode.description" /> <!-- perspective="com.seizia.chromite.core.perspective" -->
        </launchConfigurationTabGroup>
    </extension>

    <extension point="org.eclipse.debug.ui.launchGroups">
        <launchGroup
                bannerImage="icons/database_debug.png"
                id="com.seizia.chromite.debug.launchGroup"
                image="icons/database_debug.png"
                label="%launchGroups.launchGroup.label"
                mode="debug"
                title="%launchGroups.launchGroup.title">
        </launchGroup>
    </extension>

    <extension point="org.eclipse.debug.ui.launchShortcuts">
        <shortcut
                id="com.seizia.chromite.debug.ui.shortcut"
                label="%launchShortcuts.shortcut.label"
                description="%launchShortcuts.shortcut.description"
                class="com.seizia.chromite.debug.ui.internal.DatabaseDebugLaunchShortcut"
                icon="icons/database_debug.png"
                modes="debug">
            <configurationType id="com.seizia.chromite.debug.ui.configuration"/>
            <contextualLaunch>
                <contextLabel label="%launchShortcuts.shortcut.label" mode="debug">
                </contextLabel>
                <enablement>
                    <with variable="selection">
                        <count value="1"/>
                        <iterate ifEmpty="false" operator="and">
                            <adapt type="com.seizia.chromite.debug.DBGDebugObject"/>
                        </iterate>
                    </with>
                </enablement>
            </contextualLaunch>
        </shortcut>
    </extension>

    <extension point="org.eclipse.core.runtime.adapters">
        <factory adaptableType="com.seizia.chromite.ui.editors.entity.EntityEditor" class="com.seizia.chromite.debug.ui.actions.DebugActionAdapterFactory">
            <adapter type="org.eclipse.debug.ui.actions.IToggleBreakpointsTarget"/>
        </factory>
        <factory adaptableType="com.seizia.chromite.ui.editors.DatabaseNodeEditorInput" class="com.seizia.chromite.debug.ui.actions.DebugActionAdapterFactory">
            <adapter type="org.eclipse.debug.ui.actions.ILaunchable"/>
        </factory>
        <factory adaptableType="com.seizia.chromite.model.navigator.DBNDatabaseObject" class="com.seizia.chromite.debug.ui.actions.DebugActionAdapterFactory">
            <adapter type="org.eclipse.debug.ui.actions.ILaunchable"/>
        </factory>
    </extension>

    <extension point="org.eclipse.debug.ui.debugModelPresentations">
        <debugModelPresentation class="com.seizia.chromite.debug.ui.DatabaseDebugModelPresentation" id="com.seizia.chromite.debug.core.database"/>
    </extension>

    <extension point="org.eclipse.debug.ui.detailPaneFactories">
        <detailFactories
                class="com.seizia.chromite.debug.ui.details.DatabaseDetailPaneFactory"
                id="com.seizia.chromite.debug.ui.detailPaneFactories.detailFactories.database">
            <enablement>
                <with variable="selection">
                    <count value="1"/>
                    <iterate operator="or">
                        <instanceof value="com.seizia.chromite.debug.core.breakpoints.IDatabaseBreakpoint"/>
                    </iterate>
                    <iterate operator="or"/>
                </with>
            </enablement>
        </detailFactories>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <category description="Database Debug commands" id="com.seizia.chromite.debug.ui.commands.category" name="Database Debug"/>

        <command id="com.seizia.chromite.debug.ui.command.debugConfigurationMenu" name="%commands.command.menuDelegateToolbar.name" description="%commands.command.menuDelegateToolbar.description"/>
    </extension>

    <extension point="org.eclipse.ui.commandImages">
        <image commandId="com.seizia.chromite.debug.ui.command.debugConfigurationMenu" icon="icons/debug_config.png"/>
    </extension>


    <extension point="org.eclipse.ui.handlers">
        <handler commandId="org.eclipse.debug.ui.commands.ToggleBreakpoint" class="com.seizia.chromite.debug.ui.actions.ToggleBreakpointHandler">
            <enabledWhen>
                <!-- Only when there is a breakpoint adapter for current object -->
                <with variable="activePart">
                    <adapt type="com.seizia.chromite.model.struct.DBSObject">
                        <adapt type="com.seizia.chromite.debug.DBGBreakpointDescriptor"/>
                    </adapt>
                </with>
            </enabledWhen>
        </handler>
        <handler commandId="com.seizia.chromite.debug.ui.command.debugConfigurationMenu" class="com.seizia.chromite.debug.ui.actions.OpenDebugConfigurationHandler">
            <enabledWhen>
                <and>
                    <test property="com.seizia.chromite.core.global.ui.hasPermission" value="database-developer"/>
                    <with variable="activePart">
                        <and>
                            <instanceof value="com.seizia.chromite.ui.editors.entity.EntityEditor"/>
                            <test property="com.seizia.chromite.ui.editors.entity.objectType"
                                  value="com.seizia.chromite.ext.postgresql.model.PostgreProcedure"/>
                            <adapt type="com.seizia.chromite.debug.DBGDebugObject"/>
                        </and>
                    </with>
                </and>
            </enabledWhen>
        </handler>
    </extension>

    <extension point="org.eclipse.ui.menus">
        <menuContribution allPopups="false" locationURI="popup:#SQLRulerContext?before=additions">
            <command commandId="org.eclipse.debug.ui.commands.ToggleBreakpoint" label="%command.ToggleBreakpoint.label" style="push">
                <visibleWhen checkEnabled="true"/>
            </command>
        </menuContribution>

        <menuContribution allPopups="false" locationURI="menu:dataSourceMenu?after=tools">
            <separator name="debug" visible="false"/>
            <command commandId="com.seizia.chromite.debug.ui.command.debugConfigurationMenu" id="com.seizia.chromite.debug.ui.menu.pulldown"
                     label="%commands.command.debugConfigurations.name"
                     tooltip="%commands.command.debugConfigurations.description" style="pulldown">
                <visibleWhen checkEnabled="true"/>
            </command>
        </menuContribution>

        <menuContribution allPopups="false" locationURI="toolbar:chromite-tools?after=additions">
            <separator name="debug" visible="false"/>
            <command commandId="com.seizia.chromite.debug.ui.command.debugConfigurationMenu" id="com.seizia.chromite.debug.ui.menu.pulldown"
                     label="%commands.command.debugConfigurations.name"
                     tooltip="%commands.command.debugConfigurations.description" style="pulldown">
                <visibleWhen checkEnabled="true"/>
            </command>
        </menuContribution>

        <menuContribution allPopups="false" locationURI="menu:com.seizia.chromite.debug.ui.menu.pulldown">
            <dynamic id="com.seizia.chromite.debug.ui.menu.configuration" class="com.seizia.chromite.debug.ui.internal.DebugConfigurationMenuContributor"/>
        </menuContribution>

    </extension>


    <!-- DBeaver perspective hook -->
    <extension point="org.eclipse.ui.perspectiveExtensions">
        <!-- Extension to default DBeaver perspectiver -->
        <perspectiveExtension targetID="com.seizia.chromite.core.perspective">
            <!-- Bottom Left -->
            <view
                    closeable="true"
                    standalone="false"
                    moveable="true"
                    visible="false"
                    showTitle="true"
                    relationship="stack"
                    relative="com.seizia.chromite.core.projectExplorer"
                    id="org.eclipse.debug.ui.DebugView"/>
            <view
                    closeable="true"
                    standalone="false"
                    moveable="true"
                    visible="false"
                    showTitle="true"
                    relationship="stack"
                    relative="com.seizia.chromite.core.projectExplorer"
                    id="org.eclipse.debug.ui.BreakpointView"/>

            <!-- Bottom Right -->
            <view
                    closeable="true"
                    standalone="false"
                    moveable="true"
                    visible="false"
                    showTitle="true"
                    relationship="stack"
                    relative="org.eclipse.ui.views.PropertySheet"
                    id="org.eclipse.debug.ui.VariableView"/>

            <!-- Add View Shortcuts !-->
            <viewShortcut id="org.eclipse.debug.ui.DebugView" />
            <viewShortcut id="org.eclipse.debug.ui.VariableView" />
            <viewShortcut id="org.eclipse.debug.ui.BreakpointView" />

        </perspectiveExtension>

    </extension>

    <extension point="com.seizia.chromite.app.config">
        <feature
            id="debug"
            label="Procedure debugger"
            description="Enables debugging of stored procedures and functions in PostgreSQL and its derivatives (Greenplum, TimescaleDB, etc.)"
            enabledByDefault="false"/>
    </extension>

    <extension point="org.eclipse.ui.activities">
        <activity id="chromite.activity.debug" name="Dashboards Activity">
            <enabledWhen>
                <test property="com.seizia.chromite.app.config.isFeatureEnabled" value="debug"/>
            </enabledWhen>
        </activity>

        <activityPatternBinding activityId="chromite.activity.debug" pattern="com\.seizia\.chromite\.debug.*"/>
    </extension>

</plugin>
