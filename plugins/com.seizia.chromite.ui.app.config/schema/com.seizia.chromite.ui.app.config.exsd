         </attribute>
         <attribute name="order" type="int" use="required"/>
         <attribute name="class" type="string" use="required">
            <annotation><appInfo><meta.attribute kind="java" basedOn="com.seizia.chromite.ui.app.config.pages.ProductConfigWizardPage:"/></appInfo></annotation>
         </attribute>
