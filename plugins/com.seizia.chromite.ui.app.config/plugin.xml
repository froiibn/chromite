<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>

   <extension-point id="com.seizia.chromite.ui.app.config" name="Product configuration" schema="schema/com.seizia.chromite.ui.app.config.exsd"/>

    <extension point="com.seizia.chromite.ui.app.config">
       <page id="welcome" order="1000" class="com.seizia.chromite.ui.app.config.pages.ProductConfigWelcomePage"/>
       <page id="appearance" order="2000" class="com.seizia.chromite.ui.app.config.pages.ProductConfigAppearancePage"/>
       <page id="features" order="3000" class="com.seizia.chromite.ui.app.config.pages.ProductConfigFeaturesPage"/>
       <page id="finalSteps" order="5000" class="com.seizia.chromite.ui.app.config.pages.ProductConfigFinalStepsPage"/>
   </extension>

   <extension point="org.eclipse.ui.commands">
      <command
          id="com.seizia.chromite.ui.app.config.showWizard"
          categoryId="com.seizia.chromite.core.util"
          name="Show Product Configuration..."
          description="Show product configuration wizard"/>
   </extension>

   <extension point="org.eclipse.ui.handlers">
      <handler commandId="com.seizia.chromite.ui.app.config.showWizard" class="com.seizia.chromite.ui.app.config.ProductConfigWizardHandler">
         <enabledWhen>
            <test property="com.seizia.chromite.app.config.isAvailable"/>
         </enabledWhen>
      </handler>
   </extension>

   <extension point="org.eclipse.ui.menus">
      <menuContribution allPopups="false" locationURI="menu:help?after=additions">
         <command commandId="com.seizia.chromite.ui.app.config.showWizard">
            <visibleWhen checkEnabled="true"/>
         </command>
      </menuContribution>
   </extension>

</plugin>
