<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>

<plugin>

    <extension point="com.seizia.chromite.dataManager">
        <manager class="com.seizia.chromite.ext.clickhouse.ui.ClickhouseEnumValueManager" id="com.seizia.chromite.ext.clickhouse.ui.ClickhouseEnumValueManager">
            <supports dataSource="clickhouse" typeName="ENUM8*"/>
            <supports dataSource="clickhouse" typeName="ENUM16*"/>
        </manager>
    </extension>
    <extension point="com.seizia.chromite.ui.propertyConfigurator">
        <propertyConfigurator class="com.seizia.chromite.ext.clickhouse.model.ClickhouseSSLImpl" uiClass="com.seizia.chromite.ext.clickhouse.ui.ClickhouseSSLConfigurator"/>
        <propertyConfigurator class="com.seizia.chromite.ext.clickhouse.model.auth.ClickhouseAuthModelCloudSSO" uiClass="com.seizia.chromite.ext.clickhouse.ui.auth.ClickhouseCloudSSOAuthConfigurator"/>
        <propertyConfigurator class="com.seizia.chromite.ext.clickhouse.model.auth.ClickhouseAuthModelOIDC" uiClass="com.seizia.chromite.ext.clickhouse.ui.auth.ClickhouseOIDCAuthConfigurator"/>
    </extension>
</plugin>
