<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>

<plugin>

    <extension point="org.eclipse.core.contenttype.contentTypes">
        <content-type
            base-type="org.eclipse.core.runtime.text"
            file-extensions="json"
            id="com.seizia.chromite.json"
            name="JSON"
            priority="high"/>
    </extension>

    <extension point="com.seizia.chromite.dataManager">
        <streamManager class="com.seizia.chromite.ui.data.managers.stream.JSONStreamValueManager" id="json" label="JSON" primaryMime="text/json"
                       description="JSON" icon="platform:/plugin/com.seizia.chromite.model/icons/types/json.svg"/>
    </extension>

    <extension point="org.eclipse.ui.editors">
        <editor
              class="com.seizia.chromite.ui.editors.json.JSONTextEditor"
              default="true"
              extensions="json"
              icon="platform:/plugin/com.seizia.chromite.model/icons/types/json.svg"
              id="com.seizia.chromite.ui.editors.json.JSONTextEditor"
              name="JSON">
            <contentTypeBinding contentTypeId="com.seizia.chromite.json"/>
        </editor>
    </extension>

</plugin>
