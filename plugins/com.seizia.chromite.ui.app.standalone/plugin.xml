            handler="com.seizia.chromite.ui.app.standalone.cli.SQLTranslatorHandler"/>
        <parameter exitAfterExecute="true"
            hasArg="true"
            handler="com.seizia.chromite.ui.app.standalone.cli.DataBaseInfoHandler"/>
        <parameter exitAfterExecute="true"
            hasArg="true"
            handler="com.seizia.chromite.ui.app.standalone.cli.LinkProjectHandler"/>
        <parameter exitAfterExecute="true"
            hasArg="true"
            handler="com.seizia.chromite.ui.app.standalone.cli.UnlinkProjectHandler"/>
    </extension>

    <!-- Disable Eclipse debug and refactoring in standalone applications -->
    <extension point="org.eclipse.ui.activities">
        <activity id="hideE4Activity" name="%activity.hideE4Activity.name">
            <enabledWhen>
                <with variable="activePartId">
                    <equals value="nonExistentPartId"/>
                </with>
            </enabledWhen>
        </activity>
        <!-- Hide Eclipse userstorage activities -->
        <activityPatternBinding activityId="hideE4Activity" pattern="org.eclipse.userstorage.*"/>
        <!-- Hide E4 view: Welcome, Bookmarks, Palette, Thumbnail -->
        <activityPatternBinding activityId="hideE4Activity" pattern=".*/org.eclipse.ui.internal.introview"/>
        <activityPatternBinding activityId="hideE4Activity" pattern=".*/org.eclipse.gef.ui.palette_view"/>
        <activityPatternBinding activityId="hideE4Activity" pattern=".*/org.eclipse.graphiti.ui.internal.editor.thumbnailview"/>

        <activity id="chromite.app.StandaloneActivity" name="Chromite standalone application activity"/>
        <category id="chromite.app.StandaloneCategory" name="Chromite standalone application activity category"/>

        <!-- put the activity in the category -->
        <categoryActivityBinding activityId="chromite.app.StandaloneActivity" categoryId="chromite.app.StandaloneCategory"/>
        <!-- bind patterns -->
        <activityPatternBinding activityId="chromite.app.StandaloneActivity" pattern="org.eclipse.ltk.ui.refactoring/.*"/>
        <activityPatternBinding activityId="chromite.app.StandaloneActivity" pattern="org.eclipse.ui.ide/org.eclipse.ui.propertypages.resource.filters"/>
        <activityPatternBinding activityId="chromite.app.StandaloneActivity" pattern="org.eclipse.ui.ide/org.eclipse.ui.propertypages.project.reference"/>
        <activityPatternBinding activityId="chromite.app.StandaloneActivity" pattern="org.eclipse.ui.ide/org.eclipse.ui.propertypages.project.natures"/>
        <activityPatternBinding activityId="chromite.app.StandaloneActivity" pattern="org.eclipse.ui.ide/org.eclipse.ui.propertypages.project.linkedResourcesPage"/>
        <activityPatternBinding activityId="chromite.app.StandaloneActivity" pattern="org.eclipse.debug.ui/org.eclipse.debug.ui.properties.defaultLaunchConfigurations"/>
    </extension>

