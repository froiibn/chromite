<?xml version="1.0" encoding="utf-8"?>
<?eclipse version="3.2"?>

<plugin>


    <extension point="org.eclipse.core.runtime.applications" id="standalone" name="%extension.standalone.name">
        <application visible="true">
            <run class="com.seizia.chromite.ui.app.standalone.ChromiteApplication"/>
        </application>
    </extension>

    <extension point="org.eclipse.core.runtime.products" id="product">
        <product application="com.seizia.chromite.ui.app.standalone.standalone" description="%productSubTitle" name="Chromite">
            <property name="aboutText" value="%aboutText"/>
            <property name="copyright" value="© 2026 Chromite contributors. Based on DBeaver Community © DBeaver Corp"/>
            <property name="subTitle" value="%productSubTitle"/>
            <property name="website" value="%productWebsite"/>
            <property name="email" value="%productEmail"/>
            <property name="windowImages" value="/icons/chromite16.png,/icons/chromite32.png,/icons/chromite48.png,/icons/chromite64.png,/icons/chromite256.png"/>
            <property name="appName" value="Chromite"/>
            <property name="appEdition" value="ce"/>
            <property name="versionInfoCoord" value="60,225"/>
            <property name="versionInfoSize" value="8"/>
            <property name="startupMessageRect" value="60,270,270,21"/>
            <property name="startupProgressRect" value="3,291,594,6"/>
            <property name="startupForegroundColor" value="231,231,231"/>
            <property name="cssTheme" value="org.eclipse.e4.ui.css.theme.e4_default"/>
            <property name="applicationCSSResources" value="platform:/plugin/org.eclipse.ui.themes/images/"/>
            <property name="applicationXMI" value="com.seizia.chromite.ui.app.standalone/chromite.e4xmi"/>
            <property name="rendererFactoryUri" value="bundleclass://com.seizia.chromite.core/com.seizia.chromite.ui.e4.ChromiteRendererFactory"/>
            <property name="preferenceCustomization" value="plugin_customization.ini"/>
        </product>
    </extension>

    <extension point="com.seizia.chromite.application">
        <application id="dbeaver-ce"
            family="DB"
            name="%productName"
            description="%productSubTitle"/>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command
            id="com.seizia.chromite.core.util.collectDiagnosticInfo"
            categoryId="com.seizia.chromite.core.util"
            name="%command.com.seizia.chromite.core.util.collectDiagnosticInfo.name"
            description="%command.com.seizia.chromite.core.util.collectDiagnosticInfo.description"/>
        <command
            id="com.seizia.chromite.core.util.resetSettings"
            categoryId="com.seizia.chromite.core.util"
            name="Reset Settings..."
            description="Reset settings and restart"/>
        <command
            id="com.seizia.chromite.core.util.clearHistory"
            categoryId="com.seizia.chromite.core.util"
            name="Clear History..."
            description="Clear logs, query history and restart"/>
        <command
                id="com.seizia.chromite.ext.ui.tipoftheday.showPopup"
                name="%command.com.seizia.chromite.ext.ui.tipoftheday.showPopup.name"
                description="%command.com.seizia.chromite.ext.ui.tipoftheday.showPopup.description"
                categoryId="com.seizia.chromite.core.navigator"/>
        <command
                id="com.seizia.chromite.ui.window.minimize"
                name="Minimize Window"
                description="Minimize the current window"
                categoryId="org.eclipse.ui.category.window"/>
        <command
                id="com.seizia.chromite.ui.versionUpdate"
                name="%command.com.seizia.chromite.ui.versionUpdate.name"
                description="%command.com.seizia.chromite.ui.versionUpdate.description"/>
        <command
                id="com.seizia.chromite.ui.versionUpdate.releaseNotes"
                name="%command.com.seizia.chromite.ui.versionUpdate.releaseNotes.name"/>
    </extension>

    <extension point="org.eclipse.ui.commandImages">
        <image commandId="org.eclipse.ui.edit.text.openLocalFile" icon="platform:/plugin/com.seizia.chromite.ui/icons/file/open.png"/>
        <image commandId="org.eclipse.ui.file.save" icon="platform:/plugin/com.seizia.chromite.ui/icons/file/save.svg"/>
        <image commandId="org.eclipse.ui.file.saveAs" icon="platform:/plugin/com.seizia.chromite.ui/icons/file/save_as.svg"/>
        <image commandId="org.eclipse.ui.file.saveAll" icon="platform:/plugin/com.seizia.chromite.ui/icons/file/saveall.svg"/>
        <image commandId="org.eclipse.ui.file.print" icon="platform:/plugin/com.seizia.chromite.ui/icons/misc/print.svg"/>
        <image commandId="org.eclipse.ui.file.refresh" icon="platform:/plugin/com.seizia.chromite.ui/icons/refresh.svg"/>
        <image commandId="org.eclipse.ui.file.revert" icon="icons/eclipse/revert.png" disabledIcon="icons/eclipse/revert_d.png"/>
        <image commandId="org.eclipse.ui.file.import" icon="platform:/plugin/com.seizia.chromite.ui/icons/file/import.svg"/>
        <image commandId="org.eclipse.ui.file.export" icon="platform:/plugin/com.seizia.chromite.ui/icons/file/export.svg"/>
        <image commandId="org.eclipse.ui.file.properties" icon="platform:/plugin/com.seizia.chromite.ui/icons/configuration.svg"/>
        <image commandId="org.eclipse.ui.edit.delete" icon="platform:/plugin/com.seizia.chromite.ui/icons/delete.svg"/>
        <image commandId="org.eclipse.ui.edit.rename" icon="platform:/plugin/com.seizia.chromite.ui/icons/rename.svg"/>
        <image commandId="org.eclipse.ui.edit.copy" icon="icons/eclipse/copy.svg"/>
        <image commandId="org.eclipse.ui.edit.cut" icon="icons/eclipse/cut.svg"/>
        <image commandId="org.eclipse.ui.edit.paste" icon="icons/eclipse/paste.svg"/>
        <image commandId="org.eclipse.ui.edit.undo" icon="icons/eclipse/undo.svg"/>
        <image commandId="org.eclipse.ui.edit.redo" icon="icons/eclipse/redo.svg"/>

        <image commandId="org.eclipse.ui.newWizard" icon="icons/eclipse/new_object.png" disabledIcon="icons/eclipse/new_object_d.png"/>
        <image commandId="org.eclipse.ui.edit.text.zoomIn" icon="platform:/plugin/com.seizia.chromite.ui/icons/misc/zoom_in.svg"/>
        <image commandId="org.eclipse.ui.edit.text.zoomOut" icon="platform:/plugin/com.seizia.chromite.ui/icons/misc/zoom_out.svg"/>
        <image commandId="org.eclipse.ui.edit.text.gotoLastEditPosition" icon="platform:/plugin/com.seizia.chromite.ui/icons/misc/edit_location_previous.svg"/>
        <image commandId="org.eclipse.ui.edit.text.gotoNextEditPosition" icon="platform:/plugin/com.seizia.chromite.ui/icons/misc/edit_location_next.svg"/>
        <image commandId="org.eclipse.ui.edit.text.toggleBlockSelectionMode" icon="platform:/plugin/com.seizia.chromite.ui/icons/misc/block_selection.svg"/>
        <image commandId="org.eclipse.equinox.p2.ui.sdk.update" icon="platform:/plugin/com.seizia.chromite.ui/icons/misc/software_update.svg"/>
        <image commandId="org.eclipse.equinox.p2.ui.sdk.install" icon="platform:/plugin/com.seizia.chromite.ui/icons/misc/software_install.svg"/>
        <image commandId="org.eclipse.search.ui.openSearchDialog" icon="platform:/plugin/com.seizia.chromite.ui/icons/misc/search.svg"/>

        <image commandId="org.eclipse.ui.navigate.collapseAll" icon="platform:/plugin/com.seizia.chromite.ui/icons/misc/collapse_all.svg"/>
        <image commandId="org.eclipse.ui.navigate.expandAll" icon="platform:/plugin/com.seizia.chromite.ui/icons/misc/expand_all.svg"/>

        <image commandId="org.eclipse.text.quicksearch.commands.quicksearchCommand" icon="icons/eclipse/quick_search.svg" disabledIcon="icons/eclipse/quick_search_d.png"/>
        <image commandId="org.eclipse.ui.edit.findReplace" icon="platform:/plugin/com.seizia.chromite.ui/icons/misc/find_and_replace.svg"/>
    </extension>

    <extension point="org.eclipse.ui.views">
        <view id="org.eclipse.ui.views.ProgressView"
            icon="icons/progress_view.svg"
            category="org.eclipse.ui"
            class="org.eclipse.ui.ExtensionFactory:progressView"
            name="%view.progress.title"/>
        <view id="org.eclipse.ui.texteditor.TemplatesView"
            name="%view.templates.title"
            icon="icons/templates_view.svg"
            category="org.eclipse.ui"
            class="org.eclipse.ui.texteditor.templates.TemplatesView"/>
        <view
            name="%view.errorLog.name"
            icon="platform:/plugin/com.seizia.chromite.model/icons/status/error_small.svg"
            category="org.eclipse.ui"
            class="org.eclipse.ui.internal.views.log.LogView"
            id="org.eclipse.pde.runtime.LogView">
        </view>
        <view
            allowMultiple="true"
            category="org.eclipse.ui"
            class="org.eclipse.ui.views.properties.PropertySheet"
            icon="icons/properties_view.svg"
            id="org.eclipse.ui.views.PropertySheet"
            name="%view.properties.title">
        </view>
        <view
            name="%view.search.title"
            icon="platform:/plugin/com.seizia.chromite.ui/icons/misc/search.svg"
            category="org.eclipse.ui"
            class="org.eclipse.search2.internal.ui.SearchView"
            allowMultiple="true"
            id="org.eclipse.search.ui.views.SearchView">
        </view>
        <!--view
                id="org.eclipse.help.ui.HelpView"
                category="com.seizia.chromite.core.category"
                class="com.seizia.chromite.ui.help.LightweightHelpView"
                allowMultiple="false"
                icon="icons/help.png"
                name="Help"/-->
        <view
            name="%view.outline.title"
            icon="platform:/plugin/com.seizia.chromite.ui/icons/sql/toggle_outline.svg"
            category="org.eclipse.ui"
            class="org.eclipse.ui.views.contentoutline.ContentOutline"
            id="org.eclipse.ui.views.ContentOutline">
        </view>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <handler commandId="org.eclipse.ui.help.aboutAction" class="com.seizia.chromite.ui.app.standalone.about.AboutBoxHandler">
            <activeWhen>
                <with variable="selection">
                    <test property="com.seizia.chromite.core.global.standalone"/>
                </with>
            </activeWhen>
        </handler>
        <handler commandId="org.eclipse.ui.edit.text.openLocalFile" class="com.seizia.chromite.ui.app.standalone.actions.OpenLocalFileActionExt"/>
        <handler
            commandId="com.seizia.chromite.core.util.collectDiagnosticInfo"
            class="com.seizia.chromite.ui.app.standalone.actions.CollectDiagnosticInfoHandler"
        />
        <handler commandId="com.seizia.chromite.core.util.resetSettings" class="com.seizia.chromite.ui.app.standalone.actions.ResetSettingsHandler"/>
        <handler commandId="com.seizia.chromite.core.util.clearHistory" class="com.seizia.chromite.ui.app.standalone.actions.ClearHistoryHandler"/>
        <handler commandId="com.seizia.chromite.ext.ui.tipoftheday.showPopup" class="com.seizia.chromite.ui.app.standalone.tipoftheday.ShowTipOfTheDayHandler"/>
        <handler commandId="com.seizia.chromite.ui.window.minimize" class="com.seizia.chromite.ui.app.standalone.actions.MinimizeWindowHandler"/>
        <handler commandId="com.seizia.chromite.ui.versionUpdate" class="com.seizia.chromite.ui.app.standalone.update.VersionUpdateHandler"/>
        <handler commandId="com.seizia.chromite.ui.versionUpdate.releaseNotes" class="com.seizia.chromite.ui.app.standalone.update.VersionUpdateHandler"/>
    </extension>

    <extension point="org.eclipse.ui.menus">
        <!-- Edit menu -->
        <menuContribution allPopups="false" locationURI="menu:edit">
            <separator name="undoredo" visible="true"/>
            <command commandId="org.eclipse.ui.edit.undo"/>
            <command commandId="org.eclipse.ui.edit.redo"/>
            <command commandId="org.eclipse.ui.edit.cut"/>
            <command commandId="org.eclipse.ui.edit.copy"/>
            <command commandId="com.seizia.chromite.core.edit.copy.special">
                <visibleWhen checkEnabled="true"/>
            </command>
            <command commandId="org.eclipse.ui.edit.paste"/>
            <dynamic
                id="org.eclipse.ui.edit.delete"
                class="com.seizia.chromite.ui.DynamicCommandContribution:org.eclipse.ui.edit.delete"
            />
            <command commandId="org.eclipse.ui.edit.selectAll"/>
            <separator name="find.ext" visible="true"/>
            <command commandId="org.eclipse.ui.edit.findReplace">
                <visibleWhen checkEnabled="true"/>
            </command>
            <command commandId="com.seizia.chromite.core.navigator.bookmark.add">
                <visibleWhen checkEnabled="true"/>
            </command>
            <separator name="additions" visible="true"/>
            <separator name="format" visible="true"/>
                <menu id="format" label="%menu.format">
                    <command commandId="com.seizia.chromite.ui.editors.sql.comment.single">
                        <visibleWhen checkEnabled="true"/>
                    </command>
                    <command commandId="com.seizia.chromite.ui.editors.sql.comment.multi">
                        <visibleWhen checkEnabled="true"/>
                    </command>
                    <command commandId="com.seizia.chromite.ui.editors.sql.word.wrap">
                        <visibleWhen checkEnabled="true"/>
                    </command>
                    <command commandId="com.seizia.chromite.ui.editors.sql.morph.delimited.list">
                        <visibleWhen checkEnabled="true"/>
                    </command>
                    <command commandId="org.eclipse.ui.edit.text.upperCase">
                        <visibleWhen checkEnabled="true"/>
                    </command>
                    <command commandId="org.eclipse.ui.edit.text.lowerCase">
                        <visibleWhen checkEnabled="true"/>
                    </command>
                    <command commandId="com.seizia.chromite.ui.editors.sql.trim.spaces">
                        <visibleWhen checkEnabled="true"/>
                    </command>
                    <command commandId="com.seizia.chromite.ui.editors.sql.trim.leading.spaces">
                        <visibleWhen checkEnabled="true"/>
                    </command>
                    <command commandId="com.seizia.chromite.ui.editors.sql.trim.trailing.spaces">
                        <visibleWhen checkEnabled="true"/>
                    </command>
                </menu>
            <separator name="transforms" visible="true"/>
            <separator name="data" visible="true"/>
        </menuContribution>

        <!-- File menu-->

        <menuContribution allPopups="false" locationURI="menu:file?before=additions">
            <command commandId="org.eclipse.ui.newWizard"/>
            <command commandId="org.eclipse.ui.file.save"/>
            <command commandId="org.eclipse.ui.file.saveAs"/>
            <command commandId="org.eclipse.ui.file.saveAll"/>
            <command commandId="org.eclipse.ui.file.close"/>
            <command commandId="org.eclipse.ui.file.print"/>
            <command commandId="org.eclipse.ui.edit.rename"/>
            <command commandId="org.eclipse.ui.file.refresh"/>

            <separator name="import-export" visible="true"/>
            <command commandId="org.eclipse.ui.file.import">
                <visibleWhen>
                    <reference definitionId="LocalWorkspace"/>
                </visibleWhen>
            </command>
            <command commandId="org.eclipse.ui.file.export">
                <visibleWhen>
                    <reference definitionId="LocalWorkspace"/>
                </visibleWhen>
            </command>

            <separator name="properties" visible="true"/>
            <command commandId="org.eclipse.ui.file.properties"/>
        </menuContribution>
        <menuContribution allPopups="false" locationURI="menu:file?after=additions">
            <separator name="exit" visible="true"/>
            <command commandId="org.eclipse.ui.file.exit"/>
        </menuContribution>

        <!-- Navigation menu -->

        <menuContribution allPopups="false" locationURI="menu:org.eclipse.ui.main.menu?after=additions">
          <menu id="navigate" label="%menu.navigate">
            <command commandId="org.eclipse.ui.navigate.openResource"/>
            <separator name="nav" visible="true"/>
            <command commandId="org.eclipse.ui.navigate.backwardHistory"/>
            <command commandId="org.eclipse.ui.navigate.forwardHistory"/>
          </menu>
        </menuContribution>

        <!-- Window menu -->

        <menuContribution allPopups="false" locationURI="menu:window?before=perspective">
            <separator name="perspective" visible="true"/>
            <command commandId="org.eclipse.ui.window.customizePerspective"/>
            <command commandId="org.eclipse.ui.window.resetPerspective"/>
            <separator name="tabs" visible="true"/>
            <menu label="%command.com.seizia.chromite.core.window.navigation.name">
                <command commandId="org.eclipse.ui.navigate.nextTab"/>
                <command commandId="org.eclipse.ui.navigate.previousTab"/>
                <command commandId="org.eclipse.ui.navigate.nextSubTab"/>
                <command commandId="org.eclipse.ui.navigate.previousSubTab"/>
                <separator name="editors" visible="true"/>
                <command commandId="org.eclipse.ui.window.nextEditor"/>
                <command commandId="org.eclipse.ui.window.previousEditor"/>
                <command commandId="org.eclipse.ui.window.switchToEditor"/>
            </menu>
            <separator name="settings" visible="true"/>
            <command commandId="org.eclipse.ui.window.preferences"/>
        </menuContribution>

        <!-- Help menu -->

        <menuContribution allPopups="false" locationURI="menu:help">
            <separator name="misc" visible="true"/>
            <command commandId="com.seizia.chromite.core.util.collectDiagnosticInfo" style="push"/>
            <command commandId="com.seizia.chromite.core.util.resetSettings" style="push"/>
            <command commandId="com.seizia.chromite.core.util.clearHistory" style="push"/>
            <separator name="misc_end" visible="true"/>
        </menuContribution>

        <!-- Edit menu -->
        <menuContribution allPopups="false" locationURI="menu:help?after=additions">
            <command commandId="com.seizia.chromite.ext.ui.tipoftheday.showPopup" label="%command.com.seizia.chromite.ext.ui.tipoftheday.showPopup.name"/>
        </menuContribution>

        <!-- Main toolbar -->

        <menuContribution allPopups="false" locationURI="toolbar:org.eclipse.ui.main.toolbar?after=additions">
        </menuContribution>
        <menuContribution allPopups="false" locationURI="toolbar:org.eclipse.ui.trim.command2">
            <toolbar label="%toolbar.versionUpdate.label" id="chromite-version-update">
                <command
                        commandId="com.seizia.chromite.ui.versionUpdate"
                        icon="platform:/plugin/com.seizia.chromite.ui/icons/misc/download.svg"
                        id="com.seizia.chromite.ui.versionUpdate.menu"
                        mode="FORCE_TEXT"
                        style="pulldown">
                    <visibleWhen>
                        <test
                                forcePluginActivation="true"
                                property="com.seizia.chromite.ui.versionUpdate.available"/>
                    </visibleWhen>
                </command>
            </toolbar>
        </menuContribution>
        <menuContribution allPopups="false" locationURI="menu:com.seizia.chromite.ui.versionUpdate.menu">
            <command commandId="com.seizia.chromite.ui.versionUpdate.releaseNotes"/>
        </menuContribution>
    </extension>

    <!-- Keybindings. A bit different than standard -->

    <extension point="org.eclipse.ui.bindings">
        <scheme description="%productName" id="com.seizia.chromite.defaultKeyScheme" name="%productName" parentId="org.eclipse.ui.defaultAcceleratorConfiguration"/>

        <!-- Text editors -->
        <key commandId="org.eclipse.ui.edit.text.openLocalFile" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration" sequence="CTRL+O"/>

        <!-- Text editors -->
        <key commandId="org.eclipse.ui.edit.text.contentAssist.proposals" contextId="com.seizia.chromite.ui.editors.sql" schemeId="com.seizia.chromite.defaultKeyScheme" sequence="CTRL+SPACE"/>
        <key commandId="org.eclipse.ui.edit.text.hippieCompletion" contextId="com.seizia.chromite.ui.editors.sql" schemeId="com.seizia.chromite.defaultKeyScheme" sequence="CTRL+SHIFT+SPACE"/>
        <key commandId="org.eclipse.ui.edit.text.contentAssist.contextInformation" contextId="com.seizia.chromite.ui.editors.sql" schemeId="com.seizia.chromite.defaultKeyScheme" sequence="CTRL+ALT+SPACE"/>
        <key commandId="org.eclipse.jdt.ui.edit.text.java.correction.assist.proposals" contextId="com.seizia.chromite.ui.editors.sql" schemeId="com.seizia.chromite.defaultKeyScheme" sequence="CTRL+1"/>

        <!--<key commandId="org.eclipse.ui.edit.text.gotoLastEditPosition" contextId="org.eclipse.ui.contexts.window" schemeId="com.seizia.chromite.defaultKeyScheme" sequence="CTRL+SHIFT+BS"/>-->
        <key commandId="org.eclipse.ui.edit.text.moveLineDown" contextId="com.seizia.chromite.ui.editors.sql" schemeId="com.seizia.chromite.defaultKeyScheme" sequence="CTRL+SHIFT+ARROW_DOWN"/>
        <key commandId="org.eclipse.ui.edit.text.moveLineUp" contextId="com.seizia.chromite.ui.editors.sql" schemeId="com.seizia.chromite.defaultKeyScheme" sequence="CTRL+SHIFT+ARROW_UP"/>
        <!--<key commandId="org.eclipse.ui.edit.text.delete.line" contextId="org.eclipse.ui.contexts.window" schemeId="com.seizia.chromite.defaultKeyScheme" sequence="CTRL+Y"/>-->
        <key commandId="org.eclipse.ui.edit.text.join.lines" contextId="com.seizia.chromite.ui.editors.sql" schemeId="com.seizia.chromite.defaultKeyScheme" sequence="CTRL+SHIFT+J"/>
        <key commandId="org.eclipse.ui.help.dynamicHelp" contextId="org.eclipse.ui.contexts.window" schemeId="com.seizia.chromite.defaultKeyScheme" sequence="F1"/>

        <key commandId="org.eclipse.text.quicksearch.commands.quicksearchCommand" contextId="org.eclipse.ui.contexts.window" sequence="CTRL+ALT+SHIFT+F" schemeId="com.seizia.chromite.defaultKeyScheme"/>
        
        <!-- Minimize window on macOS -->
        <key commandId="com.seizia.chromite.ui.window.minimize" contextId="org.eclipse.ui.contexts.window" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration" platform="cocoa" sequence="COMMAND+M"/>
    </extension>

    <extension point="org.eclipse.ui.bindings">
        <scheme id="com.seizia.chromite.keyboardOnlyKeyScheme" parentId="com.seizia.chromite.defaultKeyScheme" name="%keyboardOnlyKeyScheme.name" description="%keyboardOnlyKeyScheme.description"/>
    </extension>

    <extension point="org.eclipse.ui.preferencePages">
        <page id="com.seizia.chromite.preferences.general" class="com.seizia.chromite.ui.preferences.PrefPageGeneral" name="%pref.page.name.general">
            <keywordReference id="com.seizia.chromite.core.keyword.pref.db.general"/>
            <keywordReference id="com.seizia.chromite.core.keyword.chromite"/>
        </page>
        <page id="com.seizia.chromite.preferences.main" class="com.seizia.chromite.ui.preferences.PrefPageDatabaseUserInterface" name="%pref.page.name.db.configuration">
            <keywordReference id="com.seizia.chromite.core.keyword.pref.db.user.interface"/>
            <keywordReference id="com.seizia.chromite.core.keyword.chromite"/>
            <keywordReference id="com.seizia.chromite.core.keyword.user.interface"/>
        </page>
        <page category="com.seizia.chromite.preferences.main.connections" id="com.seizia.chromite.preferences.main.errorHandle" class="com.seizia.chromite.ui.preferences.PrefPageErrorHandle" name="%pref.page.name.errorHandle">
            <keywordReference id="com.seizia.chromite.core.keyword.chromite"/>
            <keywordReference id="com.seizia.chromite.ui.editors.connection.keyword.pref.errors"/>
        </page>
        <page category="org.eclipse.ui.preferencePages.Workbench" id="com.seizia.chromite.preferences.main.errorLogs" class="com.seizia.chromite.ui.preferences.PrefPageErrorLogs" name="%pref.page.name.errorLogs">
            <keywordReference id="com.seizia.chromite.core.keyword.chromite"/>
            <keywordReference id="com.seizia.chromite.core.keyword.pref.error.logs"/>
        </page>
        <page id="com.seizia.chromite.preferences.main.connections" class="com.seizia.chromite.ui.preferences.PrefPageConnectionsGeneral" name="%pref.page.name.connections">
            <keywordReference id="com.seizia.chromite.core.keyword.connection"/>
            <keywordReference id="com.seizia.chromite.core.keyword.database.connection"/>
            <keywordReference id="com.seizia.chromite.core.keyword.chromite"/>
        </page>
        <page category="com.seizia.chromite.preferences.main.connections" id="com.seizia.chromite.preferences.client.connections" class="com.seizia.chromite.ui.preferences.PrefPageConnectionClient" name="%pref.page.name.client.connections">
            <keywordReference id="com.seizia.chromite.core.keyword.connection"/>
            <keywordReference id="com.seizia.chromite.ui.editors.connection.keyword.pref.client"/>
        </page>
        <page category="com.seizia.chromite.preferences.main.connections" id="com.seizia.chromite.preferences.main.transactions" class="com.seizia.chromite.ui.preferences.PrefPageTransactions" name="%pref.page.name.transactions">
            <keywordReference id="com.seizia.chromite.core.keyword.connection"/>
            <keywordReference id="com.seizia.chromite.core.keyword.chromite"/>
            <keywordReference id="com.seizia.chromite.ui.editors.connection.keyword.pref.transactions"/>
        </page>
        <page category="com.seizia.chromite.preferences.main.connections" id="com.seizia.chromite.preferences.main.meta" class="com.seizia.chromite.ui.preferences.PrefPageMetaData" name="%pref.page.name.meta">
            <keywordReference id="com.seizia.chromite.core.keyword.pref.main.meta"/>
