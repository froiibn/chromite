<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>

<plugin>
    <extension-point id="com.seizia.chromite.ws.event.handler" name="WebSocket event handler"
                     schema="schema/com.seizia.chromite.ws.event.handler.exsd"/>
    <extension-point id="com.seizia.chromite.ws.event" name="WebSocket event"
                     schema="schema/com.seizia.chromite.ws.event.exsd"/>

    <extension point="com.seizia.chromite.ws.event">
        <event topicId="cb_user" id="cb_close_user_sessions" class="com.seizia.chromite.model.websocket.event.WSUserCloseSessionsEvent"/>
        <event topicId="cb_config" id="cb_config_changed"
               class="com.seizia.chromite.model.websocket.event.WSServerConfigurationChangedEvent"/>
        <event topicId="cb_server_state" id="cb_server_state_updated" class="com.seizia.chromite.model.websocket.event.WSServerStateEvent"/>
        <event topicId="cb_session_log" id="cb_session_log_updated"
               class="com.seizia.chromite.model.websocket.event.WSSessionLogUpdatedEvent"/>
        <event topicId="cb_session" id="cb_session_websocket_connected"
               class="com.seizia.chromite.model.websocket.event.session.WSSocketConnectedEvent"/>

        <event topicId="cb_session_auth" id="cb_session_auth"
               class="com.seizia.chromite.model.websocket.event.session.WSAuthEvent"/>

        <event topicId="cb_session" id="cb_session_state" class="com.seizia.chromite.model.websocket.event.session.WSSessionStateEvent"/>
        <event topicId="cb_session" id="cb_session_expired" class="com.seizia.chromite.model.websocket.event.session.WSSessionExpiredEvent"/>
        <event topicId="cb_session" id="cb_access_token_expired"
               class="com.seizia.chromite.model.websocket.event.session.WSAccessTokenExpiredEvent"/>

        <event topicId="cb_profiles" id="cb_network_profile_updated"
               class="com.seizia.chromite.model.websocket.event.datasource.WSNetworkProfileEvent"/>

        <event topicId="cb_datasource" id="cb_datasource_created"
               class="com.seizia.chromite.model.websocket.event.datasource.WSDataSourceEvent"/>
        <event topicId="cb_datasource" id="cb_datasource_updated"
               class="com.seizia.chromite.model.websocket.event.datasource.WSDataSourceEvent"/>
        <event topicId="cb_datasource" id="cb_datasource_deleted"
               class="com.seizia.chromite.model.websocket.event.datasource.WSDataSourceEvent"/>

        <event topicId="cb_datasource_folder" id="cb_datasource_folder_created"
               class="com.seizia.chromite.model.websocket.event.datasource.WSDatasourceFolderEvent"/>
        <event topicId="cb_datasource_folder" id="cb_datasource_folder_updated"
               class="com.seizia.chromite.model.websocket.event.datasource.WSDatasourceFolderEvent"/>
        <event topicId="cb_datasource_folder" id="cb_datasource_folder_deleted"
               class="com.seizia.chromite.model.websocket.event.datasource.WSDatasourceFolderEvent"/>

        <event topicId="cb_datasource_connection" id="cb_datasource_disconnected"
               class="com.seizia.chromite.model.websocket.event.datasource.WSDataSourceDisconnectEvent"/>
        <event topicId="cb_datasource_connection" id="cb_datasource_connected"
               class="com.seizia.chromite.model.websocket.event.datasource.WSDataSourceConnectEvent"/>

        <event topicId="cb_object_permissions" id="cb_object_permissions_updated"
               class="com.seizia.chromite.model.websocket.event.permissions.WSObjectPermissionEvent"/>
        <event topicId="cb_object_permissions" id="cb_object_permissions_deleted"
               class="com.seizia.chromite.model.websocket.event.permissions.WSObjectPermissionEvent"/>

        <event topicId="cb_subject_permissions" id="cb_subject_permissions_updated"
               class="com.seizia.chromite.model.websocket.event.permissions.WSSubjectPermissionEvent"/>

        <event topicId="cb_scripts" id="cb_rm_resource_created"
               class="com.seizia.chromite.model.websocket.event.resource.WSResourceUpdatedEvent"/>
        <event topicId="cb_scripts" id="cb_rm_resource_updated"
               class="com.seizia.chromite.model.websocket.event.resource.WSResourceUpdatedEvent"/>
        <event topicId="cb_scripts" id="cb_rm_resource_deleted"
               class="com.seizia.chromite.model.websocket.event.resource.WSResourceUpdatedEvent"/>

        <event topicId="cb_projects" id="cb_rm_project_added" class="com.seizia.chromite.model.websocket.event.WSProjectUpdateEvent"/>
        <event topicId="cb_projects" id="cb_rm_project_updated" class="com.seizia.chromite.model.websocket.event.WSProjectUpdateEvent"/>
        <event topicId="cb_projects" id="cb_rm_project_removed" class="com.seizia.chromite.model.websocket.event.WSProjectUpdateEvent"/>

        <event topicId="cb_user_secret" id="cb_user_secret_updated" class="com.seizia.chromite.model.websocket.event.WSUserSecretEvent"/>
        <event topicId="cb_workspace_configuration" id="cb_workspace_config_changed" class="com.seizia.chromite.model.websocket.event.WSWorkspaceConfigurationChangedEvent"/>
        <event topicId="cb_task" id="cb_task_finished" class="com.seizia.chromite.model.websocket.event.WSTaskFinishedEvent"/>
        <event topicId="cb_delete_temp_folder" id="cb_temp_folder_deleted" class="com.seizia.chromite.model.websocket.event.datasource.WSDataSourceEvent"/>
        <event topicId="cb_database_output_log" id="cb_database_output_log_updated" class="com.seizia.chromite.model.websocket.event.session.WSOutputDBLogEvent"/>
        <event topicId="cb_user" id="cb_user_deleted" class="com.seizia.chromite.model.websocket.event.WSUserDeletedEvent"/>
        <event topicId="cb_user" id="cb_user_disabled" class="com.seizia.chromite.model.websocket.event.WSUserDisabledEvent"/>

        <event topicId="cb_object_settings" id="cb_object_settings_updated" class="com.seizia.chromite.model.websocket.event.WSObjectSettingsEvent"/>
        <event topicId="cb_object_settings" id="cb_object_settings_deleted" class="com.seizia.chromite.model.websocket.event.WSObjectSettingsEvent"/>
    </extension>

</plugin>
