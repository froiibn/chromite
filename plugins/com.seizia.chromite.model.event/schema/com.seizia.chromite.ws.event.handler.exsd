<?xml version='1.0' encoding='UTF-8'?>
<schema targetNamespace="com.seizia.chromite.model.event" xmlns="http://www.w3.org/2001/XMLSchema">
<annotation>
      <appInfo>
         <meta.schema plugin="com.seizia.chromite.model.event" id="com.seizia.chromite.ws.event.handler" name="WebSocket events handler"/>
      </appInfo>
      <documentation>Web events handler</documentation>
   </annotation>

   <element name="extension">
      <annotation><appInfo><meta.element/></appInfo></annotation>
      <complexType>
         <sequence>
            <element ref="eventHandler" minOccurs="0" maxOccurs="unbounded"/>
         </sequence>
         <attribute name="point" type="string" use="required"/>
         <attribute name="id" type="string"/>
         <attribute name="name" type="string"/>
      </complexType>
   </element>

   <element name="eventHandler">
      <complexType>
         <sequence>
            <element ref="topic" minOccurs="0" maxOccurs="unbounded"/>
         </sequence>
         <attribute name="class" type="string" use="required">
            <annotation><appInfo><meta.attribute kind="java" basedOn=":com.seizia.chromite.model.websocket.WSEventHandler"/></appInfo></annotation>
         </attribute>
      </complexType>
   </element>

   <element name="topic">
      <complexType>
         <attribute name="id" type="string" use="required"/>
      </complexType>
   </element>
</schema>
