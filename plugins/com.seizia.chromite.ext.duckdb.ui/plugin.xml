<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>

<plugin>

    <extension point="com.seizia.chromite.dataSourceConfigurator">
        <configurator dataSource="duckdb" class="com.seizia.chromite.ext.duckdb.ui.DuckDBConnectionPage"/>
    </extension>

    <extension point="com.seizia.chromite.ui.propertyConfigurator">
        <propertyConfigurator class="com.seizia.chromite.ext.duckdb.model.MotherDuckAuthModelToken" uiClass="com.seizia.chromite.ext.duckdb.ui.MotherDuckAuthModelConfigurator"/>
    </extension>

    <extension point="com.seizia.chromite.fileTypeHandler">
        <handler id="duckdb" class="com.seizia.chromite.ext.duckdb.ui.DuckDBFileDatabaseHandler" remote="false" order="103">
            <extension id="duckdb" extensions="duckdb,ddb" icon="platform:/plugin/com.seizia.chromite.ext.generic/icons/duckdb_icon_big.png"/>
        </handler>
    </extension>
</plugin>
