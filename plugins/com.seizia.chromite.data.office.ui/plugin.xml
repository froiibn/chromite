<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>

<plugin>

    <extension point="org.eclipse.ui.commands">
        <category id="com.seizia.chromite.ext.data.office" name="%category.com.seizia.chromite.ext.data.office.name" description="%category.com.seizia.chromite.ext.data.office.description"/>
        <command id="com.seizia.chromite.ext.data.office.results.openSpreadsheet" name="%command.com.seizia.chromite.ext.data.office.results.openSpreadsheet.name" description="%command.com.seizia.chromite.ext.data.office.results.openSpreadsheet.description" categoryId="com.seizia.chromite.ext.data.office"/>
    </extension>

    <extension point="org.eclipse.ui.commandImages">
        <image commandId="com.seizia.chromite.ext.data.office.results.openSpreadsheet" icon="platform:/plugin/com.seizia.chromite.data.office/icons/excel.svg"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <handler commandId="com.seizia.chromite.ext.data.office.results.openSpreadsheet" class="com.seizia.chromite.data.office.handlers.OpenSpreadsheetHandler">
            <enabledWhen>
                <with variable="activePart">
                    <test property="com.seizia.chromite.core.resultset.hasData"/>
                </with>
            </enabledWhen>
        </handler>
    </extension>

</plugin>
