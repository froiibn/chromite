<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>

<plugin>
    <extension-point id="com.seizia.chromite.dataSourceConfigurator" name="Data source configurators" schema="schema/com.seizia.chromite.dataSourceConfigurator.exsd"/>
    <extension-point id="com.seizia.chromite.connectionPageConfigurator" name="Connection page configurators" schema="schema/com.seizia.chromite.connectionPageConfigurator.exsd"/>

    <extension point="com.seizia.chromite.ui.propertyConfigurator">
        <propertyConfigurator class="com.seizia.chromite.model.impl.auth.AuthModelDatabaseNative" uiClass="com.seizia.chromite.ui.dialogs.connection.DatabaseNativeAuthModelConfigurator"/>
        <propertyConfigurator class="com.seizia.chromite.model.impl.auth.AuthModelDatabaseShellCommand" uiClass="com.seizia.chromite.ui.dialogs.connection.ShellCommandAuthModelConfigurator"/>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command id="com.seizia.chromite.core.new.connection" name="%command.com.seizia.chromite.core.new.connection.name" description="%command.com.seizia.chromite.core.new.connection.description" categoryId="com.seizia.chromite.core.navigator"/>
        <command id="com.seizia.chromite.core.new.connection.from.url" name="%command.com.seizia.chromite.core.new.connection.from.url.name" description="%command.com.seizia.chromite.core.new.connection.from.url.description" categoryId="com.seizia.chromite.core.navigator"/>
        <command id="com.seizia.chromite.core.migrate.connection" name="%command.com.seizia.chromite.core.migrate.connection.name" description="%command.com.seizia.chromite.core.migrate.connection.description" categoryId="com.seizia.chromite.core.navigator"/>
        <command id="com.seizia.chromite.core.driver.manager" name="%command.com.seizia.chromite.core.driver.manager.name" description="%command.com.seizia.chromite.core.driver.manager.description" categoryId="com.seizia.chromite.core.navigator"/>
        <command id="com.seizia.chromite.connection.changeCurrentPassword" name="%command.com.seizia.chromite.connection.changeCurrentPassword.name" description="%command.com.seizia.chromite.connection.changeCurrentPassword.description" categoryId="com.seizia.chromite.core.navigator"/>
    </extension>

    <extension point="com.seizia.chromite.workbenchHandler">
        <workbenchWindowInitializer class="com.seizia.chromite.ui.UIEditorsWorkbenchInitializer" order="2"/>
    </extension>

    <extension point="org.eclipse.ui.commandImages">
        <image commandId="com.seizia.chromite.core.new.connection" icon="platform:/plugin/com.seizia.chromite.ui/icons/database_connect.svg"/>
        <image commandId="com.seizia.chromite.core.new.connection.from.url" icon="platform:/plugin/com.seizia.chromite.model/icons/connection/database_icon.svg"/>
        <image commandId="com.seizia.chromite.core.driver.manager" icon="platform:/plugin/com.seizia.chromite.ui/icons/driver_manager.svg"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <handler commandId="com.seizia.chromite.core.new.connection" class="com.seizia.chromite.ui.actions.datasource.DataSourceCreateHandler">
            <enabledWhen>
                <with variable="activePart">
                    <test property="com.seizia.chromite.core.global.ui.canCreateConnection"/>
                </with>
            </enabledWhen>
        </handler>
        <handler commandId="com.seizia.chromite.core.new.connection.from.url" class="com.seizia.chromite.ui.actions.datasource.DataSourceCreateFromUrlHandler">
            <enabledWhen>
                <with variable="activePart">
                    <test property="com.seizia.chromite.core.global.ui.canCreateConnection"/>
                </with>
            </enabledWhen>
        </handler>
        <handler commandId="com.seizia.chromite.core.migrate.connection" class="com.seizia.chromite.ui.actions.datasource.DataSourceMigrateHandler">
            <enabledWhen>
                <with variable="selection">
                    <count value="+"/>
                    <iterate operator="and">
                        <instanceof value="com.seizia.chromite.model.navigator.DBNDataSource"/>
                    </iterate>
                </with>
            </enabledWhen>
        </handler>
        <handler commandId="com.seizia.chromite.core.driver.manager" class="com.seizia.chromite.ui.actions.driver.DriverManagerDialogHandler">
            <enabledWhen>
                <test property="com.seizia.chromite.core.global.ui.hasPermission" value="driver-manager"/>
            </enabledWhen>
        </handler>
        <handler commandId="com.seizia.chromite.connection.changeCurrentPassword" class="com.seizia.chromite.ui.actions.ChangePasswordDialogHandler">
            <enabledWhen>
                <with variable="selection">
                    <count value="1"/>
                    <iterate operator="and">
                        <adapt type="com.seizia.chromite.model.navigator.DBNDataSource">
                            <test property="com.seizia.chromite.ui.connection.canChangePassword" forcePluginActivation="true"/>
                        </adapt>
                    </iterate>
                </with>
            </enabledWhen>
        </handler>
    </extension>

    <extension point="org.eclipse.ui.menus">

        <menuContribution allPopups="false" locationURI="menu:com.seizia.chromite.core.menu.newConnection">
            <separator name="additions" visible="false"/>
            <dynamic id="com.seizia.chromite.core.menu.newConnection.select" class="com.seizia.chromite.ui.actions.datasource.NewConnectionDriverSelectorContributor"/>
            <separator name="footer" visible="true"/>
            <command commandId="com.seizia.chromite.core.new.connection.from.url" label="%command.com.seizia.chromite.core.new.connection.from.url.name_short"/>
            <separator name="custom" visible="true"/>
            <command commandId="com.seizia.chromite.core.new.connection"/>
        </menuContribution>

        <menuContribution allPopups="false" locationURI="popup:org.eclipse.ui.popup.any?after=tools">
            <menu label="%command.com.seizia.chromite.connection.security.name">
                <command commandId="com.seizia.chromite.connection.changeCurrentPassword">
                    <visibleWhen checkEnabled="true"/>
                </command>
            </menu>
        </menuContribution>

    </extension>

    <extension point="org.eclipse.ui.bindings">
        <key commandId="com.seizia.chromite.core.new.connection" contextId="org.eclipse.ui.contexts.window" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration" sequence="CTRL+SHIFT+N"/>
    </extension>

    <extension point="org.eclipse.ui.propertyPages">
        <page id="com.seizia.chromite.preferences.main.errorHandle" class="com.seizia.chromite.ui.preferences.PrefPageErrorHandle" name="%page.com.seizia.chromite.preferences.main.errorHandle.name">
            <enabledWhen><reference definitionId="com.seizia.chromite.core.preferences.datasource"/></enabledWhen>
        </page>
        <page id="com.seizia.chromite.preferences.main.connections" class="com.seizia.chromite.ui.preferences.PrefPageConnectionClient" name="%page.com.seizia.chromite.preferences.main.connections.name">
            <enabledWhen>
                <or>
                    <instanceof value="com.seizia.chromite.model.navigator.DBNDataSource"/>
                    <adapt type="com.seizia.chromite.model.DBPDataSourceContainer"/>
                </or>
            </enabledWhen>
        </page>
        <page id="com.seizia.chromite.preferences.main.transactions" class="com.seizia.chromite.ui.preferences.PrefPageTransactions" name="%page.com.seizia.chromite.preferences.main.transactions.name">
            <enabledWhen>
                <or>
                    <instanceof value="com.seizia.chromite.model.navigator.DBNDataSource"/>
                    <adapt type="com.seizia.chromite.model.DBPDataSourceContainer"/>
                </or>
            </enabledWhen>
        </page>
        <page id="com.seizia.chromite.preferences.main.meta" class="com.seizia.chromite.ui.preferences.PrefPageMetaData" name="%page.com.seizia.chromite.preferences.main.meta.name">
            <enabledWhen><reference definitionId="com.seizia.chromite.core.preferences.datasource"/></enabledWhen>
        </page>
        <page class="com.seizia.chromite.ui.preferences.PrefPageConnectionTypes" id="com.seizia.chromite.preferences.connectionTypes" name="%page.com.seizia.chromite.preferences.connectionTypes.name">
            <enabledWhen>
                <or>
                    <instanceof value="com.seizia.chromite.model.connection.DBPConnectionType"/>
                    <instanceof value="com.seizia.chromite.ui.navigator.database.NavigatorViewBase"/>
                </or>
            </enabledWhen>
        </page>
    </extension>

    <extension point="org.eclipse.ui.newWizards">
        <wizard
             category="com.seizia.chromite.core.new.general"
             class="com.seizia.chromite.ui.dialogs.connection.NewConnectionWizard"
             icon="platform:/plugin/com.seizia.chromite.ui/icons/database.svg"
             id="com.seizia.chromite.core.wizard.new.connection"
             name="%wizard.com.seizia.chromite.core.wizard.new.connection.name">
           <description>
               %wizard.com.seizia.chromite.core.wizard.new.connection.description
           </description>
        </wizard>
    </extension>

    <extension point="org.eclipse.core.expressions.propertyTesters">
        <propertyTester
                class="com.seizia.chromite.ui.actions.ChangeUserPasswordPropertyTester"
                id="com.seizia.chromite.ui.actions.ChangeUserPasswordPropertyTester"
                namespace="com.seizia.chromite.ui.connection"
                properties="canChangePassword"
                type="com.seizia.chromite.model.navigator.DBNDataSource">
        </propertyTester>
    </extension>

    <extension point="com.seizia.chromite.productFeature">
        <feature id="database"/>
        <feature parent="database" id="administration"/>
        <feature parent="database/administration" id="advanced"/>
    </extension>

    <extension point="org.eclipse.ui.propertyPages">
        <page id="com.seizia.chromite.project.settings.networkProfiles" class="com.seizia.chromite.ui.preferences.PrefPageProjectNetworkProfiles" name="%page.com.seizia.chromite.project.settings.networkProfiles.name">
            <enabledWhen>
                <adapt type="org.eclipse.core.resources.IProject">
                    <test property="org.eclipse.core.resources.projectNature" value="com.seizia.chromite.ChromiteNature"/>
                </adapt>
            </enabledWhen>
        </page>
    </extension>

    <extension point="com.seizia.chromite.confirmations">
        <confirmation
                id="disconnect_txn"
                title="%confirm.disconnect_txn.title"
                description="%confirm.disconnect_txn.tip"
                message="%confirm.disconnect_txn.message"
                toggleMessage="default"
                group="Connections"/>
        <confirmation
                id="reconnect_txn"
                title="%confirm.reconnect_txn.title"
                description="%confirm.reconnect_txn.tip"
                message="%confirm.reconnect_txn.message"
                toggleMessage="default"
                group="Connections"/>
    </extension>

    <extension point="org.eclipse.ui.keywords">
        <keyword id="com.seizia.chromite.ui.editors.connection.keyword.pref.errors" label="%keyword.com.seizia.chromite.ui.editors.connection.keyword.pref.errors.label"/>
        <keyword id="com.seizia.chromite.ui.editors.connection.keyword.pref.client" label="%keyword.com.seizia.chromite.ui.editors.connection.keyword.pref.client.label"/>
        <keyword id="com.seizia.chromite.ui.editors.connection.keyword.pref.transactions" label="%keyword.com.seizia.chromite.ui.editors.connection.keyword.pref.transactions.label"/>
        <keyword id="com.seizia.chromite.ui.editors.connection.keyword.pref.maven" label="%keyword.com.seizia.chromite.ui.editors.connection.keyword.pref.maven.label"/>
        <keyword id="com.seizia.chromite.ui.editors.connection.keyword.pref.classpath" label="%keyword.com.seizia.chromite.ui.editors.connection.keyword.pref.classpath.label"/>
        <keyword id="com.seizia.chromite.ui.editors.connection.keyword.pref.connection.types" label="%keyword.com.seizia.chromite.ui.editors.connection.keyword.pref.connection.types.label"/>
    </extension>

</plugin>
