<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>

<plugin>

    <extension point="com.seizia.chromite.dataSourceConfigurator">
        <configurator dataSource="exasol" class="com.seizia.chromite.ext.exasol.ui.views.ExasolConnectionPage"/>
    </extension>
    
    <extension point="org.eclipse.ui.editors">
        <editor
                name="%editor.com.seizia.chromite.ext.exasol.model.app.ExasolServerSessionEditor.name"
                icon="platform:/plugin/com.seizia.chromite.ext.exasol/icons/compile.png"
                class="com.seizia.chromite.ext.exasol.ui.editors.ExasolServerSessionEditor"
                id="com.seizia.chromite.ext.exasol.ui.editors.ExasolServerSessionEditor"
                contributorClass="com.seizia.chromite.ui.editors.EditorSearchActionsContributor">
        </editor>
        <editor
            name="%editor.com.seizia.chromite.ext.exasol.ui.editors.ExasolLockEditor.name"
            class="com.seizia.chromite.ext.exasol.ui.editors.ExasolLockEditor"
            icon="platform:/plugin/com.seizia.chromite.model/icons/tree/locked.svg"
            id="com.seizia.chromite.ext.exasol.ui.editors.ExasolLockEditor">
        </editor>

    </extension>
    
    <extension point="com.seizia.chromite.dataSourceProvider">
        <editorContribution editorId="com.seizia.chromite.ext.exasol.ui.editors.ExasolServerSessionEditor" category="connectionEditor" label="%editor.session_manager.name" icon="platform:/plugin/com.seizia.chromite.model/icons/tree/sessions.svg">
            <supports dataSource="exasol"/>
        </editorContribution>
        <editorContribution editorId="com.seizia.chromite.ext.exasol.ui.editors.ExasolLockEditor" category="connectionEditor" label="%editor.lock_manager.name" icon="#locked">
            <supports dataSource="exasol"/>
        </editorContribution>
    </extension>
    
	<extension point="com.seizia.chromite.databaseEditor">    
	    <editor
	              class="com.seizia.chromite.ext.exasol.ui.editors.ExasolSourceViewEditor"
	              contributor="com.seizia.chromite.ui.editors.sql.SQLEditorContributorNested"
	              description="%editor.exasol.source.view.description"
	              icon="#sql_text"
	              id="exasol.source.view"
	              label="%editor.exasol.source.view.label"
	              position="additions_middle"
	              type="folder">
	           <objectType name="com.seizia.chromite.ext.exasol.model.ExasolView"/>
	           <objectType name="com.seizia.chromite.ext.exasol.model.ExasolScript"/>
	           <objectType name="com.seizia.chromite.ext.exasol.model.ExasolFunction"/>
	    </editor>
        <editor
                class="com.seizia.chromite.ui.editors.sql.SQLSourceViewer"
                contributor="com.seizia.chromite.ui.editors.sql.SQLEditorContributorNested"
                description="%editor.source.ddl.description"
                icon="#sql_text"
                id="source.ddl"
                label="%editor.source.ddl.name"
                position="additions_middle"
                type="folder">
            <objectType name="com.seizia.chromite.ext.exasol.model.ExasolTable"/>
        </editor>
        <editor
                class="com.seizia.chromite.ui.editors.sql.SQLSourceViewer"
                contributor="com.seizia.chromite.ui.editors.sql.SQLEditorContributorNested"
                description="%editor.source.declaration.description"
                embeddable="true"
                icon="#sql_text"
                id="source.declaration"
                label="%meta.com.seizia.chromite.ext.exasol.model.ExasolVirtualSchema.adapterNotes.name"
                position="additions_middle"
                type="folder">
            <objectType name="com.seizia.chromite.ext.exasol.model.ExasolVirtualSchema"/>
        </editor>
        
        <configurator class="com.seizia.chromite.ext.exasol.ui.config.ExasolConsumerGroupConfigurator">
            <objectType name="com.seizia.chromite.ext.exasol.model.ExasolConsumerGroup"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.exasol.ui.config.ExasolForeignKeyConfigurator">
            <objectType name="com.seizia.chromite.ext.exasol.model.ExasolTableForeignKey"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.exasol.ui.config.ExasolSchemaConfigurator">
            <objectType name="com.seizia.chromite.ext.exasol.model.ExasolSchema"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.exasol.ui.config.ExasolConnectionConfigurator">
            <objectType name="com.seizia.chromite.ext.exasol.model.ExasolConnection"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.exasol.ui.config.ExasolUserConfigurator">
            <objectType name="com.seizia.chromite.ext.exasol.model.security.ExasolUser"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.exasol.ui.config.ExasolPriorityGroupConfigurator">
            <objectType name="com.seizia.chromite.ext.exasol.model.ExasolPriorityGroup"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.exasol.ui.config.ExasolPrimaryKeyConfigurator">
            <objectType name="com.seizia.chromite.ext.exasol.model.ExasolTableUniqueKey"/>
        </configurator>
        <configurator class="com.seizia.chromite.ext.exasol.ui.config.ExasolRoleConfigurator">
            <objectType name="com.seizia.chromite.ext.exasol.model.security.ExasolRole"/>
        </configurator>   
        <configurator class="com.seizia.chromite.ext.exasol.ui.config.ExasolIndexConfigurator">
            <objectType name="com.seizia.chromite.ext.exasol.model.ExasolTableIndex"/>
        </configurator>              
    </extension>
    
    <extension point="com.seizia.chromite.tools">
      <tools>
         <tool
               description="%tool.com.seizia.chromite.ext.exasol.table.export.description"
               id="com.seizia.chromite.ext.exasol.ui.tools.ExasolExportTableTool"
               label="%tool.com.seizia.chromite.ext.exasol.table.export.name">
             <command id="com.seizia.chromite.ext.exasol.ui.exportTable">
                 <objectType name="com.seizia.chromite.ext.exasol.model.ExasolTable"/>
                 <objectType name="com.seizia.chromite.ext.exasol.model.ExasolView"/>
                 <objectType name="com.seizia.chromite.ext.exasol.model.ExasolSchema"/>
             </command>
         </tool>
         <tool
               description="%tool.com.seizia.chromite.ext.exasol.table.import.description"
               id="com.seizia.chromite.ext.exasol.ui.tools.ExasolImportTableTool"
               label="%tool.com.seizia.chromite.ext.exasol.table.import.name">
             <command id="com.seizia.chromite.ext.exasol.ui.importTable">
                 <objectType name="com.seizia.chromite.ext.exasol.model.ExasolSchema"/>
                 <objectType name="com.seizia.chromite.ext.exasol.model.ExasolTable"/>
             </command>
         </tool>

          <tool
               description="Truncate table(s)"
               id="com.seizia.chromite.ext.exasol.ui.tools.ExasolToolTruncate"
               group="com.seizia.chromite.ext.exasol.ui.tools"
               label="Truncate"
               singleton="false">
              <task id="exasolToolTruncateTable"/>
          </tool>
      </tools>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command id="com.seizia.chromite.ext.exasol.ui.exportTable" name="%tool.com.seizia.chromite.ext.exasol.table.export.name"/>
        <command id="com.seizia.chromite.ext.exasol.ui.importTable" name="%tool.com.seizia.chromite.ext.exasol.table.import.name"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <handler commandId="com.seizia.chromite.ext.exasol.ui.exportTable" class="com.seizia.chromite.ext.exasol.ui.tools.ExasolExportTableToolCommandHandler"/>
        <handler commandId="com.seizia.chromite.ext.exasol.ui.importTable" class="com.seizia.chromite.ext.exasol.ui.tools.ExasolImportTableToolCommandHandler"/>
    </extension>

</plugin>
