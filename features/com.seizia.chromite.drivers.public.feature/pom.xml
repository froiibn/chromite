<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.seizia.chromite</groupId>
        <artifactId>chromite</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../</relativePath>
    </parent>
    <groupId>com.seizia.chromite</groupId>
    <artifactId>com.seizia.chromite.drivers.public.feature</artifactId>
    <version>26.2.5-SNAPSHOT</version>
    <packaging>eclipse-feature</packaging>

    <properties>
        <!-- Root files folder for the bundled JDBC drivers (installed as <install>/drivers) -->
        <drivers.dir>${project.build.directory}/generated/drivers</drivers.dir>
    </properties>

    <build>
        <plugins>
            <!--
                Chromite: bundled JDBC drivers of the major databases (docs/chromite/drivers.md).
                Copies exact, unmodified jars from Maven Central into target/generated/drivers/<name>/,
                which build.properties installs as <install>/drivers/<name>/ (license texts come from drivers-root/).
                Folder names must match the bundle="drivers.*" file paths in the driver plugin.xml files;
                the bundle IDs are declared by com.seizia.chromite.drivers.public, which this feature includes.
                This is the only place the bundled jars and versions are listed: the product includes this feature.
                Versions must match the Maven fallback versions in plugin.xml so both modes load the same driver.
                drivers/sqlite/xerial: the Maven fallback is an unpinned RELEASE, so the jar is pinned here
                (the release that RELEASE resolved to when it was bundled).
                Not bundled on purpose: mssql-jdbc_auth DLL (Microsoft license terms),
                waffle-jna (PostgreSQL SSPI only; plugin.xml has no bundled alternative),
                xmlparserv2 18.3.0.0 (pulled in by xdb6, duplicate of 23.2.0.0), checker-qual (annotations only),
                MySQL Connector/J (GPLv2; downloaded when first used since 2026-11-07, docs/chromite/drivers.md).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>bundle-public-drivers</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <overWriteReleases>false</overWriteReleases>
                            <artifactItems>
                                <!-- drivers.mssql.new: SQL Server, Azure SQL Server, Babelfish -->
                                <artifactItem><groupId>com.microsoft.sqlserver</groupId><artifactId>mssql-jdbc</artifactId><version>13.4.0.jre11</version><outputDirectory>${drivers.dir}/mssql/new</outputDirectory></artifactItem>
                                <!-- msal4j and its runtime dependencies (mvn dependency:tree of msal4j 1.16.0): Entra ID authentication -->
                                <artifactItem><groupId>com.microsoft.azure</groupId><artifactId>msal4j</artifactId><version>1.16.0</version><outputDirectory>${drivers.dir}/mssql/new</outputDirectory></artifactItem>
                                <artifactItem><groupId>com.nimbusds</groupId><artifactId>oauth2-oidc-sdk</artifactId><version>11.9.1</version><outputDirectory>${drivers.dir}/mssql/new</outputDirectory></artifactItem>
                                <artifactItem><groupId>com.github.stephenc.jcip</groupId><artifactId>jcip-annotations</artifactId><version>1.0-1</version><outputDirectory>${drivers.dir}/mssql/new</outputDirectory></artifactItem>
                                <artifactItem><groupId>com.nimbusds</groupId><artifactId>content-type</artifactId><version>2.3</version><outputDirectory>${drivers.dir}/mssql/new</outputDirectory></artifactItem>
                                <artifactItem><groupId>com.nimbusds</groupId><artifactId>lang-tag</artifactId><version>1.7</version><outputDirectory>${drivers.dir}/mssql/new</outputDirectory></artifactItem>
                                <artifactItem><groupId>com.nimbusds</groupId><artifactId>nimbus-jose-jwt</artifactId><version>9.37.3</version><outputDirectory>${drivers.dir}/mssql/new</outputDirectory></artifactItem>
                                <artifactItem><groupId>net.minidev</groupId><artifactId>json-smart</artifactId><version>2.5.0</version><outputDirectory>${drivers.dir}/mssql/new</outputDirectory></artifactItem>
                                <artifactItem><groupId>net.minidev</groupId><artifactId>accessors-smart</artifactId><version>2.5.0</version><outputDirectory>${drivers.dir}/mssql/new</outputDirectory></artifactItem>
                                <artifactItem><groupId>org.ow2.asm</groupId><artifactId>asm</artifactId><version>9.3</version><outputDirectory>${drivers.dir}/mssql/new</outputDirectory></artifactItem>
                                <artifactItem><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>1.7.36</version><outputDirectory>${drivers.dir}/mssql/new</outputDirectory></artifactItem>
                                <artifactItem><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>2.13.4.2</version><outputDirectory>${drivers.dir}/mssql/new</outputDirectory></artifactItem>
                                <artifactItem><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-annotations</artifactId><version>2.13.4</version><outputDirectory>${drivers.dir}/mssql/new</outputDirectory></artifactItem>
                                <artifactItem><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-core</artifactId><version>2.13.4</version><outputDirectory>${drivers.dir}/mssql/new</outputDirectory></artifactItem>
                                <!-- drivers.oracle -->
                                <artifactItem><groupId>com.oracle.database.jdbc</groupId><artifactId>ojdbc11</artifactId><version>23.2.0.0</version><outputDirectory>${drivers.dir}/oracle</outputDirectory></artifactItem>
                                <artifactItem><groupId>com.oracle.database.nls</groupId><artifactId>orai18n</artifactId><version>23.2.0.0</version><outputDirectory>${drivers.dir}/oracle</outputDirectory></artifactItem>
                                <artifactItem><groupId>com.oracle.database.xml</groupId><artifactId>xdb6</artifactId><version>18.3.0.0</version><outputDirectory>${drivers.dir}/oracle</outputDirectory></artifactItem>
                                <artifactItem><groupId>com.oracle.database.xml</groupId><artifactId>xmlparserv2</artifactId><version>23.2.0.0</version><outputDirectory>${drivers.dir}/oracle</outputDirectory></artifactItem>
                                <!-- drivers.postgresql: all PostgreSQL-family drivers -->
                                <artifactItem><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><version>42.7.14</version><outputDirectory>${drivers.dir}/postgresql</outputDirectory></artifactItem>
                                <artifactItem><groupId>net.postgis</groupId><artifactId>postgis-jdbc</artifactId><version>2.5.0</version><outputDirectory>${drivers.dir}/postgis</outputDirectory></artifactItem>
                                <artifactItem><groupId>net.postgis</groupId><artifactId>postgis-geometry</artifactId><version>2.5.0</version><outputDirectory>${drivers.dir}/postgis</outputDirectory></artifactItem>
                                <artifactItem><groupId>net.postgis</groupId><artifactId>postgis-jdbc-jtsparser</artifactId><version>2.5.0</version><outputDirectory>${drivers.dir}/postgis</outputDirectory></artifactItem>
                                <!-- drivers.mariadb: MariaDB (also used for MySQL in the public edition) -->
                                <artifactItem><groupId>org.mariadb.jdbc</groupId><artifactId>mariadb-java-client</artifactId><version>3.5.10</version><outputDirectory>${drivers.dir}/mariadb</outputDirectory></artifactItem>
                                <!-- drivers.sqlite.xerial: SQLite (one jar with the native SQLite libraries of all platforms; no runtime dependencies, slf4j-api is optional) -->
                                <artifactItem><groupId>org.xerial</groupId><artifactId>sqlite-jdbc</artifactId><version>3.54.1.0</version><outputDirectory>${drivers.dir}/sqlite/xerial</outputDirectory></artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
