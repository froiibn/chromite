    <description>Chromite Database Workbench base standalone application</description>

    <copyright>DBeaver Corp and others</copyright>

    <includes id="com.seizia.chromite.rcp.feature" version="0.0.0"/>

    <includes id="com.seizia.chromite.runtime.feature" version="0.0.0"/>
    <includes id="com.seizia.chromite.ui.feature" version="0.0.0"/>
    <includes id="com.seizia.chromite.db.feature" version="0.0.0"/>
    <includes id="com.seizia.chromite.db.ui.feature" version="0.0.0"/>

    <!-- SWT additions -->
    <plugin id="com.seizia.chromite.ui.swt.macos" os="macosx" version="0.0.0" />
    <plugin id="com.seizia.chromite.ui.swt.windows" os="win32" version="0.0.0" />

    <!-- Logging -->

