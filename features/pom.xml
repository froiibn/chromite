<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.seizia.chromite</groupId>
        <artifactId>chromite</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../</relativePath>
    </parent>
    <artifactId>features</artifactId>
    <packaging>pom</packaging>

    <modules>
        <module>com.seizia.chromite.runtime.feature</module>
        <module>com.seizia.chromite.db.feature</module>
    </modules>

    <profiles>
        <profile>
            <id>desktop</id>
            <activation><property><name>!headless-platform</name></property></activation>
            <!-- Desktop (swt/jface) components -->
            <modules>
                <module>com.seizia.chromite.rcp.feature</module>
                <module>com.seizia.chromite.ui.feature</module>
                <module>com.seizia.chromite.ui.extra.feature</module>
                <module>com.seizia.chromite.debug.feature</module>

                <module>com.seizia.chromite.db.ui.feature</module>
                <module>com.seizia.chromite.git.feature</module>
                <module>com.seizia.chromite.ext.office.feature</module>

                <module>com.seizia.chromite.app.base.feature</module>
                <module>com.seizia.chromite.app.local.feature</module>
                <module>com.seizia.chromite.standalone.feature</module>
                <module>com.seizia.chromite.test.feature</module>
                <module>com.seizia.chromite.test.base.feature</module>
                <module>com.seizia.chromite.ce.feature</module>

                <!-- Chromite public edition bundled JDBC drivers, included by the SWT and Swing products (docs/chromite/drivers.md) -->
                <module>com.seizia.chromite.drivers.public.feature</module>

                <!-- Chromite Swing frontend (no SWT), docs/chromite/swing-frontend.md -->
                <module>com.seizia.chromite.swing.feature</module>
            </modules>
        </profile>
    </profiles>

</project>
